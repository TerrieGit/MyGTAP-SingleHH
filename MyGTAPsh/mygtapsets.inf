      1   ![[!
      2       ==========================================
      3       ImpactECON MyGTAP Model auxillary programs
      4       May 2016
      5    
      6       This version incorporates additional sets for MyGTAP model
      7    
      8       ImpactECON LLC, Boulder, Colorado
      9       https://impactecon.com/
     10    
     11       ==========================================
     12    
     13   Purpose of program:
     14   1. Sets for MyGTAP
     15    
     16   Author: Peter Minor and Terrie L walmsley
     17   Date: June 2 2015
     18    
     19   !]]!
     20    
     21   File
     22          GTAPSETS # Original GTAP sets file #;      !input\sets.har!
     23          BASEDATA # Base Data #;                    !input\basedata.har!
     24          INPAR    # Parameters file #;          !input\default.prm  !
     25          EXTDAT # File with other extra datasets #;
     26    (new) NEWSETS # updated sets writtent to ouput directory #; !output\sets.har!
     27    (new) OUTPAR   # New parameters file #;          !output\default.prm !
     28    
     29    
     30   ![[!
     31        ----
     32        Sets
     33        ----
     34   !]]!
     35    
     36   Set ! standard GTAP sets !
     37    REG        # Regions #         read elements from file GTAPSETS header  "H1";
     38    TRAD_COMM # Traded comms #    read elements from file GTAPSETS header  "H2";
     39    MARG_COMM  # Margin comms #    read elements from file GTAPSETS header  "MARG";
     40    CGDS_COMM  # Investment good # read elements from file GTAPSETS header  "H9";
     41    ENDW_COMM0  # Primary factors # read elements from file GTAPSETS header "H6";
     42    
     43   Subset MARG_COMM is subset of TRAD_COMM ;
     44    
     45   Set  ! consequential GTAP sets !
     46    PROD_COMM # Produced commodities  # = TRAD_COMM + CGDS_COMM;
     47    
     48   Set !Special Sets for deviding up the GTAP data - Households!
     49    HHLD # Main household # (MainHH);
     50    ALLHH #All Households New splits and old # = HHLD;
     51    
     52   Set !Special Sets for deviding up the GTAP data - factors!
     53   ! This is not done in this version, but sets kept for model to run !
     54    BASICFAC # Basic factors for splitting #
     55   read elements from file GTAPSETS header "H6";
     56    FAC0   #Original factors in GTAP database# = ENDW_COMM0 union BASICFAC;
     57    ENDS   # New Factors for split region #
     58           read elements from file GTAPSETS header "H6";
     59    ALLFAC #Final factors# = ENDW_COMM0 union ENDS;
     60    
     61   !Mapping new factors for REGS to original factors!
     62   Mapping MAPENDS_BFAC from ENDS to BASICFAC ;
     63   Read (by_elements) MAPENDS_BFAC from file GTAPSETS header "H6";
     64    
     65   Mapping MAPENDW_BFAC from ENDW_COMM0 to BASICFAC ;
     66   Read (by_elements) MAPENDW_BFAC from file GTAPSETS header
     67   "H6";
     68    
     69   Mapping MAPAFAC from ALLFAC to FAC0 ;
     70   Formula (all, f, ENDS) MAPAFAC(f) = $pos(MAPENDS_BFAC(f),FAC0);
     71   Formula (all, f, ENDW_COMM0) MAPAFAC(f) = $pos(f);
     72    
     73   Set
     74   ENDW_GTAP # Original GTAP endowments # (Land, tech_aspros, clerks, service_shop,
     75    off_mgr_pros, ag_othlowsk, Capital, NatlRes);
     76    
     77   Mapping MAPGTAP_ENDW from ENDW_GTAP to ENDW_COMM0 ;
     78   Read (by_elements) MAPGTAP_ENDW from file GTAPSETS header "MEND";
     79    
     80   Set
     81       ENDWC_GTAP # Original GTAP capital endowment commodity # (Capital);
     82   Subset ENDWC_GTAP is subset of ENDW_GTAP;
     83    
     84   Set
     85       ENDWL_GTAP # Original GTAP Labor endowment commodity #
     86       (tech_aspros, clerks, service_shop, off_mgr_pros, ag_othlowsk);
     87   Subset ENDWL_GTAP is subset of ENDW_GTAP;
     88    
     89   Coefficient (all,i, ENDW_COMM0)
     90       CINDICG(i) # Indicator for Capital endowments #;
     91   Formula (all,i, ENDW_COMM0)
     92       CINDICG(i) = sum(j, ENDWC_GTAP: MAPGTAP_ENDW(j)=i,1) ;
     93   Coefficient (all,i,BASICFAC)
     94       CINDICB(i) # Indicator for Capital endowments #;
     95   Formula (all,i,BASICFAC)
     96       CINDICB(i) = sum(j, ENDW_COMM0: MAPENDW_BFAC(j)=i, CINDICG(j)) ;
     97   Coefficient (all,i, FAC0)
     98       CINDICF(i) # Indicator for Capital endowments #;
     99   Formula (all,i, ENDW_COMM0)
    100       CINDICF(i) = CINDICG(i);
    101   Formula (all,i, BASICFAC)
    102       CINDICF(i) = CINDICB(i);
    103   Coefficient (all,i, ALLFAC)
    104       CINDIC(i) # Indicator for Capital endowments #;
    105   Formula (all,i, ALLFAC)
    106       CINDIC(i) = sum(j, FAC0: MAPAFAC(i)=j, CINDICF(j)) ;
    107    
    108   Coefficient (all,i, ENDW_COMM0)
    109       LINDICG(i) # Indicator for Capital endowments #;
    110   Formula (all,i, ENDW_COMM0)
    111       LINDICG(i) = sum(j, ENDWL_GTAP: MAPGTAP_ENDW(j)=i,1) ;
    112   Coefficient (all,i,BASICFAC)
    113       LINDICB(i) # Indicator for Capital endowments #;
    114   Formula (all,i,BASICFAC)
    115       LINDICB(i) = sum(j, ENDW_COMM0: MAPENDW_BFAC(j)=i, LINDICG(j)) ;
    116   Coefficient (all,i, FAC0)
    117       LINDICF(i) # Indicator for Capital endowments #;
    118   Formula (all,i, ENDW_COMM0)
    119       LINDICF(i) = LINDICG(i);
    120   Formula (all,i, BASICFAC)
    121       LINDICF(i) = LINDICB(i);
    122   Coefficient (all,i, ALLFAC)
    123       LINDIC(i) # Indicator for Capital endowments #;
    124   Formula (all,i, ALLFAC)
    125       LINDIC(i) = sum(j, FAC0: MAPAFAC(i)=j, LINDICF(j)) ;
    126    
    127   Set
    128       ENDWC_COMM # capital endowment commodities # =
    129                        (all,i,ALLFAC: CINDIC(i)>0);
    130   Set
    131       ENDWL_COMM # capital endowment commodities # =
    132                        (all,i,ALLFAC: LINDIC(i)>0);
    133    
    134   !Write some sets to final sets file !
    135   write
    136   (Set) REG      to file NEWSETS header "H1";
    137   (Set) TRAD_COMM      to file NEWSETS header "H2";
    138   (Set) MARG_COMM      to file NEWSETS header   "MARG";
    139   (Set) CGDS_COMM to file NEWSETS header "H9";
    140   (set) ALLFAC to file NEWSETS header  "H6";
    141   (Set) ALLHH  to file NEWSETS header "HOU";
    142   (Set) ENDWC_COMM to file NEWSETS header"ENDC";
    143   (Set) ENDWL_COMM to file NEWSETS header"ENDL";
    144   (set) BASICFAC to file NEWSETS header "BFAC";
    145   (Set) FAC0     to file NEWSETS header "FAC0";
    146   (Set) ENDW_COMM0 to file NEWSETS header"ENDW";
    147   (by_elements) MAPENDS_BFAC to file NEWSETS header "MS2B";
    148   (by_elements) MAPENDW_BFAC to file NEWSETS header "ME2B";
    149   (by_elements) MAPAFAC   to file NEWSETS header "MFAC";
    150    
    151   Transfer unread from file GTAPSETS to file NEWSETS; !copy unchanged sets !
    152   Transfer (ifheaderexists) "MREL" from file EXTDAT to file NEWSETS ;
    153    
    154   ![[!
    155       -------------------------
    156       Write new parameters file
    157       -------------------------
    158   !]]!
    159    
    160   Coefficient ! original parameters !
    161   (integer)(all,p,ENDW_COMM0)
    162           SLUG0(p)# CES between composite intermediate inputs #;
    163   (all,p,ENDW_COMM0)
    164           ETRAE0(p)  # CES between composite intermediate inputs #;
    165    
    166   Read
    167    ETRAE0  from file INPAR header "ETRE";
    168    SLUG0  from file INPAR header "SLUG";
    169    
    170   Coefficient ! expanded parameters !
    171   (all,f,BASICFAC) ETRAEB(f) # CES between composite intermediate inputs #;
    172   (all,f,ALLFAC) ETRAE(f) # CES between composite intermediate inputs #;
    173   (integer)(all,f,BASICFAC) SLUGB(f) # CES between composite intermediate inputs#;
    174   (integer)(all,f,ALLFAC) SLUG(f) # CES between composite intermediate inputs #;
    175    
    176   Formula
    177   (all,p,BASICFAC) ETRAEB(p)  = sum{f, ENDW_COMM0: MAPENDW_BFAC(f)=p, ETRAE0(f)}/
    178   sum{f, ENDW_COMM0: MAPENDW_BFAC(f)=p, 1} ;
    179   (all,p,ENDW_COMM0) ETRAE(p)  = ETRAE0(p) ;
    180   (all,p,ENDS) ETRAE(p)  = ETRAEB(MAPENDS_BFAC(p));
    181    
    182   (all,p,BASICFAC) SLUGB(p) = maxs{f,ENDW_COMM0: MAPENDW_BFAC(f)=p, SLUG0(f)} ;
    183   (all,p,ENDW_COMM0) SLUG(p) = SLUG0(p) ;
    184   (all,p,ENDS) SLUG(p)  = SLUGB(MAPENDS_BFAC(p));
    185    
    186   Write
    187    SLUG  to file OUTPAR header "SLUG"
    188          longname "Binary parameter for factor mobility: 1=sluggish 0=mobile";
    189    ETRAE  to file OUTPAR header "ETRE"
    190          longname "CET between sectors for sluggish primary factors";
    191    
    192   Transfer unwritten from file INPAR to file OUTPAR; !copy unchanged params !
    193   Transfer (ifheaderexists) "MREL" from file EXTDAT to file OUTPAR ;
    194    
    195   ![[!
    196       -----------
    197       End of File
    198       -----------
    199   !]]!




