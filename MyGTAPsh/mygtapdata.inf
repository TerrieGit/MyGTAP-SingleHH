      1   ![[!
      2       ==========================================
      3       ImpactECON MyGTAP Model auxillary programs
      4       May 2016
      5    
      6       This version incorporates additional data for MyGTAP model
      7    
      8       ImpactECON LLC, Boulder, Colorado
      9       https://impactecon.com/
     10    
     11       ==========================================
     12    
     13   Purpose of program:
     14   1. Includes remittances, foreign aid and government transfers into GTAP.
     15   2. Remove regional household
     16    
     17   Author: Terrie L walmsley
     18   Date: June 2 2015
     19    
     20   !]]!
     21    
     22   ![[!
     23       -----
     24       FILES
     25       -----
     26   !]]!
     27    
     28   File    GTAPDATA # GTAP Data Base #;
     29           GTAPSETS # New GTAP sets #;
     30           EXTDATA # File with other extra datasets #;
     31    (new)  NEWDATA # File with new base data #;
     32    
     33   ![[!
     34       ----------------
     35       SETS - GTAP sets
     36       ----------------
     37   !]]!
     38    
     39   Set
     40    REG read elements from file GTAPSETS header "H1";
     41    TRAD_COMM read elements from file GTAPSETS header "H2";
     42    MARG_COMM read elements from file GTAPSETS header   "MARG";
     43    CGDS_COMM read elements from file GTAPSETS header "H9";
     44    ENDW_COMM read elements from file GTAPSETS header  "H6";
     45    
     46   subset MARG_COMM is subset of TRAD_COMM ;
     47    
     48   set
     49    PROD_COMM # Produced commodities  # =TRAD_COMM + CGDS_COMM;
     50    DEMD_COMM # Demanded commodities # = ENDW_COMM + TRAD_COMM;
     51    NSAV_COMM # Non-savings commodities # = DEMD_COMM + CGDS_COMM;
     52    NMRG_COMM # Non-margin commodities # = TRAD_COMM - MARG_COMM ;
     53    
     54   subset PROD_COMM is subset of NSAV_COMM ;
     55    
     56   Set
     57       HHLD # Main household #  (MainHH);
     58    
     59   ![[!
     60       ----------------------------
     61       READ Statements of Base Data
     62       ----------------------------
     63   !]]!
     64    
     65   Coefficient
     66       (all,r,REG)
     67           VKB0(r) # Value of output at agent's prices #;
     68       (all,i,ENDW_COMM)(all,r,REG)
     69           EVOA0(i,r) # Value of output at agent's prices #;
     70       (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
     71           EVFA(i,j,r) # Producer expenditure on i by industry j #;
     72       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
     73           VIFA(i,j,r) # Purchases of imported i for use in j in region r #;
     74       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
     75           VDFA(i,j,r) # Purchases of domestic i for use in j in region r #;
     76       (all,i,TRAD_COMM)(all,r,REG)
     77           VIPA0(i,r) # Private household h expenditure on imported i in r #;
     78       (all,i,TRAD_COMM)(all,r,REG)
     79           VDPA0(i,r) # Private household expenditure on domestic i in r #;
     80       (all,i,TRAD_COMM)(all,r,REG)
     81           VIGA(i,r) # Government household expenditure on imported i #;
     82       (all,i,TRAD_COMM)(all,r,REG)
     83           VDGA(i,r) # Government household expenditure on domestic i in r #;
     84       (all,r,REG)
     85           VDEP0(r) # Value of capital depreciation in r (exogenous) #;
     86       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
     87           VXMD(i,r,s)
     88       # Exports of i from r to s at market prices (tradeables only) #;
     89       (ge 0)(all,m,MARG_COMM)(all,r,REG)
     90           VST(m,r)
     91       # Exports of m from r for int'l transport at mkt prices (tradeables only) #;
     92       (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
     93           VFM(i,j,r) # Producer expenditure on i by j in r at market prices #;
     94       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
     95           VIFM(i,j,r) # Purchases of imports i for use in j in region r #;
     96       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
     97           VDFM(i,j,r) # Purchases of domestic i r for use in j in region r #;
     98       (all,i,TRAD_COMM) (all,r,REG)
     99           VIPM0(i,r) # Private household expenditure on i in r #;
    100       (all,i,TRAD_COMM)(all,r,REG)
    101           VDPM0(i,r) # Private household expenditure on domestic i in r #;
    102       (all,i,TRAD_COMM)(all,r,REG)
    103           VIGM(i,r) # Gov't household expenditure on i in r #;
    104       (all,i,TRAD_COMM)(all,r,REG)
    105           VDGM(i,r) # Government household expenditure on domestic i in r #;
    106       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    107           VIMS(i,r,s) # Imports of i from r to s valued at domestic mkt prices #;
    108       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    109           VXWD(i,r,s) # Exports of i from r to s valued fob (tradeables only) #;
    110       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    111           VIWS(i,r,s) # Imports of i from r to s valued cif (tradeables only) #;
    112    
    113   Read
    114       VKB0 from file GTAPDATA header "VKB";
    115       EVOA0 from file GTAPDATA header "EVOA";
    116       EVFA from file GTAPDATA header "EVFA";
    117       VIFA from file GTAPDATA header "VIFA";
    118       VDFA from file GTAPDATA header "VDFA";
    119       VIPA0 from file GTAPDATA header "VIPA";
    120       VDPA0 from file GTAPDATA header "VDPA";
    121       VIGA from file GTAPDATA header "VIGA";
    122       VDGA from file GTAPDATA header "VDGA";
    123       VDEP0 from file GTAPDATA header "VDEP";
    124       VXMD from file GTAPDATA header "VXMD";
    125       VST from file GTAPDATA header "VST";
    126       VFM from file GTAPDATA header "VFM";
    127       VIFM from file GTAPDATA header "VIFM";
    128       VDFM from file GTAPDATA header "VDFM";
    129       VIPM0 from file GTAPDATA header "VIPM";
    130       VDPM0 from file GTAPDATA header "VDPM";
    131       VIGM from file GTAPDATA header "VIGM";
    132       VDGM from file GTAPDATA header "VDGM";
    133       VIMS from file GTAPDATA header "VIMS";
    134       VXWD from file GTAPDATA header "VXWD";
    135       VIWS from file GTAPDATA header "VIWS";
    136    
    137   ![[!
    138       ----------------------------
    139       DERIVATIVES OF THE BASE DATA
    140       ----------------------------
    141   !]]!
    142    
    143   Coefficient
    144       (all,i,DEMD_COMM)(all,j,PROD_COMM)(all,r,REG)
    145           VFA(i,j,r) # Firm's expenditure on i by industry j #;
    146       (all,i,NSAV_COMM)(all,r,REG)
    147           VOA(i,r) # Value of commodity i output in region r #;
    148       (all,i,TRAD_COMM)(all,r,REG)
    149           VGA(i,r) # Gov. household expenditure on i in r at agent's prices #;
    150       (all,r,REG)
    151           GOVEXP(r) # Government expenditure in region r #;
    152       (all,i,TRAD_COMM)(all,r,REG)
    153           VDM(i,r) # Domestic sales of i in r at market prices (tradeables) #;
    154       (all,i,NSAV_COMM)(all,r,REG)
    155           VOM(i,r) # Value of commodity i output in region r at market prices #;
    156       (all,r,REG)
    157           NETAXES(r) # Net tax revenues in r #;
    158    
    159   Formula
    160       (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    161           VFA(i,j,r) = EVFA(i,j,r);
    162       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    163           VFA(i,j,s) = VDFA(i,j,s) + VIFA(i,j,s);
    164       (all,i,ENDW_COMM)(all,r,REG)
    165           VOA(i,r) = EVOA0(i,r);
    166       (all,i,PROD_COMM)(all,r,REG)
    167           VOA(i,r) = sum{j,DEMD_COMM, VFA(j,i,r)};
    168       (all,i,TRAD_COMM)(all,s,REG)
    169           VGA(i,s) = VDGA(i,s) + VIGA(i,s);
    170       (all,r,REG)
    171           GOVEXP(r) = sum{i,TRAD_COMM, VGA(i,r)};
    172       (all,i,TRAD_COMM)(all,r,REG)
    173       VDM(i,r) = VDPM0(i,r) + VDGM(i,r) + sum{j,PROD_COMM, VDFM(i,j,r)};
    174       (all,i,ENDW_COMM)(all,r,REG)
    175           VOM(i,r) = sum{j,PROD_COMM, VFM(i,j,r)};
    176       (all,m,MARG_COMM)(all,r,REG)
    177           VOM(m,r) = VDM(m,r) + sum{s,REG, VXMD(m,r,s)} + VST(m,r);
    178       (all,i,NMRG_COMM)(all,r,REG)
    179           VOM(i,r) = VDM(i,r) + sum{s,REG, VXMD(i,r,s)};
    180       (all,h,CGDS_COMM)(all,r,REG)
    181           VOM(h,r) = VOA(h,r);
    182       (all,r,REG)
    183       NETAXES(r)
    184           = sum{i,NSAV_COMM, VOM(i,r) - VOA(i,r)}
    185           + sum{j,PROD_COMM, sum{i,ENDW_COMM, VFA(i,j,r) - VFM(i,j,r)}}
    186           + sum{i,TRAD_COMM, VIPA0(i,r) - VIPM0(i,r)}
    187           + sum{i,TRAD_COMM, VDPA0(i,r) - VDPM0(i,r)}
    188           + sum{i,TRAD_COMM, VIGA(i,r) - VIGM(i,r)}
    189           + sum{i,TRAD_COMM, VDGA(i,r) - VDGM(i,r)}
    190           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VIFA(i,j,r) - VIFM(i,j,r)}}
    191           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VDFA(i,j,r) - VDFM(i,j,r)}}
    192           + sum{i,TRAD_COMM, sum{s,REG, VXWD(i,r,s) - VXMD(i,r,s)}}
    193           + sum{i,TRAD_COMM, sum{s,REG, VIMS(i,s,r) - VIWS(i,s,r)}};
    194    
    195   ![[!
    196       -------------------
    197       INCLUDE HHOUSEHOLDS
    198       -------------------
    199   !]]!
    200    
    201   Coefficient (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    202           EVOAH(i,h,r) # Value of output at agent's prices #;
    203   formula (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    204           EVOAH(i,h,r) = EVOA0(i,r) ;
    205    
    206   Coefficient (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    207           EVOMH(i,h,r) # Value of commodity i output in region r at market prices #;
    208   formula (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    209           EVOMH(i,h,r) = VOM(i,r);
    210    
    211   Coefficient (all,h,HHLD)(all,r,REG)
    212           VKBH(h,r) # Value of output at agent's prices #;
    213   formula (all,h,HHLD)(all,r,REG)
    214           VKBH(h,r) = VKB0(r) ;
    215    
    216   Coefficient (all,h,HHLD)(all,r,REG)
    217           VDEPH(h,r) # Value of capital depreciation in r (exogenous) #;
    218   formula (all,h,HHLD)(all,r,REG)
    219           VDEPH(h,r) = VDEP0(r);
    220    
    221   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    222           VIPAH(i,h,r) # Private household h expenditure on imported i in r #;
    223   formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    224           VIPAH(i,h,r) = VIPA0(i,r);
    225    
    226   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    227           VDPAH(i,h,r) # Private household expenditure on domestic i in r #;
    228   formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    229           VDPAH(i,h,r) = VDPA0(i,r);
    230    
    231   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    232           VIPMH(i,h,r) # Private household expenditure on i in r #;
    233   formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    234           VIPMH(i,h,r) = VIPM0(i,r);
    235    
    236   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    237           VDPMH(i,h,r) # Private household expenditure on domestic i in r #;
    238   formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    239           VDPMH(i,h,r) = VDPM0(i,r);
    240    
    241   Coefficient (all,h,HHLD)(all,k,HHLD)(all,r,REG)
    242           TRNH(h,k,r) # Value of transfers between households #;
    243   formula    (all,h,HHLD)(all,k,HHLD)(all,r,REG)
    244           TRNH(h,k,r) = 0 ;
    245    
    246   ![[!
    247     ----------------------------
    248     Other Incomes and Transfers
    249     ----------------------------
    250   !]]!
    251    
    252   Coefficient
    253       (all,r,REG) FYI0(r)  # Foreign capital income for r # ;
    254       (all,r,REG) FYO0(r)  # Foreign capital outflow from r#;
    255       (all,r,REG) AIDI0(r) # Foreign aid income  for r # ;
    256       (all,r,REG) AIDO0(r) # Foreign aid outflow for r # ;
    257       (all,r,REG) REMI0(r) # Foreign Remittance income for r # ;
    258       (all,r,REG) REMO0(r) # Foreign Remittance outflows  for r # ;
    259       (all,r,REG) TRNG(r) # Government transfers for r # ;
    260    
    261   Read FYI0  from file EXTDATA header "FYI" ;
    262        FYO0  from file EXTDATA header "FYO" ;
    263        AIDI0 from file EXTDATA header "AIDI" ;
    264        AIDO0 from file EXTDATA header "AIDO" ;
    265        REMI0 from file EXTDATA header "REMI" ;
    266        REMO0 from file EXTDATA header "REMO" ;
    267        TRNG from file EXTDATA header "TRNG" ;
    268    
    269   !Rescale to ensure the values IN and OUT are Equal!
    270    
    271   !<formula (all,r,REG: TRANSG(r)<0)
    272       TRANSG(r)  = 0 ;>!
    273    
    274   Coefficient AVGFY ;
    275   Formula AVGFY = sum{r,REG,FYI0(r)+FYO0(r)}/2;
    276   Coefficient
    277       (all,h,HHLD)(all,r,REG)   FYI(h,r)   #Foreign capital income for r # ;
    278       (all,h,HHLD)(all,r,REG)   FYO(h,r)  #Foreign capital outflow from r #;
    279   Formula  (all,h,HHLD)(all,r,REG)
    280       FYI(h,r)  =  FYI0(r)*AVGFY / sum{s,REG,FYI0(s)};
    281   Formula  (all,h,HHLD)(all,r,REG)
    282       FYO(h,r) =  FYO0(r)*AVGFY / sum{s,REG,FYO0(s)};
    283    
    284   Coefficient AVGAID ;
    285   Formula AVGAID = sum{r,REG,AIDI0(r)+AIDO0(r)}/2;
    286   Coefficient
    287       (all,r,REG)   AIDI(r)   #Foreign capital income for r # ;
    288       (all,r,REG)   AIDO(r)  #Foreign capital outflow from r #;
    289   Formula  (all,r,REG)
    290       AIDI(r)  =  AIDI0(r)*AVGAID / sum{s,REG,AIDI0(s)};
    291   Formula  (all,r,REG)
    292       AIDO(r) =  AIDO0(r)*AVGAID / sum{s,REG,AIDO0(s)};
    293    
    294   Coefficient AVGREM ;
    295   Formula AVGREM = sum{r,REG,REMI0(r)+REMO0(r)}/2;
    296   Coefficient
    297        (all,h,HHLD)(all,r,REG)   REMI(h,r)   #Foreign capital income for r # ;
    298        (all,h,HHLD)(all,r,REG)   REMO(h,r)  #Foreign capital outflow from r #;
    299   Formula (all,h,HHLD)(all,r,REG)
    300       REMI(h,r)  =  REMI0(r)*AVGREM / sum{s,REG,REMI0(s)};
    301   Formula  (all,h,HHLD)(all,r,REG)
    302       REMO(h,r) =  REMO0(r)*AVGREM / sum{s,REG,REMO0(s)};
    303    
    304   ![[!
    305       -----------------------
    306       New Income and Savings
    307       -----------------------
    308   !]]!
    309    
    310   !Regional Income!
    311   Coefficient (all,r,REG)
    312       INCOME(r) # income, net of depreciation, by Household #;
    313   Formula (all,r,REG)
    314       INCOME(r) = sum{i,ENDW_COMM, EVOA0(i,r)} - VDEP0(r)
    315                + NETAXES(r)
    316                + sum(h, HHLD, FYI(h,r) - FYO(h,r) +
    317                + REMI(h,r) - REMO(h,r))
    318                + AIDI(r) - AIDO(r) ;
    319    
    320   Coefficient (all,h,HHLD)(all,r,REG)
    321       PRIVEXP(h,r) # Private expenditure by Household #;
    322   Formula (all,h,HHLD)(all,r,REG)
    323       PRIVEXP(h,r) = sum(t, TRAD_COMM, VIPAH(t,h,r) + VDPAH(t,h,r)) ;
    324    
    325   Coefficient (all,r,REG)
    326       SAVE(r) # income, net of depreciation, by Household #;
    327   Formula (all,r,REG)
    328       SAVE(r) = INCOME(r) - sum(h, HHLD, PRIVEXP(h,r)) - GOVEXP(r) ;
    329    
    330   ! Govt income !
    331   Coefficient (all,r,REG)
    332       GINCOME(r) # income, net of depreciation, by Household #;
    333   Formula (all,r,REG)
    334       GINCOME(r) = NETAXES(r) - TRNG(r)
    335                + AIDI(r) - AIDO(r) ;
    336    
    337   Coefficient (all,r,REG)
    338           SAV_GOV(r) # Value of commodity i output in region r at market prices #;
    339   formula (all,r,REG)
    340           SAV_GOV(r) = GINCOME(r) - GOVEXP(r) ;
    341    
    342   ! Household !
    343   Coefficient (all,h,HHLD)(all,r,REG)
    344       HINCOME(h,r) # income, net of depreciation, by Household #;
    345   Formula (all,h,HHLD)(all,r,REG)
    346       HINCOME(h,r) = sum{i,ENDW_COMM, EVOAH(i,h,r)} - VDEPH(h,r)
    347                + FYI(h,r) - FYO(h,r) +
    348                + REMI(h,r) - REMO(h,r) + TRNG(r) ;
    349    
    350   Coefficient
    351       (all,h,HHLD)(all,r,REG)
    352           SAV_HHLD(h,r) # Value of commodity i output in region r at market prices #;
    353   formula    (all,h,HHLD)(all,r,REG)
    354           SAV_HHLD(h,r) = HINCOME(h,r) - PRIVEXP(h,r);
    355    
    356   Coefficient (all,r,REG)
    357           SAVECHK(r) # Value of commodity i output in region r at market prices #;
    358   formula (all,r,REG)
    359           SAVECHK(r) = SAVE(r) - SAV_GOV(r) - sum(h, HHLD, SAV_HHLD(h,r));
    360    
    361   ![[!
    362       ------------
    363       Write Output
    364       ------------
    365    !]]!
    366    
    367   write
    368       AIDI to file NEWDATA header "AIDI";
    369       AIDO to file NEWDATA header "AIDO";
    370       FYI to file NEWDATA header "FYI";
    371       FYO to file NEWDATA header "FYO";
    372       REMI to file NEWDATA header "REMI";
    373       REMO to file NEWDATA header "REMO";
    374       TRNG to file NEWDATA header "TRNG";
    375       VKBH to file NEWDATA header "VKB";
    376       EVOAH to file NEWDATA header "EVOA";
    377       EVOMH to file NEWDATA header "EVOM";
    378       EVFA to file NEWDATA header "EVFA";
    379       VIFA to file NEWDATA header "VIFA";
    380       VDFA to file NEWDATA header "VDFA";
    381       VIPAH to file NEWDATA header "VIPA";
    382       VDPAH to file NEWDATA header "VDPA";
    383       VIGA to file NEWDATA header "VIGA";
    384       VDGA to file NEWDATA header "VDGA";
    385       VDEPH to file NEWDATA header "VDEP";
    386       VXMD to file NEWDATA header "VXMD";
    387       VST to file NEWDATA header "VST";
    388       VFM to file NEWDATA header "VFM";
    389       VIFM to file NEWDATA header "VIFM";
    390       VDFM to file NEWDATA header "VDFM";
    391       VIPMH to file NEWDATA header "VIPM";
    392       VDPMH to file NEWDATA header "VDPM";
    393       VIGM to file NEWDATA header "VIGM";
    394       VDGM to file NEWDATA header "VDGM";
    395       VIMS to file NEWDATA header "VIMS";
    396       SAV_GOV to file NEWDATA header "SGOV" longname
    397       "Government Savings";
    398       SAV_HHLD to file NEWDATA header "SHLD" longname
    399       "Houehold Savings";
    400       SAVE to file NEWDATA header "SAVE" longname
