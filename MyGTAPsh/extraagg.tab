![[!
    ==========================================
    ImpactECON MyGTAP Model auxillary programs
    March 2026

    This program aggregates extra data countries to regions for MyGTAP model

    ImpactECON LLC, Boulder, Colorado 
    https://impactecon.com/ 

    ==========================================

Purpose of program:
1. Produce MGTAP database for RunGTAP application with single household.

Author: Peter Minor and Terrie L walmsley

HISTORY
1. Produced for a single household version of the MyGTAP that incorporates Balance 
of payments data and splits government and private savings. This program initially 
aggregated the extra data countries to regions for MyGTAP model. (June 2, 2015)

2. Updated March 13, 2026 to use GTAP12 data which includes additional the extra 
BOP data in header VBPF of the GTAP v7 dataset.
 
!]]!

file
    SSFILE #standard sets#;

set
    REG #regions#
    read elements from file SSFILE header "H1";

set BOPSets #BOP data# (FYI, FYO, AIDI, AIDO, RMI, RMO) ;

file
    INFILE #foreign income data, by country#;

file (new)
    OUTFILE #foreign income#;

coefficient (all,b,BOPSets)(all,c,REG)
    BOP(c,b) #Balance of paymnents data#;
read
    BOP from file INFILE header "VBPF";

coefficient (all,c,REG)
    AIDIN(c) #Aidin#;
formula (all,c,REG)
    AIDIN(c) = BOP(c,"AIDI");

coefficient (all,c,REG)
    AIDOUT(c) #foreign income receipts, by country#;
Formula (all,c,REG)
    AIDOUT(c) = BOP(c,"AIDO");

coefficient (all,c,REG)
    FYIN(c) #foreign income receipts, by country#;
formula (all,c,REG)
    FYIN(c) = BOP(c,"FYI");

coefficient (all,c,REG)
    FYOUT(c) #foreign income receipts, by country#;
formula (all,c,REG)
    FYOUT(c) = BOP(c,"FYO");

coefficient (all,c,REG)
    REMIN(c) #foreign income receipts, by country#;
formula (all,c,REG)
    REMIN(c) = BOP(c,"RMI");

coefficient (all,c,REG)
    REMOUT(c) #foreign income receipts, by country#;
formula (all,c,REG)
    REMOUT(c) = BOP(c,"RMO");

write
    AIDIN to file OUTFILE header "AIDI" ;
    AIDOUT to file OUTFILE header "AIDO" ;
    FYIN to file OUTFILE header "FYI" ;
    FYOUT to file OUTFILE header "FYO" ;
    REMIN to file OUTFILE header "RMI" ;
    REMOUT to file OUTFILE header "RMO" ;



