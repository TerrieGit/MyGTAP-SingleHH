     10    
     11       ==========================================
     12    
     13   Adapted from:
     14    
     15   GTPVEW.tab for GTAP model
     16   Global Trade Analysis Project
     17   The GTAP Modeling Framework
     18   GTAPVIEW.TAB FILE
     19   By Thomas Hertel, Melanie Bacou,and Wusheng Yu
     20    
     21       --------------------
     22       History of this file
     23       --------------------
     24       April 29, 1998: Following features are new:
     25           - disposition of output across all uses
     26           - full set of tax rates are available now for all transactions
     27       Sept, 1998: eliminate unnecessary sets.
     28       October, 1998: add code to compute the initial tax rates.
     29       May, 2000: Modified by Ken Itakura
     30           - added Appendix on elasticities
     31           - reformatted
     32       July, 2003: Changed element "prod" of set SALES to "prd"
     33                   to be compatible with Release 8.0 of GEMPACK
     34       May 2016: adapted for MyGTAP model by Terrie Walmsley
     35    
     36       --------------------------------------
     37       Overview of the GTAPVIEW.TAB structure
     38       --------------------------------------
     39       FILE declaration
     40       SET declaration
     41       READ statements of Base Data
     42       Derivatives of the Base Data
     43           1. Macro variables ( Reg )
     44           2.Trade, Transport and Protection ( Reg x Reg )
     45           3. Commodities ( Comm x Reg )
     46           4. Sectors ( Comm x Reg )
     47       Write statements of the Derivatives
     48       Computation of Initial Tax Rates
     49       Appendix: Derived Elasticities of demands >!
     50    
     51    
     52    
     53   !<
     54       -----
     55       FILES
     56       -----
     57   >!
     58    
     59   File
     60       GTAPDATA # File containing all base data #;
     61   File
     62       GTAPSETS # File with set specification #;
     63   File
     64       GTAPPARM # File containing behavioral prameters #;
     65      ! above not actually used, but must leave in !
     66   File (new)
     67       GTAPVIEW # File with headers for viewing #;
     68   File (new)
     69       TAXRATES # File with headers for viewing initial tax rates #;
     70    
     71   !<
     72       ----
     73       SETS
     74       ----
     75   >!
     76   set HOU # New Household #
     77       read elements from file GTAPSETS header "HOU";
     78   Set
     79       REG # Regions in the model #
     80       maximum size 10 read elements from file GTAPSETS header "H1";
     81   Set
     82       TRAD_COMM # Traded commodities #
     83       maximum size 10 read elements from file GTAPSETS header "H2";
     84   Set
     85       MARG_COMM # Margin commodities #
     86       maximum size 10 read elements from file GTAPSETS header "MARG";
     87   Subset
     88       MARG_COMM is subset of TRAD_COMM;
     89   Set
     90       NMRG_COMM # Non-margin commodities # = TRAD_COMM - MARG_COMM;
     91   Set
     92       CGDS_COMM # Capital goods commodities #
     93       maximum size 1  read elements from file GTAPSETS header "H9";
     94   Set
     95       ENDW_COMM # Endowment commodities #
     96       maximum size 5  read elements from file GTAPSETS header "H6";
     97   !Set
     98       ENDWC_COMM # Capital Endowment Commodity # (capital); !
     99   Set
    100       PROD_COMM # PRODUCED COMMODITIES  # = TRAD_COMM union CGDS_COMM;
    101   Set
    102       DEMD_COMM # DEMANDED COMMODITIES # = ENDW_COMM union TRAD_COMM;
    103   Set
    104       NSAV_COMM # NON-SAVINGS COMMODITIES # = DEMD_COMM union CGDS_COMM;
    105   Subset
    106       PROD_COMM is subset of NSAV_COMM;
    107   !Subset
    108       ENDWC_COMM is subset of NSAV_COMM;!
    109    
    110   !<
    111       The following are new sets for GTAPVIEW
    112       Supplementary sets for "toggles" in VIEWHAR
    113   >!
    114    
    115   Set GDPEXPEND(cons,inv,gov,export,imp);
    116   Set GDPSOURCE(fact,tax,depr);
    117   Set CAPACCT(save,inv);
    118   Set CURACCT(export,imp);
    119   Set MKTVALUE(fob,trans);
    120   Set OUT(dom,trans,export);
    121   Set SALES(production,cons,gov);
    122   Set PURCHVALUE(mktexp,comtax);
    123   Set DIR(domestic,imported);
    124   Set OUTVALUE(prodrev,outtax);
    125   Set EXPVALUE(exprev,xtax);
    126   Set IMPVALUE(impcost,mtax);
    127    
    128   !<
    129       ----------------------------
    130       READ statements of Base Data
    131       ----------------------------
    132    
    133       base revenues and expenditures at agent's prices
    134       ------------------------------------------------
    135   >!
    136   Coefficient (all,h,HOU) (all,r,REG)
    137       SAV_HHLD(h,r) # income, net of depreciation, by Household #;
    138   Read
    139       SAV_HHLD from file GTAPDATA header "SHLD";
    140    
    141   Coefficient (all,r,REG)
    142       SAV_GOV(r) # income, net of depreciation, by Household #;
    143   Read
    144       SAV_GOV from file GTAPDATA header "SGOV";
    145   Coefficient (all,i,ENDW_COMM)(all,h,HOU)(all,r,REG)
    146       EVOA(i,h,r) # Value of output at agent's prices #;
    147   Read
    148       EVOA from file GTAPDATA header "EVOA";
    149    
    150   Coefficient (all,i,ENDW_COMM)(all,h,HOU)(all,r,REG)
    151       EVOM(i,h,r) # Value of output at agent's prices #;
    152   Read
    153       EVOM from file GTAPDATA header "EVOM";
    154    
    155   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    156       EVFA(i,j,r) # Producer expenditure on i by industry j #;
    157   Read
    158       EVFA from file GTAPDATA header "EVFA";
    159    
    160   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    161       VIFA(i,j,r) # Purchases of imported i r for use in j in region r #;
    162   Read
    163       VIFA from file GTAPDATA header "VIFA";
    164    
    165   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    166       VDFA(i,j,r) # Purchases of domestic i r for use in j in region r #;
    167   Read
    168       VDFA from file GTAPDATA header "VDFA";
    169    
    170   Coefficient (all,i,TRAD_COMM) (all,r,REG)(all,h,HOU)
    171       VIPA(i,h,r) # Private household h expenditure on imported i in r #;
    172   Read
    173       VIPA from file GTAPDATA header "VIPA";
    174    
    175   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,h,HOU)
    176       VDPA(i,h,r) # Private household expenditure on domestic i in r #;
    177   Read
    178       VDPA from file GTAPDATA header "VDPA";
    179    
    180   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    181       VIGA(i,r) # Government household expenditure on imported i #;
    182   Read
    183       VIGA from file GTAPDATA header "VIGA";
    184    
    185   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    186       VDGA(i,r) # Government household expenditure on domestic i in r #;
    187   Read
    188       VDGA from file GTAPDATA header "VDGA";
    189    
    190   Coefficient (all,h,HOU)(all, r, REG)
    191       VKB(h,r) # Value of beginning-of-period capital stock, in region r #;
    192   Read
    193       VKB from file GTAPDATA header "VKB";
    194    
    195   Coefficient (all,h,HOU)(all, r, REG)
    196       VDEP(h,r) # Value of capital depreciation in r (exogenous) #;
    197   Read
    198       VDEP from file GTAPDATA header "VDEP";
    199    
    200   !<
    201       base revenues and expenditures at prices
    202       ----------------------------------------
    203   >!
    204    
    205   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    206       VXMD(i,r,s) # Exports of i from r to s at market prices (tradeables only) #;
    207   Read
    208       VXMD from file GTAPDATA header "VXMD";
    209    
    210   Coefficient (ge 0)(all,m,MARG_COMM)(all,r,REG)
    211       VST(m,r)
    212       # Exports of m from r for int'l transport at mkt prices (tradeables only) #;
    213   Read
    214       VST from file GTAPDATA header "VST";
    215    
    216   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    217       VFM(i,j,r) # Producer expenditure on i by j in r at market prices #;
    218   Read
    219       VFM from file GTAPDATA header "VFM";
    220    
    221   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    222       VIFM(i,j,r) # Purchases of imports i for use in j in region r #;
    223   Read
    224       VIFM from file GTAPDATA header "VIFM";
    225    
    226   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    227       VDFM(i,j,r) # Purchases of domestic i r for use in j in region r #;
    228   Read
    229       VDFM from file GTAPDATA header "VDFM";
    230    
    231   Coefficient (all,i,TRAD_COMM) (all,r,REG)(all,h,HOU)
    232       VIPM(i,h,r) # Private household expenditure on i in r #;
    233   Read
    234       VIPM from file GTAPDATA header "VIPM";
    235    
    236   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,h,HOU)
    237       VDPM(i,h,r) # Private household expenditure on domestic i in r #;
    238   Read
    239       VDPM from file GTAPDATA header "VDPM";
    240    
    241   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    242       VIGM(i,r) # Gov't household expenditure on i in r #;
    243   Read
    244       VIGM from file GTAPDATA header "VIGM";
    245    
    246   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    247       VDGM(i,r) # Government household expenditure on domestic i in r #;
    248   Read
    249       VDGM from file GTAPDATA header "VDGM";
    250    
    251   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    252       VIMS(i,r,s) # Imports of i from r to s valued at domestic mkt prices #;
    253   Read
    254       VIMS from file GTAPDATA header "VIMS";
    255    
    256   !<
    257       base revenues and expenditures at world prices
    258       ----------------------------------------------
    259   >!
    260    
    261   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    262       VXWD(i,r,s) # Exports of i from r to s valued fob (tradeables only) #;
    263   Read
    264       VXWD from file GTAPDATA header "VXWD";
    265    
    266   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    267       VIWS(i,r,s) # Imports of i from r to s valued cif (tradeables only) #;
    268   Read
    269       VIWS from file GTAPDATA header "VIWS";
    270    
    271   Coefficient (all,k,MARG_COMM)(all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    272       VTWR(k,i,r,s)
    273       # Value of transport services at world prices, by destination #;
    274   Read
    275       VTWR from file GTAPDATA header "VTWR";
    276    
    277   !<
    278      Grants, remittances and transfers
    279       --------------------------------
    280   >!
    281    
    282    
    283   Coefficient
    284   (all,r,REG) GRANTSIN(r) # foreign aid in #;
    285   (all,r,REG) GRANTSOUT(r) # foreign aid out #;
    286   (all,h,HOU) (all,r,REG) FYI_HHLD(h,r) # foreign income in #;
    287   (all,h,HOU) (all,r,REG) FYO_HHLD(h,r) # foregin income out #;
    288   (all,h,HOU) (all,r,REG) REMIN_HHLD(h,r) # Remittances in #;
    289   (all,h,HOU) (all,r,REG) REMOUT_HHLD(h,r) # Remittances out #;
    290   (all,h,HOU)(all,k,HOU)(all,r,REG) TRANS_HHLD(h,k,r)
    291   # transfers between households - transfers to/from #;
    292   (all,h,HOU)(all,r,REG) TRANS_GOV(h,r)
    293   # transfers to household h from government #;
    294    
    295   Read (ifheaderexists)
    296       GRANTSIN from file GTAPDATA header "AIDI";
    297       GRANTSOUT from file GTAPDATA header "AIDO";
    298       FYI_HHLD from file GTAPDATA header "FYI";
    299       FYO_HHLD from file GTAPDATA header "FYO";
    300       REMIN_HHLD from file GTAPDATA header "REMI";
    301       REMOUT_HHLD from file GTAPDATA header "REMO";
    302       TRANS_HHLD from file GTAPDATA header "TRNH";
    303       TRANS_GOV from file GTAPDATA header "TRNG";
    304    
    305   !<
    306       ----------------------------
    307       DERIVATIVES OF THE BASE DATA
    308       ----------------------------
    309    
    310       1. Macro variables ( Reg )
    311       --------------------------
    312           GDPEXP
    313           GDPSRC
    314           CAPITALACCT
    315           CURRENTACCT
    316    
    317   >!
    318    
    319   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,h, HOU)
    320       VPA(i,r,h) # Private household expenditure on i in r at agent's prices #;
    321   Formula (all,i,TRAD_COMM)(all,r,REG)(all,h,HOU)
    322       VPA(i,r,h) = VDPA(i,h,r) + VIPA(i,h,r);
    323   Coefficient (all,r,REG)
    324       PRIVEXP(r) # Private consumption expenditure in region r #;
    325   Formula (all,r,REG)
    326       PRIVEXP(r) = sum{i,TRAD_COMM, sum{h, HOU, VPA(i,r,h)}};
    327    
    328   Coefficient (all,i,DEMD_COMM)(all,j,PROD_COMM)(all,r,REG)
    329       VFA(i,j,r) # Firm's expenditure on i by industry j #;
    330   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    331       VFA(i,j,r) = EVFA(i,j,r);
    332   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    333       VFA(i,j,s) = VDFA(i,j,s) + VIFA(i,j,s);
    334   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    335       VOA(i,r) # Value of commodity i output in region r #;
    336   Formula (all,i,ENDW_COMM)(all,r,REG)
    337       VOA(i,r) = sum(h, HOU, EVOA(i,h,r));
    338   Formula (all,i,PROD_COMM)(all,r,REG)
    339       VOA(i,r) = sum{j,DEMD_COMM, VFA(j,i,r)};
    340   Coefficient (all, r, REG)
    341       REGINV(r) # Regional gross investment in region r #;
    342   Formula (all, r, REG)
    343       REGINV(r) = sum{k,CGDS_COMM, VOA(k,r)};
    344    
    345   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    346       VGA(i,r) # Government household expenditure on i in r at agent's prices #;
    347   Formula (all,i,TRAD_COMM)(all,s,REG)
    348       VGA(i,s) = VDGA(i,s) + VIGA(i,s);
    349   Coefficient (all,r,REG)
    350       GOVEXP(r) # Government expenditure in region r #;
    351   Formula (all,r,REG)
    352       GOVEXP(r) = sum{i,TRAD_COMM, VGA(i,r)};
    353    
    354   Coefficient (all,r,REG)
    355       VEXPORTS(r)
    356       # Value of merchandise and services sales to the world market from r #;
    357   Formula (all,r,REG)
    358       VEXPORTS(r)
    359           = sum{i,NMRG_COMM, sum{s,REG, VXWD(i,r,s)}}
    360           + sum{m,MARG_COMM, sum{s,REG, VXWD(m,r,s)} + VST(m,r)}
    361   ;
    362    
    363   Coefficient (all,s,REG)
    364       VIMPORTS(s)
    365       # Value of merchandise and services purchases from world market by s #;
    366   Formula (all,s,REG)
    367       VIMPORTS(s) = sum{i,TRAD_COMM, sum{r,REG, VIWS(i,r,s)}};
    368    
    369   Coefficient  (all,r,REG)(all,k,GDPEXPEND)
    370       GDPEXP(r,k) # Composition of GDP from the expenditure side #;
    371   Formula  (all,r,REG)
    372       GDPEXP(r,"cons") = PRIVEXP(r);
    373   Formula  (all,r,REG)
    374       GDPEXP(r,"inv") = REGINV(r);
    375   Formula  (all,r,REG)
    376       GDPEXP(r,"gov") = GOVEXP(r);
    377   Formula  (all,r,REG)
    378       GDPEXP(r,"export") = VEXPORTS(r);
    379   Formula  (all,r,REG)
    380       GDPEXP(r,"imp") = - VIMPORTS(r);
    381    
    382   Coefficient (all,r,REG)
    383       NETFACTINC(r) # Factor income, net of depreciation #;
    384   Formula (all,r,REG)
    385       NETFACTINC(r) = sum{i,ENDW_COMM, VOA(i,r)} - sum(h, HOU, VDEP(h,r));
    386    
    387   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    388       VDM(i,r) # Domestic sales of i in r at market prices (tradeables only) #;
    389   Formula (all,i,TRAD_COMM)(all,r,REG)
    390   VDM(i,r) = sum{h, HOU, VDPM(i,h,r)} + VDGM(i,r) + sum{j,PROD_COMM, VDFM(i,j,r)};
    391    
    392   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    393       VOM(i,r) # Value of commodity i output in region r at market prices #;
    394   Formula (all,i,ENDW_COMM)(all,r,REG)
    395       VOM(i,r) = sum{j,PROD_COMM, VFM(i,j,r)};
    396   Formula (all,m,MARG_COMM)(all,r,REG)
    397       VOM(m,r) = VDM(m,r) + sum{s,REG, VXMD(m,r,s)} + VST(m,r);
    398   Formula (all,i,NMRG_COMM)(all,r,REG)
    399       VOM(i,r) = VDM(i,r) + sum{s,REG, VXMD(i,r,s)};
    400   Formula (all,h,CGDS_COMM)(all,r,REG)
    401       VOM(h,r) = VOA(h,r);
    402    
    403   Coefficient (all,r,REG)
    404       NETAXES(r) # Net tax revenues in r #;
    405   Formula (all,r,REG)
    406       NETAXES(r)
    407           = sum{i,NSAV_COMM, VOM(i,r) - VOA(i,r)}
    408           + sum{j,PROD_COMM, sum{i,ENDW_COMM, VFA(i,j,r) - VFM(i,j,r)}}
    409           + sum{i,TRAD_COMM, sum{h, HOU, VIPA(i,h,r) - VIPM(i,h,r)}}
    410           + sum{i,TRAD_COMM, sum{h, HOU, VDPA(i,h,r) - VDPM(i,h,r)}}
    411           + sum{i,TRAD_COMM, VIGA(i,r) - VIGM(i,r)}
    412           + sum{i,TRAD_COMM, VDGA(i,r) - VDGM(i,r)}
    413           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VIFA(i,j,r) - VIFM(i,j,r)}}
    414           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VDFA(i,j,r) - VDFM(i,j,r)}}
    415           + sum{i,TRAD_COMM, sum{s,REG, VXWD(i,r,s) - VXMD(i,r,s)}}
    416           + sum{i,TRAD_COMM, sum{s,REG, VIMS(i,s,r) - VIWS(i,s,r)}}
    417   ;
    418    
    419   Coefficient (all,r,REG)(all,k,GDPSOURCE)
    420       GDPSRC(r,k) # Composition of GDP from the sources side #;
    421   Formula (all,r,REG)
    422       GDPSRC(r,"fact") = NETFACTINC(r);
    423   Formula (all,r,REG)
    424       GDPSRC(r,"tax") = NETAXES(r);
    425   Formula (all,r,REG)
    426       GDPSRC(r,"depr") = sum(h, HOU, VDEP(h,r));
    427   Coefficient (all,r,REG)
    428       SAVE(r) # Total Regional savings #;
    429   Formula (initial) (all,r,REG)
    430       SAVE(r) = SAV_GOV(r) + sum{h,HOU,SAV_HHLD(h,r)};
    431    
    432   Coefficient (all, r, REG)
    433       NETINV(r) # Regional net investment in region r #;
    434   Formula (all, r, REG)
    435       NETINV(r) = REGINV(r) - sum(h, HOU, VDEP(h,r));
    436    
    437   Coefficient (all,r,REG)(all,k,CAPACCT)
    438       CAPITALACCT(r,k) # S - I = X - M #;
    439   Formula (all,r,REG)
    440       CAPITALACCT(r,"save") = save(r);
    441   Formula (all,r,REG)
    442       CAPITALACCT(r,"inv") = - NETINV(r);
    443    
    444   Coefficient (all,r,REG)(all,k,CURACCT)(all,i,TRAD_COMM)
    445       CURRENTACCT(r,k,i) # X - M = S - I #;
    446   Formula (all,r,REG)(all,m,MARG_COMM)
    447       CURRENTACCT(r,"export",m) = sum{s,REG, VXWD(m,r,s)} + VST(m,r);
    448   Formula (all,r,REG)(all,i,NMRG_COMM)
    449       CURRENTACCT(r,"export",i) = sum{s,REG, VXWD(i,r,s)};
    450   Formula  (all,r,REG)(all,i,TRAD_COMM)
    451       CURRENTACCT(r,"imp",i) = - sum{s,REG, VIWS(i,s,r)};
    452    
    453   !<
    454       2.Trade, Transport and Protection ( Reg x Reg )
    455       -----------------------------------------------
    456           VALEXPORTS
    457           VALIMPORTS
    458           CIFDECOMP
    459    
    460   >!
    461    
    462   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)(all,k,EXPVALUE)
    463       VALEXPORTS(i,r,s,k) # Value of exports at world prices #;
    464   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    465       VALEXPORTS(i,r,s,"exprev") = VXMD(i,r,s);
    466   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    467       VALEXPORTS(i,r,s,"xtax") = VXWD(i,r,s) - VXMD(i,r,s);
    468    
    469   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)(all,k,IMPVALUE)
    470       VALIMPORTS(i,r,s,k) # Value of imports at domestic prices #;
    471   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    472       VALIMPORTS(i,r,s,"impcost") = VIWS(i,r,s);
    473   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    474       VALIMPORTS(i,r,s,"mtax") = VIMS(i,r,s) - VIWS(i,r,s);
    475    
    476   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)(all,j,MKTVALUE)
    477       CIFDECOMP(i,r,s,j) # Value of tradables from r to s #;
    478   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    479       CIFDECOMP(i,r,s,"fob") = VXWD(i,r,s);
    480   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    481       CIFDECOMP(i,r,s,"trans") = VIWS(i,r,s) - VXWD(i,r,s);
    482    
    483   !<
    484       3. Commodities ( Comm x Reg )
    485       -----------------------------
    486           OUTDISP
    487           DOMSALESDISP
    488           IMPSALESDISP
    489           VALOUTPUT
    490           SUFFICIENCY
    491    
    492   >!
    493    
    494   Coefficient (all,i,TRAD_COMM)(all,j,OUT)(all,r,REG)
    495       OUTDISP(i,j,r)
    496       # Value of sales of tradables to different markets at dom market price #;
    497   Formula (all,i,TRAD_COMM)(all,j,OUT)(all,r,REG)
    498       OUTDISP(i,j,r) = 0.0;
    499   Formula (all,i,TRAD_COMM)(all,r,REG)
    500       OUTDISP(i,"dom",r) = VDM(i,r);
    501   Formula (all,m,MARG_COMM)(all,r,REG)
    502       OUTDISP(m,"trans",r) = VST(m,r);
    503   Formula (all,i,TRAD_COMM)(all,r,REG)
    504       OUTDISP(i,"export",r) = sum{s,REG, VXMD(i,r,s)};
    505    
    506   Coefficient (all,i,TRAD_COMM)(all,m,SALES)(all,r,REG)
    507       DOMSALESDISP(i,m,r)
    508       # Value of domestic sales of tradables at dom market price #;
    509   Formula (all,i,TRAD_COMM)(all,r,REG)
    510       DOMSALESDISP(i,"production",r) = sum{j,PROD_COMM, VDFM(i,j,r)};
    511   Formula  (all,i,TRAD_COMM)(all,r,REG)
    512       DOMSALESDISP(i,"cons",r) = sum{h, HOU, VDPM(i,h,r)};
    513   Formula  (all,i,TRAD_COMM)(all,r,REG)
    514       DOMSALESDISP(i,"gov",r) = VDGM(i,r);
    515    
    516   Coefficient (all,i,TRAD_COMM)(all,m,SALES)(all,r,REG)
    517       IMPSALESDISP(i,m,r)
    518       # Value of sales of tradables to different markets at dom market price #;
    519   Formula (all,i,TRAD_COMM)(all,r,REG)
    520       IMPSALESDISP(i,"production",r) = sum{j,PROD_COMM, VIFM(i,j,r)};
    521   Formula (all,i,TRAD_COMM)(all,r,REG)
    522       IMPSALESDISP(i,"cons",r) = sum{h,HOU, VIPM(i,h,r)};
    523   Formula (all,i,TRAD_COMM)(all,r,REG)
    524       IMPSALESDISP(i,"gov",r) = VIGM(i,r);
    525    
    526   !<
    527       Finally, calculate some policy instruments of interest.
    528       Note that this approach produces positive taxes,
    529       but GROSS tax rates.
    530   >!
    531   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,k,OUTVALUE)
    532       VALOUTPUT(i,r,k) # Value of output at agent's prices #;
    533   Formula (all,i,TRAD_COMM)(all,r,REG)
    534       VALOUTPUT(i,r,"prodrev") = VOA(i,r);
    535   Formula (all,i,TRAD_COMM)(all,r,REG)
    536       VALOUTPUT(i,r,"outtax") = VOM(i,r) - VOA(i,r);
    537    
    538   Zerodivide (zero_by_zero) default 0;
    539   Zerodivide (NONZERO_BY_ZERO) default 0;
    540    
    541   Coefficient (all,i, TRAD_COMM)(all,r, REG)
    542       SUFFICIENCY(i,r) # Region's r rate of self-sufficiency for good i #;
    543   Formula (all,i, TRAD_COMM)(all,r, REG)
    544       SUFFICIENCY(i,r) = VOM(i,r) / [VDM(i,r) + sum{s,REG, VIMS(i,s,r)}];
    545    
    546   Zerodivide (zero_by_zero) off;
    547   Zerodivide (NONZERO_BY_ZERO) off;
    548    
    549   !<
    550       4. Sectors ( Comm x Reg )
    551       -------------------------
    552           NVFA
    553           NVPA
    554           NVGA
    555    
    556   >!
    557    
    558   Coefficient (all,i,DEMD_COMM)(all,j,PROD_COMM)(all,r,REG)(all,d,DIR)
    559       (all,k,PURCHVALUE)
    560       NVFA(i,j,r,d,k) # Firm's expenditure on i by industry j #;
    561   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    562       NVFA(i,j,r,"domestic","mktexp") = VFM(i,j,r);
    563   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    564       NVFA(i,j,r,"imported","mktexp") = 0;
    565   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    566       NVFA(i,j,s,"domestic","mktexp") = VDFM(i,j,s);
    567   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    568       NVFA(i,j,s,"imported","mktexp") = VIFM(i,j,s);
    569    
    570   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    571       NVFA(i,j,r,"domestic","comtax") = EVFA(i,j,r) - VFM(i,j,r);
    572   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    573       NVFA(i,j,r,"imported","comtax") = 0;
    574   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    575       NVFA(i,j,s,"domestic","comtax") = VDFA(i,j,s) - VDFM(i,j,s);
    576   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    577       NVFA(i,j,s,"imported","comtax") = VIFA(i,j,s) - VIFM(i,j,s);
    578    
    579   Coefficient (ALL,h,HOU)(all,i,TRAD_COMM)(all,s,REG)(all,d,DIR)(all,k,PURCHVALUE)
    580       NVPA(i,h,s,d,k) # Consumption expenditure on i by industry j #;
    581   Formula (ALL,h,HOU)(all,i,TRAD_COMM)(all,s,REG)
    582       NVPA(i,h,s,"domestic","mktexp") = VDPM(i,h,s);
    583   Formula (ALL,h,HOU)(all,i,TRAD_COMM)(all,s,REG)
    584       NVPA(i,h,s,"imported","mktexp") =  VIPM(i,h,s);
    585    
    586   Formula (ALL,h,HOU)(all,i,TRAD_COMM)(all,s,REG)
    587       NVPA(i,h,s,"domestic","comtax") =
    588       VDPA(i,h,s) - VDPM(i,h,s);
    589   Formula (ALL,h,HOU)(all,i,TRAD_COMM)(all,s,REG)
    590       NVPA(i,h,s,"imported","comtax") = VIPA(i,h,s) - VIPM(i,h,s);
    591    
    592   Coefficient (all,i,TRAD_COMM)(all,s,REG)(all,d,DIR)(all,k,PURCHVALUE)
    593       NVGA(i,s,d,k) # Government expenditure on i by industry j #;
    594   Formula (all,i,TRAD_COMM)(all,s,REG)
    595       NVGA(i,s,"domestic","mktexp") = VDGM(i,s);
    596   Formula (all,i,TRAD_COMM)(all,s,REG)
    597       NVGA(i,s,"imported","mktexp") = VIGM(i,s);
    598    
    599   Formula (all,i,TRAD_COMM)(all,s,REG)
    600       NVGA(i,s,"domestic","comtax") = VDGA(i,s) - VDGM(i,s);
    601   Formula (all,i,TRAD_COMM)(all,s,REG)
    602       NVGA(i,s,"imported","comtax") = VIGA(i,s) - VIGM(i,s);
    603    
    604   !<
    605       -----------------------------------
    606       Write statements of the Derivatives
    607       -----------------------------------
    608    
    609       1. Macro variables ( Reg )
    610       --------------------------
    611   >!
    612   Write GDPEXP to file GTAPVIEW header "AG01" longname
    613       "GDPEXP = C + I + G + X - M, GDP from the expenditure side";
    614   Write GDPSRC to file GTAPVIEW header "AG02" longname
    615       "GDPSRC = NETFACTINC + NETAXES + VDEP, GDP from the sources side";
    616   Write EVFA to file GTAPVIEW header "AG03" longname
    617       "Sources of factor income (NETFACTINC + VDEP) by sector - EVFA(j,r)";
    618   Write CAPITALACCT to file GTAPVIEW header "AG04" longname
    619       "S - I = X - M: CAPITALACCT";
    620   Write CURRENTACCT to file GTAPVIEW header "AG05" longname
    621       "X - M = S - I: CURRENTACCT";
    622   Write VKB to file GTAPVIEW header "AG06" longname
    623       "Capital stock by region - VKB";
    624    
    625   !<
    626       2.Trade, Transport and Protection ( Reg x Reg )
    627       -----------------------------------------------
    628   >!
    629   Write VALEXPORTS to file GTAPVIEW header "BI01" longname
    630       "Decomposition of exports at world prices: VXWD=VXMD+XTAX";
    631   Write VALIMPORTS to file GTAPVIEW header "BI02" longname
    632       "Decomposition of imports at market prices: VIMS=VIWS+MTAX";
    633   Write CIFDECOMP to file GTAPVIEW header "BI03" longname
    634       "Decomposition of cif values - CIFDECOMP";
    635    
    636   ! addition jmhApr2003 -- display trade with own region (diagonal view) !
    637   Coefficient (all,i,TRAD_COMM)(all,q,REG)(all,k,EXPVALUE)
    638       VALOWNEXPORT(i,q,k) # Value of exports to self at world prices #;
    639   Formula (all,i,TRAD_COMM)(all,q,REG)(all,k,EXPVALUE)
    640       VALOWNEXPORT(i,q,k) = VALEXPORTS(i,q,q,k);
    641    
    642   Coefficient (all,i,TRAD_COMM)(all,q,REG)(all,k,IMPVALUE)
    643       VALOWNIMPORT(i,q,k) # Value of imports to self at domestic prices #;
    644   Formula (all,i,TRAD_COMM)(all,q,REG)(all,k,IMPVALUE)
    645       VALOWNIMPORT(i,q,k) = VALIMPORTS(i,q,q,k);
    646    
    647   Coefficient (all,i,TRAD_COMM)(all,q,REG)(all,j,MKTVALUE)
    648       CIFOWNDECOMP(i,q,j) # Value of tradables from q to q #;
    649   Formula (all,i,TRAD_COMM)(all,q,REG)(all,j,MKTVALUE)
    650       CIFOWNDECOMP(i,q,j)= CIFDECOMP(i,q,q,j);
    651    
    652   Write VALOWNEXPORT to file GTAPVIEW header "BX01" longname
    653       "Decomposition of exports to own region at world prices: VXWD=VXMD+XTAX";
    654   Write VALOWNIMPORT to file GTAPVIEW header "BX02" longname
    655       "Decomposition of imports from self at market prices: VIMS=VIWS+MTAX";
    656   Write CIFOWNDECOMP to file GTAPVIEW header "BX03" longname
    657       "Decomposition of cif values of own region - CIFDECOMP";
    658    
    659    
    660    
    661    
    662   !<
    663       3. Commodities ( Comm x Reg )
    664       -----------------------------
    665   >!
    666   Write OUTDISP to file GTAPVIEW header "CM01" longname
    667       "Disposition of output - OUTDISP";
    668   Write DOMSALESDISP to file GTAPVIEW header "CM02" longname
    669       "Disposition of domestic goods - DOMSALESDISP";
    670   Write IMPSALESDISP to file GTAPVIEW header "CM03" longname
    671       "Disposition of imported goods - IMPSALESDISP";
    672   Write VALOUTPUT to file GTAPVIEW header "CM04" longname
    673       "Value of output at market prices:  VOM = VOA + OUTTAX ";
    674   Write SUFFICIENCY to file GTAPVIEW header "CM05" longname
    675       "Self-sufficiency or domestic share in total use - SUFFICIENCY";
    676    
    677   !<
    678       4. Sectors ( Comm x Reg )
    679       -------------------------
    680   >!
    681    
    682   Write NVFA to file GTAPVIEW header "SF01" longname
    683       "Cost structure of firms - VFA";
    684   Write NVPA to file GTAPVIEW header "SF02" longname
    685       "Cost structure of consumption - VPA";
    686   Write NVGA to file GTAPVIEW header "SF03" longname
    687       "Cost structure of government - VGA";
    688    
    689   !<
    690       --------------------------------
    691       Computation of Initial Tax Rates
    692       --------------------------------
    693    
    694       Calculate initial distortions as percent ad valorem rates
    695   >!
    696    
    697   Coefficient
    698       (all,i,NSAV_COMM)(all,r,REG)                   rTO(i,r);
    699       (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)  rTF(i,j,r);
    700       (all,i,TRAD_COMM)(all,h, HOU)(all,r,REG)      rTPD(i,h,r);
    701       (all,i,TRAD_COMM)(all,h, HOU)(all,r,REG)      rTPI(i,h,r);
    702       (all,i,TRAD_COMM)(all,r,REG)                  rTGD(i,r);
    703       (all,i,TRAD_COMM)(all,r,REG)                  rTGI(i,r);
    704       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG) rTFD(i,j,r);
    705       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG) rTFI(i,j,r);
    706       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)       rTXS(i,r,s);
    707       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)       rTMS(i,r,s);
    708    
    709   Zerodivide default 1;
    710   Formula
    711       (all,i,NSAV_COMM)(all,r,REG)
    712       rTO(i,r)    = 100*{[VOA(i,r)/VOM(i,r)]-1};
    713    
    714       (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    715       rTF(i,j,r)  = 100*{[VFA(i,j,r)/VFM(i,j,r)]-1};
    716    
    717       (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)
    718       rTPD(i,h,r)   =  100*{[VDPA(i,h,r)/VDPM(i,h,r)]-1};
    719    
    720       (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)
    721       rTPI(i,h,r)   = 100*{[VIPA(i,h,r)/VIPM(i,h,r)]-1};
    722    
    723       (all,i,TRAD_COMM)(all,r,REG)
    724       rTGD(i,r)   = 100*{[VDGA(i,r)/VDGM(i,r)]-1};
    725    
    726       (all,i,TRAD_COMM)(all,r,REG)
    727       rTGI(i,r)   = 100*{[VIGA(i,r)/VIGM(i,r)]-1};
    728    
    729       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    730       rTFD(i,j,r) = 100*{[VDFA(i,j,r)/VDFM(i,j,r)]-1};
    731    
    732       (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    733       rTFI(i,j,r) = 100*{[VIFA(i,j,r)/VIFM(i,j,r)]-1};
    734    
    735       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    736       rTXS(i,r,s) = 100*{[VXMD(i,r,s)/VXWD(i,r,s)]-1};
    737    
    738       (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    739       rTMS(i,r,s) = 100*{[VIMS(i,r,s)/VIWS(i,r,s)]-1};
    740    
    741   Zerodivide off;
    742    
    743   Write
    744       rTO to file TAXRATES header "rTO " longname
    745       "% ad valorem rate, output (or income) subsidies in region r";
    746       rTF to file TAXRATES header "rTF " longname
    747       "% ad valorem rate, taxes on primary factors";
    748       rTPD to file TAXRATES header "rTPD" longname
    749       "% ad valorem rate, private domestic consumption taxes";
    750       rTPI to file TAXRATES header "rTPI" longname
    751       "% ad valorem rate, private import consumption taxes";
    752       rTGD to file TAXRATES header "rTGD" longname
    753       "% ad valorem rate, government domestic purchases taxes";
    754       rTGI to file TAXRATES header "rTGI" longname
    755       "% ad valorem rate, government import purchases taxes";
    756       rTFD to file TAXRATES header "rTFD" longname
    757       "% ad valorem rate, taxes on firms' domestic purchases";
    758       rTFI to file TAXRATES header "rTFI" longname
    759       "% ad valorem rate, taxes on firms' imports purchases";
    760       rTXS to file TAXRATES header "rTXS" longname
    761       "% ad valorem rate, export subsidies, by destination";
    762       rTMS to file TAXRATES header "rTMS" longname
    763       "% ad valorem rate, import taxes, by source";
    764    
    765   !<
    766       -------------------------------
    767       Checking the balance conditions
    768       -------------------------------
    769   >!
    770    
    771   Coefficient (all,i,TRAD_COMM)(all,s,REG)
    772       CHKMKTCLIMP(i,s)
    773       # Checking the accounting on traded commodities supply and demand #;
    774   Formula  (all,i,TRAD_COMM)(all,s,REG)
    775       CHKMKTCLIMP(i,s)
    776           = sum{r,REG, VIMS(i,r,s)}
    777           - sum{j,PROD_COMM, VIFM(i,j,s)}
    778           - sum{h,HOU,VIPM(i,h,s)} - VIGM(i,s);
    779    
    780   Coefficient (all,s,REG)
    781       SURPLUS(s)
    782       # Economic surplus in region s.  This should be close to zero. #;
    783   Formula (all,r,REG)
    784       SURPLUS(r)
    785           = sum{i,ENDW_COMM, VOA(i,r)} - sum{h, HOU, VDEP(h,r)}
    786           + sum{h, hou, FYI_HHLD(h,r)-FYO_HHLD(h,r)}
    787           + sum{h, hou, REMIN_HHLD(h,r)-REMOUT_HHLD(h,r)}
    788           + sum{k, Hou, sum{h,hou,TRANS_HHLD(h,k,r) - TRANS_HHLD(k,h,r)}}
    789           +     GRANTSIN(r) - GRANTSOUT(r)
    790           + sum{i,NSAV_COMM, VOM(i,r) - VOA(i,r)}
    791           + sum{j,PROD_COMM, sum{i,ENDW_COMM, VFA(i,j,r) - VFM(i,j,r)}}
    792           + sum{i,TRAD_COMM, sum{h,HOU,       VIPA(i,h,r) - VIPM(i,h,r)}}
    793           + sum{i,TRAD_COMM, sum{h,HOU,       VDPA(i,h,r) - VDPM(i,h,r)}}
    794           + sum{i,TRAD_COMM, VIGA(i,r) - VIGM(i,r)}
    795           + sum{i,TRAD_COMM, VDGA(i,r) - VDGM(i,r)}
    796           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VIFA(i,j,r) - VIFM(i,j,r)}}
    797           + sum{j,PROD_COMM, sum{i,TRAD_COMM, VDFA(i,j,r) - VDFM(i,j,r)}}
    798           + sum{i,TRAD_COMM, sum{s,REG, VXWD(i,r,s) - VXMD(i,r,s)}}
    799           + sum{i,TRAD_COMM, sum{s,REG, VIMS(i,s,r) - VIWS(i,s,r)}}
    800           - sum{i,TRAD_COMM, sum{h, HOU, VPA(i,r,h)} + VGA(i,r)} - save(r);
    801    
    802   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    803       VTWR_M(i,r,s)
    804       # Value of transport services associated w/ the shipment of i from r to s #;
    805   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    806       VTWR_M(i,r,s) = VIWS(i,r,s) - VXWD(i,r,s);
    807    
    808   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    809       CHKTRANS_D(i,r,s)
    810       # Difference between global demand and margins, should be close to zero #;
    811   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    812       CHKTRANS_D(i,r,s) = VTWR_M(i,r,s) - sum{m, MARG_COMM, VTWR(m,i,r,s)};
    813    
    814   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    815       VSTT(i,r) #For check on tranport services and margines #;
    816   Formula (all,i,TRAD_COMM)(all,r,REG)
    817       VSTT(i,r) = 0;
    818   Formula (all,i,MARG_COMM)(all,r,REG)
    819       VSTT(i,r) = VST(i,r);
    820    
    821   Coefficient
    822       CHKTRANS_S
    823   #Diff btwn ttl supply of trnsprt srvcs & ttl margins, should be close to zero#;
    824   Formula
    825       CHKTRANS_S
    826           = sum{m,MARG_COMM,sum{i,TRAD_COMM,sum{r,REG,sum{s,REG, VTWR(m,i,r,s)}}}}
    827           - sum{i,TRAD_COMM,sum{r,REG, VSTT(i,r)}};
    828    
    829   Coefficient (all,i,ENDW_COMM)(all,r,REG)
    830       CHKVOM(i,r) # Check on VOM = VFM #;
    831   Formula (all,i,ENDW_COMM)(all,r,REG)
    832       CHKVOM(i,r) = (VOM(i,r) - sum(h, HOU, EVOM(i,h,r))) ;
    833    
    834   !<
    835       ------------------------------------------
    836       Calculating Summary Measures for Imbalance
    837       ------------------------------------------
    838    
    839       For each GTAPDATA calculate a summary measure of imbalance, the sum of
    840       the absolute magnitudes of the imbalances in components.  Calculate an
    841       overall summary measure, the sum of the variable-specific summary
    842       measures.
    843   >!
    844    
    845   Coefficient
    846       SUMTRANS_S
    847       # Summary measure for transport services, should be close to zero #;
    848   Formula
    849       SUMTRANS_S = abs(CHKTRANS_S);
    850    
    851   Coefficient
    852       SUMTRANS_D
    853       # Summary measure for transport services, should be close to zero #;
    854   Formula
    855       SUMTRANS_D
    856           = sum{i, TRAD_COMM, sum{r, REG, sum{s, REG, abs(CHKTRANS_D(i,r,s))}}};
    857    
    858   Coefficient
    859       SUMSURPLUS
    860       # Summary measure for economic surplus, should be close to zero #;
    861   Formula
    862       SUMSURPLUS = sum{r, REG, abs(SURPLUS(r))};
    863    
    864   Coefficient
    865       SUMMKTCLIMP
    866       # Summary measure for excess importation, should be close to zero #;
    867   Formula
    868       SUMMKTCLIMP = sum{i,TRAD_COMM, sum{s,REG, abs(CHKMKTCLIMP(i,s))}};
    869    
    870   Coefficient
    871       SUMIMBALS # Summary measure of imbalances, should be close to zero #;
    872   Formula
    873       SUMIMBALS
    874           = SUMTRANS_S + SUMTRANS_D + SUMSURPLUS + SUMMKTCLIMP ;
    875    
    876   !<
    877       -------------------------------------
    878       Writing Summary Measures of Imbalance
    879       -------------------------------------
    880   >!
    881    
    882   Write SUMIMBALS   to file GTAPVIEW header "0IMB";
    883   Write SUMTRANS_S  to file GTAPVIEW header "1TNS";
    884   Write SUMTRANS_D  to file GTAPVIEW header "1TND";
    885   Write SUMSURPLUS  to file GTAPVIEW header "1SRP";
    886   Write SUMMKTCLIMP to file GTAPVIEW header "1IMP";
    887   Write CHKTRANS_S  to file GTAPVIEW header "2TNS";
    888   Write CHKTRANS_D  to file GTAPVIEW header "2TND";
    889   Write SURPLUS     to file GTAPVIEW header "2SRP";
    890   Write CHKMKTCLIMP to file GTAPVIEW header "2IMP";
    891   Write CHKVOM to file GTAPVIEW header "CVOM";
    892    
