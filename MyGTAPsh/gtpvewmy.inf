   1024    
   1025   !Expenditure and Income!
   1026    
   1027   Coefficient (all,h,HOU) (all,r,REG)
   1028       INCOME_HHLD(h,r) # income, net of depreciation, by Household #;
   1029   Formula (all,r,REG)(all,h,HOU)
   1030       INCOME_HHLD(h,r) = sum{i,ENDW_COMM, EVOA(i,h, r)} - VDEP(h,r) +
   1031                TRANS_GOV(h,r) + FYI_HHLD(h,r) - FYO_HHLD(h,r) +
   1032                + REMIN_HHLD(h,r) - REMOUT_HHLD(h,r) +
   1033                sum(k, HOU, TRANS_HHLD(h,k,r) - TRANS_HHLD(k,h,r)) ;
   1034    
   1035   Coefficient  (all,r,REG)
   1036       INCOME_GOV(r) # Factor income, net of depreciation, by Household #;
   1037   Formula (all,r,REG)
   1038       INCOME_GOV(r) = NETAXES(r) + GRANTSIN(r) - GRANTSOUT(r) -
   1039                sum(h, HOU, TRANS_GOV(h,r));
   1040    
   1041   Coefficient (all,h,HOU) (all,r,REG)
   1042       PRIVEXP_HHLD(h,r) # income, net of depreciation, by Household #;
   1043   Formula (all,r,REG)(all,h,HOU)
   1044       PRIVEXP_HHLD(h,r) = sum(t, TRAD_COMM, VIPA(t,h,r) + VDPA(t,h,r)) ;
   1045    
   1046   set TAB_INC (Income, ForIncome, Transfers, Expenditure, Saving) ;
   1047    
   1048   Coefficient (all,t,TAB_INC)(all,h,HOU) (all,r,REG)
   1049       TABLE_HHLD(t,h,r) # table of incomes, expenditure and saving by household #;
   1050   Formula (all,h,HOU) (all,r,REG)
   1051       TABLE_HHLD("Income",h,r) = sum{i,ENDW_COMM, EVOA(i,h, r)} - VDEP(h,r)  ;
   1052   Formula (all,h,HOU) (all,r,REG)
   1053       TABLE_HHLD("ForIncome",h,r) = FYI_HHLD(h,r) - FYO_HHLD(h,r) +
   1054                + REMIN_HHLD(h,r) - REMOUT_HHLD(h,r) ;
   1055   Formula (all,h,HOU) (all,r,REG)
   1056       TABLE_HHLD("Transfers",h,r) = TRANS_GOV(h,r)
   1057                + sum(k, HOU, TRANS_HHLD(h,k,r) - TRANS_HHLD(k,h,r)) ;
   1058   Formula (all,h,HOU) (all,r,REG)
   1059       TABLE_HHLD("Expenditure",h,r) = -1*PRIVEXP_HHLD(h,r) ;
   1060   Formula (all,h,HOU) (all,r,REG)
   1061       TABLE_HHLD("Saving",h,r) = -1*SAV_HHLD(h,r) ;
   1062    
   1063   Coefficient (all,t,TAB_INC) (all,r,REG)
   1064       TABLE_GOV(t,r) # table of incomes, expenditure and saving by household #;
   1065   Formula (all,r,REG)
   1066       TABLE_GOV("Income",r) = NETAXES(r)  ;
   1067   Formula (all,r,REG)
   1068       TABLE_GOV("ForIncome",r) = GRANTSIN(r) - GRANTSOUT(r) ;
   1069   Formula (all,r,REG)
   1070       TABLE_GOV("Transfers",r) = - sum(h, HOU, TRANS_GOV(h,r));
   1071   Formula (all,r,REG)
   1072       TABLE_GOV("Expenditure",r) = -1*GOVEXP(r) ;
   1073   Formula (all,r,REG)
   1074       TABLE_GOV("Saving",r) = -1*SAV_GOV(r) ;
   1075    
   1076   Coefficient (all,h,HOU)(all,r,REG)
   1077       CHKSAV_HHLD(h,r) # check on savings #;
   1078   Formula (all,h,HOU)(all,r,REG)
   1079       CHKSAV_HHLD(h,r) = INCOME_HHLD(h,r) - PRIVEXP_HHLD(h,r)
   1080                  - SAV_HHLD(h,r)  ;
   1081    
   1082   Coefficient (all,r,REG)
   1083       CHKSAV_GOV(r) # check on savings #;
   1084   Formula (all,r,REG)
   1085       CHKSAV_GOV(r) = INCOME_GOV(r) - GOVEXP(r)
   1086                  - SAV_GOV(r)  ;
   1087    
   1088   write
   1089       TABLE_HHLD to file GTAPVIEW header "HHLD" longname
   1090       "Household income - Expenditure plus savings";
   1091       TABLE_GOV to file GTAPVIEW header "GOV" longname
   1092       "Government income - Expenditure plus savings";
   1093       CHKSAV_HHLD to file GTAPVIEW header "CSVH" longname
   1094       "Check household savings";
   1095       CHKSAV_GOV to file GTAPVIEW header "CSVG" longname
   1096       "Check government savings";
   1097    
   1098   !<
   1099       ------------------------
   1100       End of GTAPVIEW.TAB file
   1101       ------------------------
   1102   >!
   1103    




