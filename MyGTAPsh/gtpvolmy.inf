      1   !___________________________GTAPVOL.TAB FILE__________________________________!
      2   !                                                                             !
      3   !                        Global Trade Analysis Project                        !
      4   !                         The GTAP Modeling Framework                         !
      5   !                  Computing Volume Changes from Results                      !
      6   !                                 1994 Model                                  !
      7   !                           Version 3, November 1997                          !
      8   ! To be used with results produced using Version 3, Nov. 1997 of GTAP.TAB     !
      9   !_____________________________________________________________________________!
     10    
     11   !-----------------------------------------------------------------------------!
     12   ! HISTORY of GTAPVOL.TAB                                                      !
     13   !-----------------------------------------------------------------------------!
     14   ! Version 1    July 1994   (Used in GTAP Short Course, July-August 1994)
     15     Version 2    April 1995  (Drops variables for aggregated trade quantities:
     16                               qex(i,r) and qim(i,r). These may be computed
     17                               directly by summarizing volumes derived from
     18                               qxs(i,r,s) )
     19     Version 3    Nov 1997    (Allows for additional v.4 primary factors and
     20   			    writes HAR file for viewing with VIEWHAR. Display
     21   			    file is no longer used.
     22     Version 4    Sept 1998    Reduces sets to minimum necessary with new Union
     23                               operators.                                        !
     24    
     25   !-----------------------------------------------------------------------------!
     26   !                                    SETS                                     !
     27   !-----------------------------------------------------------------------------!
     28    
     29   !-----------------------------------------------------------------------------!
     30   ! Sets define relevant groupings of entities over which we will be performing
     31     operations in the model.  SUBSETS are defined in order to facilitate
     32     summation over only a portion of a given group, e.g. tradeable commodities. !
     33    
     34   !-----------------------------------------------------------------------------!
     35    
     36   FILE GTAPSETS # File with set specification #;
     37    
     38   SET HOU #Private Households#
     39         READ ELEMENTS FROM FILE gtapsets HEADER "HOU";  !mod pjm!
     40    
     41   SET REG # Regions in the model #
     42         READ ELEMENTS FROM FILE gtapsets HEADER "H1";
     43    
     44   SET TRAD_COMM # TRADED COMMODITIES #
     45         READ ELEMENTS FROM FILE gtapsets HEADER "H2";
     46    
     47   SET CGDS_COMM # CAPITAL GOODS Commodities #
     48         MAXIMUM SIZE 1  READ ELEMENTS FROM FILE gtapsets HEADER "H9";
     49    
     50   SET ENDW_COMM # ENDOWMENT COMMODITIES #
     51         READ ELEMENTS FROM FILE gtapsets HEADER "H6";
     52    
     53   SET ENDWC_COMM # Capital Endowment Commodity # (capital) ;
     54    
     55   SET PROD_COMM # PRODUCED COMMODITIES  # = TRAD_COMM UNION CGDS_COMM ;
     56    
     57   SET DEMD_COMM # DEMANDED COMMODITIES # = ENDW_COMM UNION TRAD_COMM  ;
     58    
     59   SET NSAV_COMM # NON-SAVINGS COMMODITIES # = DEMD_COMM UNION CGDS_COMM ;
     60    
     61   SUBSET PROD_COMM IS SUBSET OF NSAV_COMM ;
     62    
     63   SUBSET ENDWC_COMM IS SUBSET OF NSAV_COMM;
     64   Set
     65       MARG_COMM # margin commodities #
     66       Maximum size 10 read elements from file GTAPSETS header "MARG"; !mod jmh!
     67   Subset
     68       MARG_COMM is subset of TRAD_COMM;
     69   Set
     70       NMRG_COMM # non-margin commodities # = TRAD_COMM - MARG_COMM;
     71    
     72    
     73   !-----------------------------------------------------------------------------!
     74   !                                   FILES                                     !
     75   !-----------------------------------------------------------------------------!
     76    
     77   FILE        GTAPDATA # The file containing all base data. # ;
     78   FILE        GSLTOHAR # The file containing results.       # ;
     79    
     80   !-----------------------------------------------------------------------------!
     81   !                                 Data base                                   !
     82   !-----------------------------------------------------------------------------!
     83    
     84   !-----------------------------------------------------------------------------!
     85   !               base revenues and expenditures at market prices               !
     86   !-----------------------------------------------------------------------------!
     87    
     88   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            VXMD(i,r,s)
     89               ! exports of commodity i from region r to
     90               destination s valued at market prices
     91               (tradeables only)  ! ;
     92    
     93   COEFFICIENT (all,i,MARG_COMM)(all,r,REG)                       VST(i,r)
     94               ! exports of commodity i from region r for
     95               international transportation valued at market prices
     96               (tradeables only)  ! ;
     97    
     98   COEFFICIENT (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)      VFM(i,j,r)
     99               ! producer expenditure on i by industry j,
    100                 in region r, valued at market prices ! ;
    101    
    102   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      VDFM(i,j,r)
    103               ! purchases of domestic i r for use in j in region r ! ;
    104    
    105   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU) (all,r,REG)            VDPM(i,h,r)
    106               ! private household expenditure on domestic i in r ! ;  !mod pjm!
    107    
    108   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       VDGM(i,r)
    109               ! government household expenditure on domestic i in r ! ;
    110    
    111   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      VIFM(i,j,r)
    112               ! purchases of imports i for use in j in region r ! ;
    113    
    114   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)            VIPM(i,h,r)
    115               ! private household expenditure on i in r ! ;      !mod pjm!
    116    
    117   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       VIGM(i,r)
    118               ! gov't household expenditure on i in r ! ;
    119   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            VIWS(i,r,s)
    120               ! imports at world prices ! ;
    121    
    122   ! Now read in the base data.                                             !
    123    
    124   READ (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)                  VXMD(i,r,s)
    125                    FROM FILE GTAPDATA HEADER "VXMD" ;
    126    
    127   READ (all,i,MARG_COMM)(all,r,REG)                             VST(i,r)
    128               FROM FILE GTAPDATA HEADER "VST" ;
    129    
    130   READ (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)            VFM(i,j,r)
    131               FROM FILE GTAPDATA HEADER "VFM" ;
    132    
    133   READ (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)            VIFM(i,j,r)
    134               FROM FILE GTAPDATA HEADER "VIFM" ;
    135    
    136   READ (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)            VDFM(i,j,r)
    137               FROM FILE GTAPDATA HEADER "VDFM" ;
    138    
    139   READ (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)                   VIPM(i,h,r)
    140               FROM FILE GTAPDATA HEADER "VIPM" ;                  !mod pjm!
    141    
    142   READ (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)                     VDPM(i,h,r)
    143               FROM FILE GTAPDATA HEADER "VDPM" ;                  !mod pjm!
    144   Read (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)                     VIWS(i,r,s)
    145               FROM FILE GTAPDATA HEADER "VIWS";
    146    
    147   READ (all,i,TRAD_COMM)(all,r,REG)                             VIGM(i,r)
    148               FROM FILE GTAPDATA HEADER "VIGM" ;
    149    
    150   READ (all,i,TRAD_COMM)(all,r,REG)                             VDGM(i,r)
    151               FROM FILE GTAPDATA HEADER "VDGM" ;
    152    
    153   !-----------------------------------------------------------------------------!
    154   !                   DERIVATIVES OF THE BASE DATA                              !
    155   !-----------------------------------------------------------------------------!
    156    
    157   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                         VDM(i,r)
    158               ! domestic sales of commodity i in region r
    159                 valued at market prices (tradeables only)  ! ;
    160    
    161   FORMULA (all,i,TRAD_COMM)(all,r,REG)
    162           VDM(i,r) = sum{h, HOU, VDPM(i,h,r)} + VDGM(i,r)
    163                    + sum(j,PROD_COMM, VDFM(i,j,r)) ;      !mod pjm!
    164    
    165   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                         VXM(i,r)
    166               ! value of exports of commodity i in r
    167                 at domestic market prices ! ;
    168    
    169   FORMULA (all,i,TRAD_COMM)(all,r,REG)
    170            VXM(i,r) = sum(s,REG, VXMD(i,r,s)) ;
    171    
    172   COEFFICIENT (all,i,NSAV_COMM)(all,r,REG)                         VOM(i,r)
    173               ! value of commodity i output in region r. ! ;
    174    
    175   FORMULA (all,i,ENDW_COMM)(all,r,REG)
    176           VOM(i,r) = sum(j,PROD_COMM, VFM(i,j,r)) ;
    177    
    178   FORMULA (all,i,MARG_COMM)(all,r,REG)
    179           VOM(i,r) = VDM(i,r) + VXM(i,r) + VST(i,r) ;
    180    
    181   FORMULA (all,i,NMRG_COMM)(all,r,REG)
    182           VOM(i,r) = VDM(i,r) + VXM(i,r);
    183    
    184   ! but we don't worry about investment !
    185    
    186   FORMULA (all,h,CGDS_COMM)(all,r,REG)
    187           VOM(h,r) = 0 ;
    188    
    189    
    190   !-----------------------------------------------------------------------------!
    191   !                             Solution Variables                              !
    192   !-----------------------------------------------------------------------------!
    193    
    194   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            qxs(i,r,s)
    195               ! percentage change in exports of commodity i from region r to
    196               destination s ! ;
    197    
    198   COEFFICIENT (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)      qfe(i,j,r)
    199               ! percentage change in endowment demand i by industry j,
    200                 in region r ! ;
    201    
    202   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      qfd(i,j,r)
    203               ! p.c. in imports of i for use in j in region r ! ;
    204    
    205   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)             qpdh(i,h,r)
    206               ! p.c. in private household demand for imports of i in r ! ;
    207                                                                   !mod pjm!
    208    
    209   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       qgd(i,r)
    210               ! p.c. in gov't household demand for imports of i in r ! ;
    211    
    212    
    213   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       qds(i,r)
    214            # total domestic sales of commodity i in r # ;
    215    
    216   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      qfm(i,j,r)
    217               ! p.c. in imports of i for use in j in region r ! ;
    218    
    219   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)            qpmh(i,h,r)
    220               ! p.c. in private household demand for imports of i in r ! ;
    221                                                                  !mod pjm!
    222    
    223   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       qgm(i,r)
    224               ! p.c. in gov't household demand for imports of i in r ! ;
    225    
    226   COEFFICIENT (all,i,NSAV_COMM)(all,r,REG)                       qo(i,r)
    227               ! percentage change in output of i by in region r ! ;
    228    
    229    
    230   ! Now read in the solution variables                                       !
    231    
    232   READ     (all,i,NSAV_COMM)(all,r,REG)                       qo(i,r)
    233            from file gsltohar header "qo  "  ;
    234    
    235            (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            qxs(i,r,s)
    236            from file gsltohar header "qxs "  ;
    237    
    238            (all,i,TRAD_COMM)(all,r,REG)                       qds(i,r)
    239            from file gsltohar header "qds "  ;
    240    
    241            (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)      qfe(i,j,r)
    242            from file gsltohar header "qfe "  ;
    243    
    244            (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      qfm(i,j,r)
    245            from file gsltohar header "qfm "  ;
    246    
    247            (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      qfd(i,j,r)
    248            from file gsltohar header "qfd "  ;
    249    
    250            (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)            qpmh(i,h,r)
    251            from file gsltohar header "qpmh"  ;                !mod pjm!
    252    
    253            (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)            qpdh(i,h,r)
    254            from file gsltohar header "qpdh"  ;                !mod pjm!
    255    
    256            (all,i,TRAD_COMM)(all,r,REG)                       qgm(i,r)
    257            from file gsltohar header "qgm "  ;
    258    
    259            (all,i,TRAD_COMM)(all,r,REG)                       qgd(i,r)
    260            from file gsltohar header "qgd "  ;
    261    
    262    
    263   ! Next compute the relevant volume changes                                 !
    264    
    265   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            DQXS(i,r,s)
    266               ! change in volume of exports of commodity i from region r to
    267               destination s, evaluated at initial market prices ! ;
    268   FORMULA     (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    269               DQXS(i,r,s) = [qxs(i,r,s)/100] * VXMD(i,r,s) ;
    270    
    271   COEFFICIENT (all, i, TRAD_COMM)(all,r,REG)(all,s,REG)         DQWS(i,r,s)
    272              !change in volume of exports of commodity i from r to
    273               destination s, evaluated at world prices!;
    274   FORMULA     (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    275               DQWS(i,r,s) = [qxs(i,r,s)/100] * VIWS(i,r,s) ;
    276    
    277   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)                       DQDS(i,r)
    278               ! change in volume of domestic sales of commodity i
    279                in region r evaluated at initial market prices ! ;
    280   FORMULA     (all,i,TRAD_COMM)(all,r,REG)
    281            DQDS(i,r) = [qds(i,r)/100] * VDM(i,r) ;
    282    
    283   COEFFICIENT (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)       DQFE(i,j,r)
    284               ! change in volume of endowment commodity i in j of region r
    285               evaluated at initial market prices ! ;
    286   FORMULA     (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    287            DQFE(i,j,r) = [qfe(i,j,r)/100] * VFM(i,j,r) ;
    288    
    289   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)       DQFM(i,j,r)
    290               ! change in volume of imported, intermediate commodity i
    291                in j of region r evaluated at initial market prices ! ;
    292   FORMULA     (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    293            DQFM(i,j,r) = [qfm(i,j,r)/100] * VIFM(i,j,r) ;
    294    
    295   COEFFICIENT (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)       DQFD(i,j,r)
    296               ! change in volume of domestic use of intermediate commodity i
    297                in j of region r evaluated at initial market prices ! ;
    298   FORMULA     (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    299            DQFD(i,j,r) = [qfd(i,j,r)/100] * VDFM(i,j,r) ;
    300    
    301   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)             DQPM(i,h,r)
    302               ! change in volume of private hhld imported commodity i
    303                of region r evaluated at initial market prices ! ;
    304   FORMULA     (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)
    305            DQPM(i,h,r) = [qpmh(i,h,r)/100] * VIPM(i,h,r) ;         !mod pjm!
    306    
    307   COEFFICIENT (all,i,TRAD_COMM)(all,h,HOU)(all,r,REG)              DQPD(i,h,r)
    308               ! change in volume of private hhld domestic commodity i
    309                of region r evaluated at initial market prices ! ;
    310   FORMULA     (all,i,TRAD_COMM)(all,h,hou)(all,r,REG)
    311            DQPD(i,h,r) = [qpdh(i,h,r)/100] * VDPM(i,h,r) ;         !mod pjm!
    312    
    313   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)       DQGM(i,r)
    314               ! change in volume of government hhld imported commodity i
    315                of region r evaluated at initial market prices ! ;
    316   FORMULA     (all,i,TRAD_COMM)(all,r,REG)
    317            DQGM(i,r) = [qgm(i,r)/100] * VIGM(i,r) ;
    318    
    319   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)       DQGD(i,r)
    320               ! change in volume of government hhld imported commodity i
    321                of region r evaluated at initial market prices ! ;
    322   FORMULA     (all,i,TRAD_COMM)(all,r,REG)
    323            DQGD(i,r) = [qgd(i,r)/100] * VDGM(i,r) ;
    324    
    325   COEFFICIENT (all,i,TRAD_COMM)(all,r,REG)       DQO(i,r)
    326               ! change in volume of output of commodity i
    327                of region r evaluated at initial market prices ! ;
    328   FORMULA     (all,i,TRAD_COMM)(all,r,REG)
    329            DQO(i,r) = [qo(i,r)/100] * VOM(i,r) ;
    330    
    331   COEFFICIENT (all,r,REG)(all,s,REG)            DTOT(r,s)
    332               ! change in volume of total exports from region r to
    333               destination s, evaluated at initial market prices ! ;
    334   FORMULA     (all,r,REG)(all,s,REG)
    335            DTOT(r,s) = sum(i,TRAD_COMM, DQXS(i,r,s)) ;
    336    
    337   ! Note that by creating alternative subsets of traded commodities, you
    338     can also compute changes in the bilateral trade volume of, eg., food
    339     products.
    340    
    341    It is also sometimes handy to create new variables, for example, the volume
    342    of US exports of i to destination s, in order to obtain a 2 dimensional
    343    display file which can be used directly as a table.  !
    344    
    345   ! Now write the output of this program to a HAR file for easy viewing and
    346     summation. !
    347    
    348   FILE (New) OUTFILE # HAR file of volume changes # ;
    349    
    350   Write
    351   DQXS to file OUTFILE header "DQXS"
    352    longname "DVol, exports of i from r to s, I.M.P.";
    353   DQWS to file OUTFILE header "DQWS"
    354    longname "DVol, exports of i from r to s, World Prices";
    355   DQDS to file OUTFILE header "DQDS"
    356    longname "DVol, domestic sales of i in r, I.M.P.";
    357   DQFE to file OUTFILE header "DQFE"
    358    longname "DVol, endowment commodity i in ind j of r, I.M.P.";
    359   DQFM to file OUTFILE header "DQFM"
    360    longname "DVol, imported, intermediate commodity i in ind j of r, I.M.P.";
    361   DQFD to file OUTFILE header "DQFD"
    362    longname "DVol, domestic, intermediate commodity i in ind j of r, I.M.P.";
    363   DQPM to file OUTFILE header "DQPM"
    364    longname "DVol, private hhld imported commodity i of r, I.M.P.";
    365   DQPD to file OUTFILE header "DQPD"
    366    longname "DVol, private hhld domestic commodity i of r, I.M.P.";
    367   DTOT to file OUTFILE header "DTOT"
    368    longname "DVol, total exports from r to s, I.M.P.";
    369   DQO  to file OUTFILE header "DQO "
    370    longname "DVol, output of commodity i in r, I.M.P.";
    371   DQGD to file OUTFILE header "DQGD"
    372    longname "DVol, government hhld imported commodity i in r, I.M.P.";
    373   DQGM to file OUTFILE header "DQGM"
    374    longname "DVol, government hhld imported commodity i in r, I.M.P.";
    375    
    376    
    377   !___________________End of TABLO File GTAPVOL.TAB_____________________________!
    378    




