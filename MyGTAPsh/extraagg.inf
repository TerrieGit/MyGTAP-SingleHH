      1   ![[!
      2       ==========================================
      3       ImpactECON MyGTAP Model auxillary programs
      4       May 2016
      5    
      6       This program aggregates extra data countries to regions for MyGTAP model
      7    
      8       ImpactECON LLC, Boulder, Colorado
      9       https://impactecon.com/
     10    
     11       ==========================================
     12    
     13   Purpose of program:
     14   1. Produce MGTAP database for RunGTAP application with single household.
     15    
     16   Author: Peter Minor and Terrie L walmsley
     17   Date: June 2 2015
     18    
     19   !]]!
     20    
     21   file
     22       SSFILE #standard sets#;
     23    
     24   set
     25       REG #regions#
     26       read elements from file SSFILE header "H1";
     27   set
     28       CTRY #countries#
     29       read elements from file SSFILE header "DH1";
     30    
     31   mapping
     32       C2R from CTRY to REG;
     33   read (by_elements)
     34       C2R from file SSFILE header "MREG";
     35    
     36   file
     37       INFILE #foreign income data, by country#;
     38    
     39   file (new)
     40       OUTFILE #foreign income#;
     41    
     42   coefficient (all,c,CTRY)
     43       AIDIN(c) #foreign income receipts, by country#;
     44   read
     45       AIDIN from file INFILE header "AIDI";
     46    
     47   coefficient (all,c,CTRY)
     48       AIDOUT(c) #foreign income receipts, by country#;
     49   read
     50       AIDOUT from file INFILE header "AIDO";
     51    
     52   coefficient (all,c,CTRY)
     53       FYIN(c) #foreign income receipts, by country#;
     54   read
     55       FYIN from file INFILE header "FYI";
     56    
     57   coefficient (all,c,CTRY)
     58       FYOUT(c) #foreign income receipts, by country#;
     59   read
     60       FYOUT from file INFILE header "FYO";
     61    
     62   coefficient (all,c,CTRY)
     63       REMIN(c) #foreign income receipts, by country#;
     64   read
     65       REMIN from file INFILE header "REMI";
     66    
     67   coefficient (all,c,CTRY)
     68       REMOUT(c) #foreign income receipts, by country#;
     69   read
     70       REMOUT from file INFILE header "REMO";
     71    
     72   coefficient (all,c,CTRY)
     73       TRANG(c) #foreign income receipts, by country#;
     74   read
     75       TRANG from file INFILE header "TRNG";
     76    
     77   coefficient (all,r,REG)
     78       AIDIN_NEW(r) #foreign income receipts, by country#;
     79   formula (all,r,REG)
     80       AIDIN_NEW(r) = sum{c, CTRY: C2R(c) = r, AIDIN(c)};
     81    
     82   coefficient (all,r,REG)
     83       AIDOUT_NEW(r) #foreign income receipts, by country#;
     84   formula (all,r,REG)
     85       AIDOUT_NEW(r) = sum{c, CTRY: C2R(c) = r, AIDOUT(c)};
     86    
     87   coefficient (all,r,REG)
     88       FYIN_NEW(r) #foreign income receipts, by country#;
     89   formula (all,r,REG)
     90       FYIN_NEW(r) = sum{c, CTRY: C2R(c) = r, FYIN(c)};
     91    
     92   coefficient (all,r,REG)
     93       FYOUT_NEW(r) #foreign income receipts, by country#;
     94   formula (all,r,REG)
     95       FYOUT_NEW(r) = sum{c, CTRY: C2R(c) = r, FYOUT(c)};
     96    
     97   coefficient (all,r,REG)
     98       REMIN_NEW(r) #foreign income receipts, by country#;
     99   formula (all,r,REG)
    100       REMIN_NEW(r) = sum{c, CTRY: C2R(c) = r, REMIN(c)};
    101    
    102   coefficient (all,r,REG)
    103       REMOUT_NEW(r) #foreign income receipts, by country#;
    104   formula (all,r,REG)
    105       REMOUT_NEW(r) = sum{c, CTRY: C2R(c) = r, REMOUT(c)};
    106    
    107   coefficient (all,r,REG)
    108       TRANG_NEW(r) #foreign income receipts, by country#;
    109   formula (all,r,REG)
    110       TRANG_NEW(r) = sum{c, CTRY: C2R(c) = r, TRANG(c)};
    111    
    112   write
    113       AIDIN_NEW to file OUTFILE header "AIDI" ;
    114       AIDOUT_NEW to file OUTFILE header "AIDO" ;
    115       FYIN_NEW to file OUTFILE header "FYI" ;
    116       FYOUT_NEW to file OUTFILE header "FYO" ;
    117       REMIN_NEW to file OUTFILE header "REMI" ;
    118       REMOUT_NEW to file OUTFILE header "REMO" ;
    119       TRANG_NEW to file OUTFILE header "TRNG" ;
    120    
    121   transfer unread from file INFILE to file OUTFILE ;
    122    
    123    




