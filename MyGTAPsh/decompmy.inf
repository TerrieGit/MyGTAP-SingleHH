     12    
     13   Adapted from:
     14    
     15       GTAP DECOMP.tab file by Tom Hertel and Wusheng Yu
     16    
     17       Purpose: TAB file for displaying interesting welfare decomposition results via
     18       viewhar
     19    
     20       -------------------
     21       History of the File
     22       -------------------
     23    
     24       April 2016: revised by Terrie Walmsley for MyGTAP
     25       September 2003: revised by Robert McDougall
     26           - extended CNTalldemd from TRAD_COMM to DEMD_COMM
     27           - new longnames
     28           - module structure cleanups
     29           - format cleanups
     30       May 2000: revised by Ken Itakura
     31           - added MARG_COMM and NMRG_COMM as in the version 5 of GTAP
     32           - added Module structure
     33           - added decomposition feature for I-S components
     34       January 2000: revised by Tom Hertel
     35           - changed trade volume definition to correspond to GTAP TAB file
     36             (VXMD)
     37           - removed endowment commodities from A2
     38           - added full decomposition of endowment commodity tax effects (A3)
     39           - added depreciation contribution to decomposition
     40           - added contribution import-augmenting technical change
     41           - removed non-homotheticity effect which is now subsumed in scale
     42             factor
     43           - fixed transport and terms of trade effects to correspond to the new
     44             TAB file
     45           - changed denominator for output and export taxes so that correspond
     46             to same rates used elsewhere in GTAP
     47           - added term for impact of change in preferences on EV
     48       September 1998:
     49           - added missing terms to the header for decomposition by tax type and
     50             eliminated unnecessary sets.
     51       June 1998:
     52           - revised sets to fit with the GTAP.TAB file.
     53           - added further resolution for the non-trade taxes.
     54       December 1997: revised for the South Africa short course
     55           - fixed a problem in the way trade volumes were computed
     56       Summer 1997: revised for the 1997 GTAP short course
     57       Early 1997: Inception
     58    
     59    
     60       ------------------------------------
     61       Overview of the DECOMP.TAB Structure
     62       ------------------------------------
     63    
     64       FILES
     65       SETS
     66       READS for Common Coefficients
     67       Modules
     68   >!
     69    
     70    
     71   !<
     72       -----
     73       FILES
     74       -----
     75   >!
     76    
     77   File
     78       GTAPSETS # file with set specification #;
     79   File
     80       GTAPSOL # file containing all solution variables #;
     81   File
     82       GTAPBASE # file containing all base data #;
     83   File
     84       GTAPUPDATE # file containing all updated base data #;
     85   File (new)
     86       WELVIEW # file containing welfare decompositions #;
     87    
     88    
     89   !<
     90       ----
     91       SETS
     92       ----
     93   >!
     94    
     95   Set
     96       REG # regions in the model #
     97       maximum size 10 read elements from file GTAPSETS header "H1";
     98   Set
     99       HHLD # Households in the model #
    100       maximum size 10 read elements from file GTAPSETS header "HOU";
    101   Set
    102       TRAD_COMM # traded commodities #
    103       maximum size 10 read elements from file GTAPSETS header "H2";
    104   Set
    105       MARG_COMM # margin commodities #
    106       maximum size 10 read elements from file GTAPSETS header "MARG";
    107   Subset
    108       MARG_COMM is subset of TRAD_COMM;
    109   Set
    110       NMRG_COMM # non-margin commodities # = TRAD_COMM - MARG_COMM;
    111   Set
    112       CGDS_COMM # capital goods commodities #
    113       maximum size 1 read elements from file GTAPSETS header "H9";
    114   Set
    115       ENDW_COMM # endowment commodities #
    116       maximum size 5 read elements from file GTAPSETS header "H6";
    117   Set
    118       ENDWC_COMM # capital endowment commodity # (capital);
    119   Set
    120       PROD_COMM # produced commodities # = TRAD_COMM UNION CGDS_COMM;
    121   Set
    122       DEMD_COMM # demanded commodities # = ENDW_COMM UNION TRAD_COMM;
    123   Set
    124       NSAV_COMM # non-savings commodities # = DEMD_COMM UNION CGDS_COMM;
    125   Subset
    126       PROD_COMM is subset of NSAV_COMM;
    127   Subset
    128       ENDWC_COMM is subset of NSAV_COMM;
    129    
    130    
    131   !<
    132       The followings are new sets for DECOMP.TAB.  Supplementary sets for
    133       "toggles" in VIEWHAR.
    134   >!
    135    
    136   Set
    137       CTAX(pfacttax,prodtax,inputtax,contax,govtax,xtax,mtax);
    138   Set
    139       TYPE(xtax,mtax);
    140   Subset
    141       TYPE is subset of CTAX;
    142   Set
    143       COLUMN(alloc_A1,endw_B1,tech_C1,pop_D1,tot_E1,IS_F1,pref_G1,finc_H1);
    144   Set
    145       TECHTYPE(output,primfac,v_added,ininput,transp,import);
    146   Set
    147       PRICES(pworld,pexport,pimport);
    148   Set
    149       DIR(imported,domestic);
    150   Set
    151       ACTIVITY(firm, private, govt);
    152   Set
    153       COL(welcnt, dvol, taxrateb, taxrateu);
    154   Set
    155       DIREC(import,export);
    156   Set
    157       FORM(percent,value);
    158   Set
    159       COLM(ISbal,p_cgds,p_save);
    160   Set
    161       FORINC(fky,rem,aid);
    162    
    163    
    164   !<
    165       -----------------------------
    166       READS for Common Coefficients
    167       -----------------------------
    168    
    169       Note: A common coefficient is the one used across several modules.
    170   >!
    171    
    172   Coefficient (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    173       BEVOA(i,h,r) # value of output at agent's prices #;
    174   Read
    175       BEVOA from file GTAPBASE header "EVOA";
    176   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    177       BEVFA(i,j,r) # producer expenditure on i by industry j #;
    178   Read
    179       BEVFA from file GTAPBASE header "EVFA";
    180   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    181       BVIFA(i,j,r) # purchases of imported i r for use in j in region r #;
    182   Read
    183       BVIFA from file GTAPBASE header "VIFA";
    184   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    185       BVDFA(i,j,r) # purchases of domestic i r for use in j in region r #;
    186   Read
    187       BVDFA from file GTAPBASE header "VDFA";
    188    
    189   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    190       BVOA(i,r) # value of commodity i output in region r #;
    191   Formula (all,i,ENDW_COMM)(all,r,REG)
    192       BVOA(i,r) = sum(h, HHLD, BEVOA(i,h,r)) ;
    193   Formula (all,i,PROD_COMM)(all,r,REG)
    194       BVOA(i,r)
    195           = sum(j,ENDW_COMM, BEVFA(j,i,r))
    196           + sum(j,TRAD_COMM, BVIFA(j,i,r) + BVDFA(j,i,r));
    197    
    198    
    199   !<
    200       =======
    201       Modules
    202       =======
    203    
    204       A:  EV Decomposition: Summary
    205       A1: Allocative Efficiency Effect: Commodity Summary
    206       A2: Allocative Efficiency Effect: Tax Type Summary
    207       AX: Decomposition of Allocative Effect, by Tax Type and Commodity
    208       B1: Endowment Effect, Gross of Depreciation
    209       B2: Endowment Effect: Depreciation
    210       C1: Technical Change Effect
    211       D1: Population Effect
    212       E1: Terms of Trade Effect
    213       F1: I-S Effect: Explanatory Factors
    214   >!
    215    
    216    
    217   !<
    218       -----------------------------
    219       A:  EV Decomposition: Summary
    220       -----------------------------
    221   >!
    222    
    223   Coefficient (all,r,REG)
    224       CNTalleffr(r)
    225       # total contribution to regional EV of allocative effects #;
    226   Read
    227       CNTalleffr from file GTAPSOL header "ALLR";
    228    
    229   Coefficient (all,r,REG)
    230       CNTendwr(r)
    231       # contribution to regional EV of changes in all ENDW_COMM #;
    232   Read
    233       CNTendwr from file GTAPSOL header "ENDR";
    234    
    235   Coefficient (all,r,REG)
    236       CNTtechr(r)
    237       # contribution to regional EV of all technical change #;
    238   Read
    239       CNTtechr from file GTAPSOL header "TECR";
    240    
    241   Coefficient (all,r,REG)
    242       CNTpopr(r)
    243       # contribution to regional EV of all technical change #;
    244   Read
    245       CNTpopr from file GTAPSOL header "POPR";
    246    
    247   Coefficient (all,r,REG)
    248       CNTtotr(r)
    249       # contribution to regional EV of changes in its terms of trade #;
    250   Read
    251       CNTtotr from file GTAPSOL header "TOTR";
    252    
    253   Coefficient (all,r,REG)
    254       CNTcgdsr(r)
    255       # contribution to regional EV of changes in the price of cgds #;
    256   Read
    257       CNTcgdsr from file GTAPSOL header "CGDS";
    258    
    259   Coefficient (all,r,REG)
    260       CNTdpar(r)
    261       # contribution to regional EV of changes in preferences #;
    262   Read
    263       CNTdpar from file GTAPSOL header "DPAR";
    264    
    265   Coefficient (all,r,REG)
    266       CNTfyr(r)
    267       # contribution to regional EV of all technical change #;
    268   Read
    269       CNTfyr from file GTAPSOL header "FY";
    270    
    271   Coefficient (all,r,REG)
    272       CNTfkyr(r)
    273       # contribution to regional EV of all technical change #;
    274   Read
    275       CNTfkyr from file GTAPSOL header "FKY";
    276    
    277   Coefficient (all,r,REG)
    278       CNTremr(r)
    279       # contribution to regional EV of all technical change #;
    280   Read
    281       CNTremr from file GTAPSOL header "REM";
    282    
    283   Coefficient (all,r,REG)
    284       CNTaidr(r)
    285       # contribution to regional EV of all technical change #;
    286   Read
    287       CNTaidr from file GTAPSOL header "AID";
    288    
    289   Coefficient (all,r,REG)(all,j,COLUMN)
    290       WELFARE(r,j) # aggregate report of welfare change #;
    291   Formula (all,r,REG)
    292       WELFARE(r,"alloc_A1") = CNTalleffr(r);
    293   Formula (all,r,REG)
    294       WELFARE(r,"endw_B1") = CNTendwr(r);
    295   Formula (all,r,REG)
    296       WELFARE(r,"tech_C1") = CNTtechr(r);
    297   Formula (all,r,REG)
    298       WELFARE(r,"pop_D1") = CNTpopr(r);
    299   Formula (all,r,REG)
    300       WELFARE(r,"tot_E1") = CNTtotr(r);
    301   Formula (all,r,REG)
    302       WELFARE(r,"IS_F1") = CNTcgdsr(r);
    303   Formula (all,r,REG)
    304       WELFARE(r,"PREF_G1") = CNTdpar(r);
    305   Formula (all,r,REG)
    306       WELFARE(r,"finc_H1") = CNTfyr(r) ;
    307    
    308   Write
    309       WELFARE to file WELVIEW header "A"
    310       longname "EV Decomposition: Summary";
    311    
    312    
    313   !<
    314       ---------------------------------------------------
    315       A1: Allocative Efficiency Effect: Commodity Summary
    316       ---------------------------------------------------
    317   >!
    318    
    319   Coefficient (all,i,DEMD_COMM)(all,r,REG)
    320       CNTalleffir(i,r)
    321       # total contribution to regional EV of allocative effects of i in r #;
    322   Read
    323       CNTalleffir from file GTAPSOL header "AEFI";
    324    
    325   Coefficient (all,r,REG)(all,i,DEMD_COMM)
    326       CNTalldemd(r,i) # transpose of CNTalleffir(i,r) #;
    327   Formula (all,r,REG)(all,i,DEMD_COMM)
    328       CNTalldemd(r,i) = CNTalleffir(i,r);
    329    
    330   Write
    331       CNTalldemd to file WELVIEW header "A1"
    332       longname "Allocative Efficiency Effect: Commodity Summary";
    333    
    334    
    335   !<
    336       --------------------------------------------------
    337       A2: Allocative Efficiency Effect: Tax Type Summary
    338       --------------------------------------------------
    339   >!
    340    
    341   Coefficient (all,r,REG)
    342       CNTqor(r)
    343       # contribution to WEV of changes in output of all NSAV_COMM from r #;
    344   Read
    345       CNTqor from file GTAPSOL header "QOR";
    346    
    347   Coefficient (all,r,REG)
    348       CNTqfer(r)
    349       # contribution to WEV of changes in use of all ENDW_COMM in all j in r #;
    350   Read
    351       CNTqfer from file GTAPSOL header "QFER";
    352    
    353   Coefficient (all,r,REG)
    354       CNTqfmr(r)
    355       # contribution to WEV of changes in use of imported int. in all j in r #;
    356   Read
    357       CNTqfmr from file GTAPSOL header "QFMR";
    358   Coefficient (all,r,REG)
    359       CNTqfdr(r)
    360       # contribution to WEV of changes in use of domestic int. in all j in r #;
    361   Read
    362       CNTqfdr from file GTAPSOL header "QFDR";
    363   Coefficient (all,r,REG)
    364       CNTallir(r);
    365   Formula (all,r,REG)
    366       CNTallir(r) = CNTqfmr(r) + CNTqfdr(r);
    367    
    368   Coefficient (all,r,REG)
    369       CNTqpmr(r)
    370       # contribution to WEV of changes in consumption of imported goods in r #;
    371   Read
    372       CNTqpmr from file GTAPSOL header "QPMR";
    373   Coefficient (all,r,REG)
    374       CNTqpdr(r)
    375       # contribution to WEV of changes in consumption of domestic goods in r #;
    376   Read
    377       CNTqpdr from file GTAPSOL header "QPDR";
    378   Coefficient (all,r,REG)
    379       CNTallpr(r);
    380   Formula (all,r,REG)
    381       CNTallpr(r) = CNTqpmr(r) + CNTqpdr(r);
    382    
    383   Coefficient (all,r,REG)
    384       CNTqgmr(r)
    385       # contribution to WEV of changes in gov't consumption of imports in r #;
    386   Read
    387       CNTqgmr from file GTAPSOL header "QGMR";
    388   Coefficient (all,r,REG)
    389       CNTqgdr(r)
    390       # contrib. to WEV of changes in gov't consumption of domestics in r #;
    391   Read
    392       CNTqgdr from file GTAPSOL header "QGDR";
    393   Coefficient (all,r,REG)
    394       CNTallgr(r);
    395   Formula (all,r,REG)
    396       CNTallgr(r) = CNTqgmr(r) + CNTqgdr(r);
    397    
    398   Coefficient (all,r,REG)
    399       CNTqxsr(r)
    400       # cont. to WEV of changes in exports of all goods from srce r to all dest #;
    401   Read
    402       CNTqxsr from file GTAPSOL header "QXSR";
    403    
    404   Coefficient (all,r,REG)
    405       CNTqimr(r)
    406       # cont. to WEV of changes in imports of all goods from all srce to dest r #;
    407   Read
    408       CNTqimr from file GTAPSOL header "QIMR";
    409    
    410   Coefficient (all,r,REG)(all,k,CTAX)
    411       CNTalleffkr(r,k);
    412   Formula (all,r,REG)
    413       CNTalleffkr(r,"pfacttax") = CNTqfer(r);
    414   Formula (all,r,REG)
    415       CNTalleffkr(r,"prodtax") = CNTqor(r);
    416   Formula (all,r,REG)
    417       CNTalleffkr(r,"inputtax") = CNTallir(r);
    418   Formula (all,r,REG)
    419       CNTalleffkr(r,"contax") = CNTallpr(r);
    420   Formula (all,r,REG)
    421       CNTalleffkr(r,"govtax") = CNTallgr(r);
    422   Formula (all,r,REG)
    423       CNTalleffkr(r,"xtax") = CNTqxsr(r);
    424   Formula (all,r,REG)
    425       CNTalleffkr(r,"mtax") = CNTqimr(r);
    426    
    427   Write
    428       CNTalleffkr to file WELVIEW header "A2"
    429       longname "Allocative Efficiency Effect: Tax Type Summary";
    430    
    431    
    432   !<
    433       -----------------------------------------------------------------
    434       AX: Decomposition of Allocative Effect, by Tax Type and Commodity
    435       -----------------------------------------------------------------
    436    
    437       AX0:  Preliminaries
    438       A21:  Output Tax Effect
    439       A22:  Domestic Tax Effect
    440       A23:  Trade Tax Effect
    441       A3:   Endowment Tax Effect
    442   >!
    443    
    444    
    445   !<
    446       AX0:  Preliminaries
    447       -------------------
    448   >!
    449    
    450   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    451       BVDPM(i,h,r) # private household expenditure on domestic i in r #;
    452   Read
    453       BVDPM from file GTAPBASE header "VDPM";
    454   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    455       BVDGM(i,r) # government household expenditure on domestic i in r #;
    456   Read
    457       BVDGM from file GTAPBASE header "VDGM";
    458   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    459       BVDFM(i,j,r) # purchases of domestic i r for use in j in region r #;
    460   Read
    461       BVDFM from file GTAPBASE header "VDFM";
    462   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    463       UVDPM(i,h,r) # private household expenditure on domestic i in r #;
    464   Read
    465       UVDPM from file GTAPUPDATE header "VDPM";
    466   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    467       UVDGM(i,r) # government household expenditure on domestic i in r #;
    468   Read
    469       UVDGM from file GTAPUPDATE header "VDGM";
    470   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    471       UVDFM(i,j,r) # purchases of domestic i r for use in j in region r #;
    472   Read
    473       UVDFM from file GTAPUPDATE header "VDFM";
    474   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    475       UVIFA(i,j,r) # purchases of imported i r for use in j in region r #;
    476   Read
    477       UVIFA from file GTAPUPDATE header "VIFA";
    478   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    479       UVDFA(i,j,r) # purchases of domestic i r for use in j in region r #;
    480   Read
    481       UVDFA from file GTAPUPDATE header "VDFA";
    482   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    483       BVXMD(i,r,s)
    484       # exports of i from r to s at market prices (tradeables only) #;
    485   Read
    486       BVXMD from file GTAPBASE header "VXMD";
    487   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    488       UVXMD(i,r,s)
    489       # exports of i from r to s at market prices (tradeables only) #;
    490   Read
    491       UVXMD from file GTAPUPDATE header "VXMD";
    492    
    493    
    494   !<
    495       A21:  Output Tax Effect
    496       -----------------------
    497    
    498       A21:  Output Tax Effect
    499       A211: Output Tax Effect: Explanatory Factors
    500   >!
    501    
    502    
    503   !<
    504       A21:  Output Tax Effect
    505       .......................
    506   >!
    507    
    508   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    509       CNTqoir(i,r)
    510       # contribution to WEV of changes in output of NSAV_COMM i in r #;
    511   Read
    512       CNTqoir from file GTAPSOL header "QOIR";
    513    
    514   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    515       OTAX(i,r);
    516   Formula (all,i,NSAV_COMM)(all,r,REG)
    517       OTAX(i,r) = CNTqoir(i,r);
    518    
    519   Write
    520       OTAX to file WELVIEW header "A21"
    521       longname "Output Tax Effect";
    522    
    523    
    524   !<
    525       A211: Output Tax Effect: Explanatory Factors
    526       ............................................
    527   >!
    528    
    529   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    530       BVFM(i,j,r) # producer expenditure on i by j in r at market prices #;
    531   Read
    532       BVFM from file GTAPBASE header "VFM";
    533    
    534   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    535       BVDM(i,r) # domestic sales of i in r at market prices (tradeables only) #;
    536   Formula (all,i,TRAD_COMM)(all,r,REG)
    537       BVDM(i,r) = sum(h, HHLD, BVDPM(i,h,r))
    538                 + BVDGM(i,r) + sum(j,PROD_COMM, BVDFM(i,j,r));
    539    
    540   Coefficient (all,m,MARG_COMM)(all,r,REG)
    541       BVST(m,r)
    542       # exports of m from r for int'l transport at mkt prices (tradeables only) #;
    543   Read
    544       BVST from file GTAPBASE header "VST";
    545    
    546   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    547       BVOM(i,r) # value of commodity i output in region r at mkt prices #;
    548   Formula (all,i,ENDW_COMM)(all,r,REG)
    549       BVOM(i,r) = sum(j,PROD_COMM, BVFM(i,j,r));
    550   Formula (all,m,MARG_COMM)(all,r,REG)
    551       BVOM(m,r) = BVDM(m,r) + sum(s,REG, BVXMD(m,r,s)) + BVST(m,r);
    552   Formula (all,i,NMRG_COMM)(all,r,REG)
    553       BVOM(i,r) = BVDM(i,r) + sum(s,REG, BVXMD(i,r,s));
    554   Formula (all,h,CGDS_COMM)(all,r,REG)
    555       BVOM(h,r) = BVOA(h,r);
    556    
    557   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    558       qo(i,r) # industry output of commodity i in region r #;
    559   Read
    560       qo from file GTAPSOL header "qo";
    561    
    562   Zerodivide (nonzero_by_zero) default 0;
    563    
    564   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    565       BOUTAX(i,r);
    566   Formula (all,i,NSAV_COMM)(all,r,REG)
    567       BOUTAX(i,r) = [BVOM(i,r) - BVOA(i,r)] / BVOM(i,r) * 100;
    568    
    569   Zerodivide (nonzero_by_zero) off;
    570    
    571   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    572       UVFM(i,j,r) # producer expenditure on i by j in r at market prices #;
    573   Read
    574       UVFM from file GTAPUPDATE header "VFM";
    575    
    576   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    577       UVDM(i,r) # domestic sales of i in r at market prices (tradeables only) #;
    578   Formula (all,i,TRAD_COMM)(all,r,REG)
    579       UVDM(i,r) = sum(h, HHLD, UVDPM(i,h,r)) + UVDGM(i,r)
    580                 + sum(j,PROD_COMM, UVDFM(i,j,r));
    581    
    582   Coefficient (all,m,MARG_COMM)(all,r,REG)
    583       UVST(m,r)
    584       # exports of m from r for int'l transport at mkt prices (tradeables only) #;
    585   Read
    586       UVST from file GTAPUPDATE header "VST";
    587    
    588   Coefficient (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    589       UEVOA(i,h,r) # value of output at agent's prices #;
    590   Read
    591       UEVOA from file GTAPUPDATE header "EVOA";
    592    
    593   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    594       UEVFA(i,j,r) # producer expenditure on i by industry j #;
    595   Read
    596       UEVFA from file GTAPUPDATE header "EVFA";
    597    
    598   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    599       UVOA(i,r) # value of commodity i output in region r #;
    600   Formula (all,i,ENDW_COMM)(all,r,REG)
    601       UVOA(i,r) = sum(h, HHLD, UEVOA(i,h,r));
    602   Formula (all,i,PROD_COMM)(all,r,REG)
    603       UVOA(i,r)
    604           = sum(j,ENDW_COMM, UEVFA(j,i,r))
    605           + sum(j,TRAD_COMM, UVIFA(j,i,r) + UVDFA(j,i,r));
    606    
    607   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    608       UVOM(i,r) # value of commodity i output in region r at mkt prices #;
    609   Formula (all,i,ENDW_COMM)(all,r,REG)
    610       UVOM(i,r) = sum(j,PROD_COMM, UVFM(i,j,r));
    611   Formula (all,m,MARG_COMM)(all,r,REG)
    612       UVOM(m,r) = UVDM(m,r) + sum(s,REG, UVXMD(m,r,s)) + UVST(m,r);
    613   Formula (all,i,NMRG_COMM)(all,r,REG)
    614       UVOM(i,r) = UVDM(i,r) + sum(s,REG, UVXMD(i,r,s));
    615   Formula (all,h,CGDS_COMM)(all,r,REG)
    616       UVOM(h,r) = UVOA(h,r);
    617    
    618   Zerodivide (nonzero_by_zero) default 0;
    619    
    620   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    621       UOUTAX(i,r);
    622   Formula (all,i,NSAV_COMM)(all,r,REG)
    623       UOUTAX(i,r) = [UVOM(i,r) - UVOA(i,r)] / UVOM(i,r) * 100;
    624    
    625   Zerodivide (nonzero_by_zero) off;
    626    
    627   Coefficient (all,i,NSAV_COMM)(all,r,REG)(all,c,COL)
    628       OUTPUT(i,r,c);
    629   Formula (all,i,NSAV_COMM)(all,r,REG)
    630       OUTPUT(i,r,"welcnt") = OTAX(i,r);
    631   Formula (all,i,NSAV_COMM)(all,r,REG)
    632       OUTPUT(i,r,"dvol") = BVOM(i,r) * qo(i,r) / 100;
    633   Formula (all,i,NSAV_COMM)(all,r,REG)
    634       OUTPUT(i,r,"taxrateb") = BOUTAX(i,r);
    635   Formula (all,i,NSAV_COMM)(all,r,REG)
    636       OUTPUT(i,r,"taxrateu") = UOUTAX(i,r);
    637    
    638   Write
    639       OUTPUT to file WELVIEW header "A211"
    640       longname "Output Tax Effect: Explanatory Factors";
    641    
    642    
    643   !<
    644       A22:  Domestic Tax Effect
    645       -------------------------
    646    
    647       A22:  Domestic Tax Effect: Summary
    648       A221: Intermed. Input Tax Effect
    649       A22F: Intermed. Input Tax Effect: Explanatory Factors
    650       A22P: Private Cons. Tax Effect: Explanatory Factors
    651       A22G: Government Cons. Tax Effect: Explanatory Factors
    652   >!
    653    
    654    
    655   !<
    656       A22: Domestic Tax Effect: Summary
    657       .................................
    658   >!
    659    
    660   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    661       CNTqfmir(i,r)
    662       # contribution to WEV of changes in use of imported int. i in all j in r #;
    663   Read
    664       CNTqfmir from file GTAPSOL header "QFMI";
    665    
    666   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    667       CNTqpmir(i,r)
    668       # contribution to WEV of changes in consumption of imported good i in r #;
    669   Read
    670       CNTqpmir from file GTAPSOL header "QPMI";
    671    
    672   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    673       CNTqgmir(i,r)
    674       # contribution to WEV of changes in gov't consumption of import i in r #;
    675   Read
    676       CNTqgmir from file GTAPSOL header "QGMI";
    677    
    678   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    679       CNTqfdir(i,r)
    680       # contribution to WEV of changes in use of domestic i in all j in r #;
    681   Read
    682       CNTqfdir from file GTAPSOL header "QFDI";
    683    
    684   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    685       CNTqpdir(i,r)
    686       # contribution to WEV of changes in consumption of domestic good i in r #;
    687   Read
    688       CNTqpdir from file GTAPSOL header "QPDI";
    689    
    690   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    691       CNTqgdir(i,r)
    692       # contribution to WEV of changes in gov't consumption of domestic i in r #;
    693   Read
    694       CNTqgdir from file GTAPSOL header "QGDI";
    695    
    696   Coefficient (all,i,TRAD_COMM)(all,j,ACTIVITY)(all,r,REG)(all,t,DIR)
    697       ATAX(i,j,r,t);
    698   Formula (all,i,TRAD_COMM)(all,r,REG)
    699       ATAX(i,"firm",r,"imported") =  CNTqfmir(i,r);
    700   Formula (all,i,TRAD_COMM)(all,r,REG)
    701       ATAX(i,"private",r,"imported") = CNTqpmir(i,r);
    702   Formula (all,i,TRAD_COMM)(all,r,REG)
    703       ATAX(i,"govt",r,"imported") = CNTqgmir(i,r);
    704   Formula (all,i,TRAD_COMM)(all,r,REG)
    705       ATAX(i,"firm",r,"domestic") = CNTqfdir(i,r);
    706   Formula (all,i,TRAD_COMM)(all,r,REG)
    707       ATAX(i,"private",r,"domestic") = CNTqpdir(i,r);
    708   Formula (all,i,TRAD_COMM)(all,r,REG)
    709       ATAX(i,"govt",r,"domestic") = CNTqgdir(i,r);
    710    
    711   Write
    712       ATAX to file WELVIEW header "A22"
    713       longname "Domestic Tax Effect: Summary";
    714    
    715    
    716   !<
    717       A221: Intermed. Input Tax Effect
    718       ................................
    719   >!
    720    
    721   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    722       CNTqfmijr(i,j,r)
    723       # contribution to WEV of changes in use of improted int. i in j of r #;
    724   Read
    725       CNTqfmijr from file GTAPSOL header "QFMJ";
    726    
    727   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    728       CNTqfdijr(i,j,r)
    729       # contribution to WEV of changes in use of domestic int. i in j of r #;
    730   Read
    731       CNTqfdijr from file GTAPSOL header "QFDJ";
    732    
    733   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)(all,t,DIR)
    734       STAX(i,j,r,t);
    735   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    736       STAX(i,j,r,"imported") = CNTqfmijr(i,j,r);
    737   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    738       STAX(i,j,r,"domestic") = CNTqfdijr(i,j,r);
    739    
    740   Write
    741       STAX to file WELVIEW header "A221"
    742       longname "Intermed. Input Tax Effect";
    743    
    744    
    745   !<
    746       A22F: Intermed. Input Tax Effect: Explanatory Factors
    747       .....................................................
    748   >!
    749    
    750   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    751       BVIFM(i,j,r) # purchases of imports i for use in j in region r #;
    752   Read
    753       BVIFM from file GTAPBASE header "VIFM";
    754    
    755   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    756       qfm(i,j,r) # industry demands for aggregate imports #;
    757   Read
    758       qfm from file GTAPSOL header "qfm";
    759    
    760   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    761       qfd(i,j,r) # industry demands for domestic goods #;
    762   Read
    763       qfd from file GTAPSOL header "qfd";
    764    
    765   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    766       UVIFM(i,j,r) # purchases of imports i for use in j in region r #;
    767   Read
    768       UVIFM from file GTAPUPDATE header "VIFM";
    769    
    770   Zerodivide (nonzero_by_zero) default 0;
    771    
    772   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    773       (all,t,DIR)(all,c,COL)
    774       FIRM(i,j,r,t,c);
    775   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)(all,t,DIR)
    776       FIRM(i,j,r,t,"welcnt") = STAX(i,j,r,t);
    777   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    778       FIRM(i,j,r,"imported","dvol") = [BVIFM(i,j,r) * qfm(i,j,r)] / 100;
    779   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    780       FIRM(i,j,r,"domestic","dvol") = [BVDFM(i,j,r) * qfd(i,j,r)] / 100;
    781   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    782       FIRM(i,j,r,"imported","taxrateb")
    783           = 100 * [BVIFA(i,j,r) - BVIFM(i,j,r)] / BVIFM(i,j,r);
    784   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    785       FIRM(i,j,r,"imported","taxrateu")
    786           = 100 * [UVIFA(i,j,r) - UVIFM(i,j,r)] / UVIFM(i,j,r);
    787   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    788       FIRM(i,j,r,"domestic","taxrateb")
    789           = 100 * [BVDFA(i,j,r) - BVDFM(i,j,r)] / BVDFM(i,j,r);
    790   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    791       FIRM(i,j,r,"domestic","taxrateu")
    792           = 100 * [UVDFA(i,j,r) - UVDFM(i,j,r)] / UVDFM(i,j,r);
    793    
    794   Zerodivide (nonzero_by_zero) off;
    795    
    796   Write
    797       FIRM to file WELVIEW header "A22F"
    798       longname "Intermed. Input Tax Effect: Explanatory Factors";
    799    
    800    
    801   !<
    802       A22P: Private Cons. Tax Effect: Explanatory Factors
    803       ...................................................
    804   >!
    805    
    806   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    807       BVIPM(i,h,r) # private household expenditure on i in r #;
    808   Read
    809       BVIPM from file GTAPBASE header "VIPM";
    810    
    811   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    812       qpm(i,r) # private hhld demand for imports of i in region r #;
    813   Read
    814       qpm from file GTAPSOL header "qpm";
    815    
    816   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    817       qpd(i,r) # private hhld demand for domestic i in region r #;
    818   Read
    819       qpd from file GTAPSOL header "qpd";
    820    
    821   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    822       BVIPA(i,h,r) # private household expenditure on imported i #;
    823   Read
    824       BVIPA from file GTAPBASE header "VIPA";
    825    
    826   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    827       UVIPA(i,h,r) # private household expenditure on imported i #;
    828   Read
    829       UVIPA from file GTAPUPDATE header "VIPA";
    830    
    831   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    832       UVIPM(i,h,r) # private household expenditure on i in r #;
    833   Read
    834       UVIPM from file GTAPUPDATE header "VIPM";
    835    
    836   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    837       BVDPA(i,h,r) # private household expenditure on domestic i in r #;
    838   Read
    839       BVDPA from file GTAPBASE header "VDPA";
    840    
    841   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    842       UVDPA(i,h,r) # private household expenditure on domestic i in r #;
    843   Read
    844       UVDPA from file GTAPUPDATE header "VDPA";
    845    
    846   Zerodivide (nonzero_by_zero) default 0;
    847    
    848   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,t,DIR)(all,c,COL)
    849       PRIVATE(i,r,t,c);
    850   Formula (all,i,TRAD_COMM)(all,r,REG)(all,t,DIR)
    851       PRIVATE(i,r,t,"welcnt") = ATAX(i,"private",r,t);
    852   Formula (all,i,TRAD_COMM)(all,r,REG)
    853       PRIVATE(i,r,"imported","dvol") = [sum(h, HHLD, BVIPM(i,h,r))
    854                                      * qpm(i,r)] / 100;
    855   Formula (all,i,TRAD_COMM)(all,r,REG)
    856       PRIVATE(i,r,"domestic","dvol") = [sum(h, HHLD, BVDPM(i,h,r))
    857                                      * qpd(i,r)] / 100;
    858   Formula (all,i,TRAD_COMM)(all,r,REG)
    859       PRIVATE(i,r,"imported","taxrateb")
    860           = 100 * [sum(h, HHLD, BVIPA(i,h,r) - BVIPM(i,h,r))]
    861           / sum(h, HHLD, BVIPM(i,h,r));
    862   Formula (all,i,TRAD_COMM)(all,r,REG)
    863       PRIVATE(i,r,"imported","taxrateu")
    864           = 100 * [sum(h, HHLD, UVIPA(i,h,r) - UVIPM(i,h,r))]
    865           / sum(h, HHLD, UVIPM(i,h,r));
    866   Formula (all,i,TRAD_COMM)(all,r,REG)
    867       PRIVATE(i,r,"domestic","taxrateb")
    868           = 100 * [sum(h,HHLD, BVDPA(i,h,r) - BVDPM(i,h,r))]
    869             / sum(h, HHLD, BVDPM(i,h,r));
    870   Formula (all,i,TRAD_COMM)(all,r,REG)
    871       PRIVATE(i,r,"domestic","taxrateu")
    872           = 100 * [sum(h, HHLD, UVDPA(i,h,r) - UVDPM(i,h,r))]
    873           / sum(h, HHLD, UVDPM(i,h,r));
    874    
    875   Zerodivide (nonzero_by_zero) off;
    876    
    877   Write
    878       PRIVATE to file WELVIEW header "A22P"
    879       longname "Private Cons. Tax Effect: Explanatory Factors";
    880    
    881    
    882   !<
    883       A22G: Government Cons. Tax Effect: Explanatory Factors
    884       ......................................................
    885   >!
    886    
    887   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    888       BVIGM(i,r) # gov't household expenditure on i in r #;
    889   Read
    890       BVIGM from file GTAPBASE header "VIGM";
    891    
    892   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    893       qgm(i,r) # government hhld demand for imports of i in region r #;
    894   Read
    895       qgm from file GTAPSOL header "qgm";
    896    
    897   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    898       qgd(i,r) # government hhld demand for domestic i in region r #;
    899   Read
    900       qgd from file GTAPSOL header "qgd";
    901    
    902   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    903       BVIGA(i,r) # government household expenditure on imported i #;
    904   Read
    905       BVIGA from file GTAPBASE header "VIGA";
    906    
    907   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    908       UVIGA(i,r) # government household expenditure on imported i #;
    909   Read
    910       UVIGA from file GTAPUPDATE header "VIGA";
    911    
    912   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    913       UVIGM(i,r) # gov't household expenditure on i in r #;
    914   Read
    915       UVIGM from file GTAPUPDATE header "VIGM";
    916    
    917   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    918       BVDGA(i,r) # government household expenditure on domestic i in r #;
    919   Read
    920       BVDGA from file GTAPBASE header "VDGA";
    921    
    922   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    923       UVDGA(i,r) # government household expenditure on domestic i in r #;
    924   Read
    925       UVDGA from file GTAPUPDATE header "VDGA";
    926    
    927   Zerodivide (nonzero_by_zero) default 0;
    928    
    929   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,t,DIR)(all,c,COL)
    930       GOVT(i,r,t,c);
    931   Formula (all,i,TRAD_COMM)(all,r,REG)(all,t,DIR)
    932       GOVT(i,r,t,"welcnt") = ATAX(i,"govt",r,t);
    933   Formula (all,i,TRAD_COMM)(all,r,REG)
    934       GOVT(i,r,"imported","dvol") = [BVIGM(i,r) * qgm(i,r)] / 100;
    935   Formula (all,i,TRAD_COMM)(all,r,REG)
    936       GOVT(i,r,"domestic","dvol") = [BVDGM(i,r) * qgd(i,r)] / 100;
    937   Formula (all,i,TRAD_COMM)(all,r,REG)
    938       GOVT(i,r,"imported","taxrateb")
    939           = 100 * [BVIGA(i,r) - BVIGM(i,r)] / BVIGM(i,r);
    940   Formula (all,i,TRAD_COMM)(all,r,REG)
    941       GOVT(i,r,"imported","taxrateu")
    942           = 100 * [UVIGA(i,r) - UVIGM(i,r)] / UVIGM(i,r);
    943   Formula (all,i,TRAD_COMM)(all,r,REG)
    944       GOVT(i,r,"domestic","taxrateb")
    945           = 100 * [BVDGA(i,r) - BVDGM(i,r)] / BVDGM(i,r);
    946   Formula (all,i,TRAD_COMM)(all,r,REG)
    947       GOVT(i,r,"domestic","taxrateu")
    948           = 100 * [UVDGA(i,r) - UVDGM(i,r)] / UVDGM(i,r);
    949    
    950   Zerodivide (nonzero_by_zero) off;
    951    
    952   Write
    953       GOVT to file WELVIEW header "A22G"
    954       longname "Government Cons. Tax Effect: Explanatory Factors";
    955    
    956    
    957   !<
    958       A23:  Trade Tax Effect
    959       ----------------------
    960    
    961       A23:  Trade Tax Effect
    962       A231: Trade Tax Effect: Explanatory Factors
    963   >!
    964    
    965    
    966   !<
    967       A23:  Trade Tax Effect
    968       ......................
    969   >!
    970    
    971   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    972       CNTqxsirs(i,r,s)
    973       # contrib. to WEV of changes in exports of i from srce r to dest s #;
    974   Read
    975       CNTqxsirs from file GTAPSOL header "QXSS";
    976    
    977   Coefficient (all,i,TRAD_COMM)(all,s,REG)(all,r,REG)
    978       CNTqimisr(i,s,r)
    979       # contrib. to WEV of changes in imports of i from srce s to dest r #;
    980   Read
    981       CNTqimisr from file GTAPSOL header "QIMS";
    982    
    983   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)(all,k,TYPE)
    984       TTAX(i,r,s,k);
    985   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    986       TTAX(i,r,s,"xtax") = CNTqxsirs(i,r,s);
    987   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    988       TTAX(i,r,s,"mtax") = CNTqimisr(i,r,s);
    989    
    990   Write
    991       TTAX to file WELVIEW header "A23"
    992       longname "Trade Tax Effect";
    993    
    994    
    995   !<
    996       A231: Trade Tax Effect: Explanatory Factors
    997       ...........................................
    998   >!
    999    
   1000   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1001       BVIMS(i,r,s) # imports of i from r to s at domestic market prices #;
   1002   Read
   1003       BVIMS from file GTAPBASE header "VIMS";
   1004    
   1005   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1006       BVIWS(i,r,s) # imports of i from r to s valued cif (tradeables only) #;
   1007   Read
   1008       BVIWS from file GTAPBASE header "VIWS";
   1009    
   1010   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1011       BIMTAX(i,r,s);
   1012   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1013       BIMTAX(i,r,s) = [BVIMS(i,r,s) - BVIWS(i,r,s)] / BVIWS(i,r,s) * 100;
   1014    
   1015   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1016       BVXWD(i,r,s) # exports of i from r to s valued fob (tradeables only) #;
   1017   Read
   1018       BVXWD from file GTAPBASE header "VXWD";
   1019    
   1020   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1021       BEXTAX(i,r,s);
   1022   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1023       BEXTAX(i,r,s) = [BVXWD(i,r,s) - BVXMD(i,r,s)] / BVXWD(i,r,s) * 100;
   1024    
   1025   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1026       UVIMS(i,r,s) # imports of i from r to s at domestic market prices #;
   1027   Read
   1028       UVIMS from file GTAPUPDATE header "VIMS";
   1029    
   1030   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1031       UVIWS(i,r,s) # imports of i from r to s valued cif (tradeables only) #;
   1032   Read
   1033       UVIWS from file GTAPUPDATE header "VIWS";
   1034    
   1035   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1036       UIMTAX(i,r,s);
   1037   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1038       UIMTAX(i,r,s) = [UVIMS(i,r,s) - UVIWS(i,r,s)] / UVIWS(i,r,s) * 100;
   1039    
   1040   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1041       UVXWD(i,r,s) # exports of i from r to s valued fob (tradeables only) #;
   1042   Read
   1043       UVXWD from file GTAPUPDATE header "VXWD";
   1044    
   1045   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1046       UEXTAX(i,r,s);
   1047   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1048       UEXTAX(i,r,s) = [UVXWD(i,r,s) - UVXMD(i,r,s)] / UVXWD(i,r,s) * 100;
   1049    
   1050   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1051       qxs(i,r,s) # export sales of commodity i from r to region s #;
   1052   Read
   1053       qxs from file GTAPSOL header "qxs";
   1054    
   1055   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)(all,c,COL)(all,d,DIREC)
   1056       TRADE(i,r,s,c,d);
   1057   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1058       TRADE(i,r,s,"welcnt","import") = TTAX(i,r,s,"mtax");
   1059   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1060       TRADE(i,r,s,"welcnt","export") = TTAX(i,r,s,"xtax");
   1061   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1062       TRADE(i,r,s,"dvol","import") = BVXMD(i,r,s) * qxs(i,r,s) / 100;
   1063   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1064       TRADE(i,r,s,"dvol","export") = BVXMD(i,r,s) * qxs(i,r,s) / 100;
   1065   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1066       TRADE(i,r,s,"taxrateb","import") = BIMTAX(i,r,s);
   1067   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1068       TRADE(i,r,s,"taxrateu","import") = UIMTAX(i,r,s);
   1069   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1070       TRADE(i,r,s,"taxrateb","export") = BEXTAX(i,r,s);
   1071   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1072       TRADE(i,r,s,"taxrateu","export") = UEXTAX(i,r,s);
   1073    
   1074   Write
   1075       TRADE to file WELVIEW header "A231"
   1076       longname "Trade Tax Effect: Explanatory Factors";
   1077    
   1078    
   1079   !<
   1080       A3:   Endowment Tax Effect
   1081       --------------------------
   1082   >!
   1083    
   1084   Coefficient (all,i,ENDW_COMM)(all,r,REG)
   1085       CNTqfeir(i,r)
   1086       # contribution to WEV of changes in use of all ENDW_COMM i in r #;
   1087   Read
   1088       CNTqfeir from file GTAPSOL header "QEIR";
   1089    
   1090   Write CNTqfeir to file WELVIEW header "A3"
   1091       longname "Endowment Tax Effect";
   1092    
   1093   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1094       CNTqfeijr(i,j,r)
   1095       # contribution to WEV of changes in use of all ENDW_COMM i in j of r #;
   1096   Read
   1097       CNTqfeijr from file GTAPSOL header "EIJR";
   1098    
   1099   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1100       BENDTAX(i,j,r);
   1101   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1102       BENDTAX(i,j,r) = [BEVFA(i,j,r) - BVFM(i,j,r)] / bvfm(i,j,r) * 100;
   1103    
   1104   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1105       UENDTAX(i,j,r);
   1106   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1107       UENDTAX(i,j,r) = [UEVFA(i,j,r) - UVFM(i,j,r)] / uvfm(i,j,r) * 100;
   1108    
   1109   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1110       qfe(i,j,r) # industry demands for endowment commodities #;
   1111   Read
   1112       qfe from file GTAPSOL header "qfe";
   1113    
   1114   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)(all,c,COL)
   1115       PFACTOR(i,j,r,c);
   1116   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1117       PFACTOR(i,j,r,"welcnt") = CNTqfeijr(i,j,r);
   1118   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1119       PFACTOR(i,j,r,"dvol") = BVFM(i,j,r) * qfe(i,j,r) / 100;
   1120   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1121       PFACTOR(i,j,r,"taxrateb") = BENDTAX(i,j,r);
   1122   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1123       PFACTOR(i,j,r,"taxrateu") = UENDTAX(i,j,r);
   1124    
   1125   Write PFACTOR to file WELVIEW header "A31"
   1126       longname "Endowment Tax Effect: Explanatory Factors";
   1127    
   1128    
   1129   !<
   1130       -------------------------------------------
   1131       B1: Endowment Effect, Gross of Depreciation
   1132       -------------------------------------------
   1133   >!
   1134    
   1135   Coefficient (all,i,ENDW_COMM)(all,r,REG)
   1136       CNTendwir(i,r) # contribution to regional EV of changes in ENDW_COMM i #;
   1137   Read
   1138       CNTendwir from file GTAPSOL header "ENDI";
   1139    
   1140   Coefficient (all,r,REG)(all,i,ENDW_COMM)
   1141       CNTendw(r,i) # contribution to welfare by ENDW_COMM i in region r #;
   1142   Formula (all,r,REG)(all,i,ENDW_COMM)
   1143       CNTendw(r,i) = CNTendwir(i,r);
   1144   Write
   1145       CNTendw to file WELVIEW header "B1"
   1146       longname "Endowment Effect, Gross of Depreciation";
   1147    
   1148    
   1149   !<
   1150       ----------------------------------
   1151       B2: Endowment Effect: Depreciation
   1152       ----------------------------------
   1153   >!
   1154    
   1155   Coefficient (all,r,REG)
   1156       CNTkbr(r) # contribution to regional EV of depreciation #;
   1157   Read
   1158       CNTkbr from file GTAPSOL header "CKBR";
   1159   Write
   1160       CNTkbr to file WELVIEW header "B2"
   1161       longname "Endowment Effect: Depreciation";
   1162    
   1163    
   1164   !<
   1165       ---------------------------
   1166       C1: Technical Change Effect
   1167       ---------------------------
   1168    
   1169       C1:  Technical Change Effect: Summary
   1170       C1X: Technical Change Effect: Further Decomposition
   1171   >!
   1172    
   1173    
   1174   !<
   1175       C1:  Technical Change Effect: Summary
   1176       -------------------------------------
   1177   >!
   1178    
   1179   Coefficient (all,r,REG)
   1180       CNTtech_aor(r)
   1181       # contribution to regional EV of output augmenting technical change #;
   1182   Read
   1183       CNTtech_aor from file GTAPSOL header "AOR";
   1184    
   1185   Coefficient (all,r,REG)
   1186       CNTtech_afer(r)
   1187       # contribution to regional EV of primary factor augmenting tech change #;
   1188   Read
   1189       CNTtech_afer from file GTAPSOL header "AFER";
   1190    
   1191   Coefficient (all,r,REG)
   1192       CNTtech_avar(r)
   1193       # contribution to regional EV of value added augmenting tech change #;
   1194   Read
   1195       CNTtech_avar from file GTAPSOL header "AVAR";
   1196    
   1197   Coefficient (all,r,REG)
   1198       CNTtech_afr(r)
   1199       # cont. to regional EV of comp. int. input augmenting tech change #;
   1200   Read
   1201       CNTtech_afr from file GTAPSOL header "AFR";
   1202    
   1203   Coefficient (all,r,REG)
   1204       CNTtech_atrr(r)
   1205       # contribution to regional EV of technical change in transportation #;
   1206   Read
   1207       CNTtech_atrr from file GTAPSOL header "ATR";
   1208    
   1209   Coefficient (all,r,REG)
   1210       CNTtech_amsr(r)
   1211       # contribution to regional EV of import-augmenting technical change #;
   1212   Read
   1213       CNTtech_amsr from file GTAPSOL header "AMSR";
   1214    
   1215   Coefficient (all,r,REG)(all,i,TECHTYPE)
   1216       CNTtech(r,i) # contribution to welfare change by tech #;
   1217   Formula (all,r,REG)
   1218       CNTtech(r,"output") = CNTtech_aor(r);
   1219   Formula (all,r,REG)
   1220       CNTtech(r,"primfac") = CNTtech_afer(r);
   1221   Formula (all,r,REG)
   1222       CNTtech(r,"v_added") = CNTtech_avar(r);
   1223   Formula (all,r,REG)
   1224       CNTtech(r,"ininput") = CNTtech_afr(r);
   1225   Formula (all,r,REG)
   1226       CNTtech(r,"transp") = CNTtech_atrr(r);
   1227   Formula (all,r,REG)
   1228       CNTtech(r,"import") = CNTtech_amsr(r);
   1229    
   1230   Write
   1231       CNTtech to file WELVIEW header "C1"
   1232       longname "Technical Change Effect: Summary";
   1233    
   1234    
   1235   !<
   1236       C1X: Technical Change Effect: Further Decomposition
   1237       ---------------------------------------------------
   1238   >!
   1239    
   1240   Coefficient (all,i,PROD_COMM)(all,r,REG)
   1241       CNTtech_aoir(i,r);
   1242   Read
   1243       CNTtech_aoir from file GTAPSOL header "AOIR";
   1244   Write
   1245       CNTtech_aoir to file WELVIEW header "C11"
   1246       longname "(ao) Output Augm. Tech. Change Effect";
   1247    
   1248   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
   1249       Ctech_afeijr(i,j,r);
   1250   Read
   1251       Ctech_afeijr from file GTAPSOL header "FEIJ";
   1252   Write
   1253       Ctech_afeijr to file WELVIEW header "C12"
   1254       longname "(afe) Primary Factor Augm. Tech. Change Effect";
   1255    
   1256   Coefficient (all,j,PROD_COMM)(all,r,REG)
   1257       Ctech_avajr(j,r);
   1258   Read
   1259       Ctech_avajr from file GTAPSOL header "AVJR";
   1260   Write
   1261       Ctech_avajr to file WELVIEW header "C13"
   1262       longname "(ava) Value Added Augm. Tech. Change Effect";
   1263    
   1264   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
   1265       Ctech_afijr(i,j,r);
   1266   Read
   1267       Ctech_afijr from file GTAPSOL header "AFIJ";
   1268   Write
   1269       Ctech_afijr to file WELVIEW header "C14"
   1270       longname "(af) Intermed. Input Augm. Tech. Change Effect";
   1271    
   1272   Coefficient (all,m,MARG_COMM)(all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1273       Ctech_mirs(m,i,r,s);
   1274   Read
   1275       Ctech_mirs from file GTAPSOL header "MIRS";
   1276   Write
   1277       Ctech_mirs to file WELVIEW header "C15"
   1278       longname "(atmfsd) Internat. Margin Augm. Tech. Change Effect";
   1279    
   1280   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
   1281       Ctech_amsirs(i,r,s);
   1282   Read
   1283       Ctech_amsirs from file GTAPSOL header "AMIR";
   1284   Write
   1285       Ctech_amsirs to file WELVIEW header "C16"
   1286       longname "(ams) Bilateral Import Augm. Tech. Change Effect";
   1287    
   1288    
   1289   !<
   1290       ---------------------
   1291       D1: Population Effect
   1292       ---------------------
   1293    
   1294       No decomposition required here.
   1295   >!
   1296    
   1297    
   1298   !<
   1299       -------------------------
   1300       E1: Terms of Trade Effect
   1301       -------------------------
   1302   >!
   1303    
   1304   Coefficient (all,i,TRAD_COMM)(all,r,REG)
   1305       c1_ir(i,r) # contribution of world price, px_i, to ToT #;
   1306   Read
   1307       c1_ir from file GTAPSOL header "C1IR";
   1308    
   1309   Coefficient (all,i,TRAD_COMM)(all,r,REG)
   1310       c2_ir(i,r) # contribution of regional export price, px_ir, to ToT #;
   1311   Read
   1312       c2_ir from file GTAPSOL header "C2IR";
   1313    
   1314   Coefficient (all,i,TRAD_COMM)(all,r,REG)
   1315       c3_ir(i,r) # contribution of regional import price, pm_ir, to ToT #;
   1316   Read
   1317       c3_ir from file GTAPSOL header "C3IR";
   1318    
   1319   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,t,PRICES)(all,s,FORM)
   1320       TOT(i,r,t,s)
   1321       # terms trade effects decomposed by effects of different prices #;
   1322   Formula (all,i,TRAD_COMM)(all,r,REG)
   1323       TOT(i,r,"pworld","percent") = c1_ir(i,r);
   1324   Formula (all,i,TRAD_COMM)(all,r,REG)
   1325       TOT(i,r,"pexport","percent") = c2_ir(i,r);
   1326   Formula (all,i,TRAD_COMM)(all,r,REG)
   1327       TOT(i,r,"pimport","percent") = -c3_ir(i,r);
   1328   Formula (all,i,TRAD_COMM)(all,r,REG)
   1329       TOT(i,r,"pworld","value")
   1330           = CNTtotr(r) * c1_ir(i,r)
   1331           / sum(j,TRAD_COMM, sum(t,PRICES, TOT(j,r,t,"percent")));
   1332   Formula (all,i,TRAD_COMM)(all,r,REG)
   1333       TOT(i,r,"pexport","value")
   1334           = CNTtotr(r) * c2_ir(i,r)
   1335           / sum(t,PRICES, sum(j,TRAD_COMM, TOT(j,r,t,"percent")));
   1336   Formula (all,i,TRAD_COMM)(all,r,REG)
   1337       TOT(i,r,"pimport","value")
   1338           = -c3_ir(i,r) * CNTtotr(r)
   1339           / sum(t,PRICES, sum(j,TRAD_COMM, TOT(j,r,t,"percent")));
   1340    
   1341   Write
   1342       TOT to file WELVIEW header "E1"
   1343       longname "Terms of Trade Effect";
   1344    
   1345    
   1346   !<
   1347       -----------------------------------
   1348       F1: I-S Effect: Explanatory Factors
   1349       -----------------------------------
   1350   >!
   1351    
   1352   Coefficient (all,r,REG)
   1353       BSAVE(r) # expenditure on NET savings in region r at agent's prices #;
   1354   Read
   1355       BSAVE from file GTAPBASE header "SAVE";
   1356    
   1357   Coefficient (ge 0)(all,h,HHLD)(all,r,REG)
   1358       BVDEP(h,r) # value of capital depeciation in r (exogenous) #;
   1359   Read
   1360       BVDEP from file GTAPBASE header "VDEP";
   1361    
   1362   Coefficient (all,r,REG)
   1363       NETINV(r) # regional net investment in region r #;
   1364   Formula (all,r,REG)
   1365       NETINV(r) = sum(k,CGDS_COMM, BVOA(k,r)) - sum(h, HHLD, BVDEP(h,r));
   1366    
   1367   Coefficient (all,r,REG)
   1368       ISBAL(r) # I-S balance, NETINV(r) - SAVE(r) #;
   1369   Formula (all,r,REG)
   1370       ISBAL(r) = NETINV(r) - BSAVE(r);
   1371    
   1372   Coefficient (all,r,REG)
   1373       pcgds(r) # price of investment goods = ps("cgds",r) #;
   1374   Read
   1375       pcgds from file GTAPSOL header "pcgd";
   1376    
   1377   Coefficient (all,r,REG)
   1378       psave(r) # price of savings in region r #;
   1379   Read
   1380       psave from file GTAPSOL header "psav";
   1381    
   1382   Coefficient (all,r,REG)(all,j,COLM)
   1383       CGDSCOMP(r,j) # components of cgds effect #;
   1384   Formula (all,r,REG)
   1385       CGDSCOMP(r,"ISbal") = ISBAL(r);
   1386   Formula (all,r,REG)
   1387       CGDSCOMP(r,"p_cgds") = pcgds(r);
   1388   Formula (all,r,REG)
   1389       CGDSCOMP(r,"p_save") = psave(r);
   1390   Write
   1391       CGDSCOMP to file WELVIEW header "F1"
   1392       longname "I-S Effect: Explanatory Factors";
   1393    
   1394   !<
   1395       --------------------------
   1396       H1: Foreign income Effects
   1397       --------------------------
   1398   >!
   1399    
   1400   Coefficient (all,r,REG)(all,j,FORINC)
   1401      FINCDCOMP(r,j) # components of cgds effect #;
   1402   Formula (all,r,REG)
   1403      FINCDCOMP(r,"FKY") = CNTfkyr(r);
   1404   Formula (all,r,REG)
   1405      FINCDCOMP(r,"REM") = CNTremr(r);
   1406   Formula (all,r,REG)
   1407      FINCDCOMP(r,"AID") = CNTaidr(r);
   1408   Write
   1409      FINCDCOMP to file WELVIEW header "H1"
   1410       longname "Foreign income Effects: Explanatory Factors";
   1411    
   1412   !<
   1413       -----------------
   1414       END OF DECOMP.TAB
   1415       -----------------
   1416   >!




