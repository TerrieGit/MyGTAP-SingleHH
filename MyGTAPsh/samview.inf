     28    
     29   >!
     30    
     31   !========================================================================!
     32   !                              Declare Files                             !
     33   !========================================================================!
     34    
     35   File
     36         GTAPDATA # File containing all base data #;
     37         GTAPSETS # File with set specification #;
     38         GTAPPARM # File containing behavioral prameters #; ! even if unused !
     39   (new) GTAPSAM # File with headers for viewing #;
     40    
     41   !========================================================================!
     42   !                              Declare Sets                              !
     43   !========================================================================!
     44    
     45   !GTAPSets from GTAPAgg!
     46    
     47   Set
     48       REG # regions in the model #
     49       read elements from file GTAPSETS header "H1";
     50       HHLD # Households #
     51       read elements from file GTAPSETS header "HOU";
     52       TRAD_COMM # traded commodities #
     53       read elements from file GTAPSETS header "H2";
     54       MARG_COMM # margin commodities #
     55       read elements from file GTAPSETS header "MARG";
     56   Subset
     57       MARG_COMM is subset of TRAD_COMM;
     58   Set
     59       ENDW_COMM #Factors# read elements from file GTAPsets header "H6";
     60       CGDS_COMM # capial goods # read elements from file GTAPSETS header "H9";
     61       PROD_COMM #production commodities# = TRAD_COMM union CGDS_COMM ;
     62       ENDWC_COMM read elements from file GTAPSETS header"ENDC";
     63       ENDWL_COMM read elements from file GTAPSETS header"ENDL";
     64    
     65   subset ENDWC_COMM is subset of ENDW_COMM ;
     66   subset ENDWL_COMM is subset of ENDW_COMM ;
     67    
     68   ! Common sets !
     69    
     70   Set
     71       FACTDEP #Factors subject to depreciation# (Capital);
     72   Subset
     73       FACTDEP is subset of ENDW_COMM;
     74    
     75   Set
     76       PRIV #Private Expenditure# = HHLD;
     77       PRODTAX #Production Taxes# (PRODTAX);
     78       DIRTAX #Direct Taxes# (DIRTAX);
     79       GOVT #Government# (GOVT);
     80       ROW #Aggregated region# (world);
     81    
     82   !Makes new set labels!
     83    
     84   Set
     85       MLABL #Imported commodities labels# (m) ;
     86   Set
     87       DLABL #Domestic commodities labels# (d) ;
     88   Set
     89       ALABL #Activity labels# (a) ;
     90   Set
     91       LTMM #Import duties# (tmm);
     92   Set
     93       LTEE #Export taxes# (tee);
     94   Set
     95       LTSSM #Import Sales Taxes# (tssm);
     96   Set
     97       LTSSD #Domestic Sales Taxes# (tssd);
     98   Set
     99       LTFF #Factor Taxes# (tf);
    100   Set
    101       LTRXM #Export of Margins# (pvst);
    102   Set
    103       LWW #Rest of World# (ww);
    104    
    105   !For gempack 11!
    106   ! Set LABELS #Special labels for SAM# = MLABL + DLABL + ALABL + LTMM + LTEE +
    107   LTSSM + LTSSD + LTFF + LTRXM + LWW + FACTDEP + REGHOUS + PRIV + PRODTAX + DIRTAX
    108   + GOVT + ROW ;!
    109    
    110   !For gempack 10!
    111   Set LABELS1 #Special labels for SAM# = MLABL + DLABL;
    112   Set LABELS2 #Special labels for SAM# = ALABL + LTMM;
    113   Set LABELS3 #Special labels for SAM# = LTEE + LTSSM;
    114   Set LABELS4 #Special labels for SAM# = LTSSD + LTFF;
    115   Set LABELS5 #Special labels for SAM# = LTRXM + LWW;
    116   Set LABELS6 #Special labels for SAM# = FACTDEP ;
    117   Set LABELS7 #Special labels for SAM# = PRIV + GOVT;
    118   Set LABELS8 #Special labels for SAM# = DIRTAX + PRODTAX;
    119   Set LABELS9 #Special labels for SAM# = ROW;
    120    
    121   Set LABELS10 #Special labels for SAM# = LABELS1 + LABELS2;
    122   Set LABELS11 #Special labels for SAM# = LABELS10 + LABELS3;
    123   Set LABELS12 #Special labels for SAM# = LABELS11 + LABELS4;
    124   Set LABELS13 #Special labels for SAM# = LABELS12 + LABELS5;
    125   Set LABELS14 #Special labels for SAM# = LABELS13 + LABELS6;
    126   Set LABELS15 #Special labels for SAM# = LABELS14 + LABELS7;
    127   Set LABELS16 #Special labels for SAM# = LABELS15 + LABELS8;
    128   Set LABELS #Special labels for SAM# = LABELS16 + LABELS9;
    129    
    130    
    131   set LONGLABEL #Long names of special labels for SAM#
    132   (ImportCommod, DomCommod, Activities,ImportDuties, ExportTaxes,
    133   ImportSalTax, DomSalTax,FactorTaxes, ExportMargin,RestOfWorld,
    134   Depreciation,RegionHhold, PrivExpend,
    135   ProductTaxes, DirectTaxes,Government, AggregRegion);
    136    
    137   !New sets for SAM!
    138    
    139   Set
    140       MCOM #Imported commodities # = MLABL x TRAD_COMM ;
    141   Set
    142       DCOM #Domestic commodities # = DLABL x TRAD_COMM ;
    143    
    144    
    145   Coefficient (all,i,TRAD_COMM) ISMAR(i) # 1 iff margin #;
    146   Formula     (all,i,TRAD_COMM) ISMAR(i) =0;
    147               (all,i,MARG_COMM) ISMAR(i) =1;
    148    
    149   MAPPING (PROJECT) COMDCOM from DCOM to TRAD_COMM ;
    150    
    151   Set
    152     !  MARG_DCOM #Domestic margins commodities # = DLABL x MARG_COMM ;!
    153      MARG_DCOM #Domestic margins commodities # = (all,d,DCOM:ISMAR(COMDCOM(d))=1);
    154    
    155   MAPPING  MARGCOM from MARG_DCOM to MARG_COMM ;
    156   Formula (all,d,MARG_DCOM) MARGCOM(d)=$pos(d);
    157   !Subset MARG_DCOM is subset of DCOM ;!
    158   Set
    159       ACT #Activities# = ALABL x TRAD_COMM ;
    160   Set
    161       TMM #Import duties# = LTMM x REG ;
    162   Set
    163       TEE #Export taxes# = LTEE x REG ;
    164   Set
    165       TSSM #Import Sales Taxes# = LTSSM x TRAD_COMM ;
    166   Set
    167       TSSD #Domestic Sales Taxes# = LTSSD x TRAD_COMM ;
    168   Set
    169       TFF #Factor Taxes# = LTFF x ENDW_COMM ;
    170   Set
    171       TRMM #Import of Margins# = MARG_COMM x REG ;
    172   Set
    173       TRXM #Export of Margins# = MARG_COMM x LTRXM ;
    174   Set
    175       WW #Rest of World# = LWW x REG ;
    176    
    177   !For gempack 11!
    178   !Set SAMAC #Social Accounting Matrix Accounts# = MCOM + DCOM + ACT + ENDW_COMM +
    179   TMM + TEE + TSSM + TSSD + TFF + TRMM + TRXM + WW + REGHOUS + PRIV + PRODTAX
    180   + DIRTAX + GOVT + CGDS_COMM ;
    181   !
    182    
    183   Set
    184       ATMM #Aggregate Import duties# = LTMM x ROW ;
    185   Set
    186       ATEE #Aggregate Export taxes# = LTEE x ROW ;
    187   Set
    188       AWW #Aggregate Rest of World# = LWW x ROW ;
    189   Set
    190       AMARG #Aggregate Import Margins# = MARG_COMM x ROW ;
    191    
    192   !For gempack 10!
    193   Set SAMAC1 #Special labels for SAM# = MCOM + DCOM ;
    194   Set SAMAC2 #Special labels for SAM# = ACT + ENDW_COMM;
    195   Set SAMAC3 #Special labels for SAM# = TMM + TEE;
    196   Set SAMAC4 #Special labels for SAM# = TSSM + TSSD;
    197   Set SAMAC5 #Special labels for SAM# = TFF + TRMM;
    198   Set SAMAC6 #Special labels for SAM# = TRXM + WW;
    199   Set SAMAC7 #Special labels for SAM# = AWW + PRIV;
    200   Set SAMAC8 #Special labels for SAM# = PRODTAX + DIRTAX;
    201   Set SAMAC9 #Special labels for SAM# =GOVT + CGDS_COMM;
    202    
    203   Set SAMAC10 #Special labels for SAM# = SAMAC1 + SAMAC2;
    204   Set SAMAC11 #Special labels for SAM# = SAMAC10 + SAMAC3;
    205   Set SAMAC12 #Special labels for SAM# = SAMAC11 + SAMAC4;
    206   Set SAMAC13 #Special labels for SAM# = SAMAC12 + SAMAC5;
    207   Set SAMAC14 #Special labels for SAM# = SAMAC13 + SAMAC6;
    208   Set SAMAC15 #Special labels for SAM# = SAMAC14 + SAMAC7;
    209   Set SAMAC16 #Special labels for SAM# = SAMAC15 + SAMAC8;
    210   Set SAMAC #Special labels for SAM# = SAMAC16 + SAMAC9;
    211    
    212    
    213   !For gempack 11!
    214   !
    215   Set ASAMAC #Social Accounting Matrix Accounts# = MCOM + DCOM + ACT + ENDW_COMM
    216   + ATMM + ATEE + TSSM + TSSD + TFF + AMARG + TRXM + AWW + REGHOUS + PRIV
    217   + PRODTAX + DIRTAX + GOVT + CGDS_COMM ;!
    218    
    219   !For gempack 10!
    220   Set ASAMAC1 #Special labels for SAM# = MCOM + DCOM ;
    221   Set ASAMAC2 #Special labels for SAM# = ACT + ENDW_COMM;
    222   Set ASAMAC3 #Special labels for SAM# = ATMM + ATEE;
    223   Set ASAMAC4 #Special labels for SAM# = TSSM + TSSD;
    224   Set ASAMAC5 #Special labels for SAM# = TFF + AMARG;
    225   Set ASAMAC6 #Special labels for SAM# = TRXM + AWW;
    226   Set ASAMAC7 #Special labels for SAM# = PRIV;
    227   Set ASAMAC8 #Special labels for SAM# = PRODTAX + DIRTAX;
    228   Set ASAMAC9 #Special labels for SAM# =GOVT + CGDS_COMM;
    229    
    230   Set ASAMAC10 #Special labels for SAM# = ASAMAC1 + ASAMAC2;
    231   Set ASAMAC11 #Special labels for SAM# = ASAMAC10 + ASAMAC3;
    232   Set ASAMAC12 #Special labels for SAM# = ASAMAC11 + ASAMAC4;
    233   Set ASAMAC13 #Special labels for SAM# = ASAMAC12 + ASAMAC5;
    234   Set ASAMAC14 #Special labels for SAM# = ASAMAC13 + ASAMAC6;
    235   Set ASAMAC15 #Special labels for SAM# = ASAMAC14 + ASAMAC7;
    236   Set ASAMAC16 #Special labels for SAM# = ASAMAC15 + ASAMAC8;
    237   Set ASAMAC #Special labels for SAM# = ASAMAC16 + ASAMAC9;
    238    
    239    
    240    
    241   !========================================================================!
    242   !                              Declare Mappings                          !
    243   !========================================================================!
    244    
    245   MAPPING (PROJECT) REGTMM from TMM to REG ;
    246   MAPPING (PROJECT) REGTEE from TEE to REG ;
    247   MAPPING (PROJECT) REGWW from WW to REG ;
    248   MAPPING (PROJECT) ACTCOM from ACT to TRAD_COMM ;
    249   MAPPING (PROJECT) COMMCOM from MCOM to TRAD_COMM ;
    250   MAPPING (PROJECT) MARGTRXM from TRXM to MARG_COMM ;
    251   MAPPING (PROJECT) COMTSSM from TSSM to TRAD_COMM ;
    252   MAPPING (PROJECT) COMTSSD from TSSD to TRAD_COMM ;
    253   MAPPING (PROJECT) FACTTFF from TFF to ENDW_COMM ;
    254   MAPPING (PROJECT) MARGTRMM from TRMM to MARG_COMM ;
    255   MAPPING (PROJECT) REGTRMM from TRMM to REG ;
    256   MAPPING (PROJECT) MARGAMARG from AMARG to MARG_COMM ;
    257    
    258   !========================================================================!
    259   !                      Reading Data from GTAP Database                    !
    260   !========================================================================!
    261    
    262   !Imported Commodities!
    263    
    264   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    265       VIFM_GT(i,j,r) #Firms' Imports at Market Prices#;
    266   Read
    267       VIFM_GT from file GTAPDATA header "VIFM";
    268    
    269   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    270       VIPM_GT(i,h,r) #Private Consumption of Imported Commodities Market Prices#;
    271   Read
    272       VIPM_GT from file GTAPDATA header "VIPM";
    273    
    274   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    275       VIGM_GT(i,r) #Government Consumption of Imported Commodities Market Prices#;
    276   Read
    277       VIGM_GT from file GTAPDATA header "VIGM";
    278   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    279       VIFA_GT(i,j,r) #Firms' Imports at Agent Prices#;
    280   Read
    281       VIFA_GT from file GTAPDATA header "VIFA";
    282    
    283   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    284       VIPA_GT(i,h,r) #Private Consumption of Imported Commodities Agent Prices#;
    285   Read
    286       VIPA_GT from file GTAPDATA header "VIPA";
    287    
    288   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    289       VIGA_GT(i,r) #Private Consumption of Imported Commodities Agent Prices#;
    290   Read
    291       VIGA_GT from file GTAPDATA header "VIGA";
    292    
    293   !Domestic Commodities!
    294   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    295       VDFM_GT(i,j,r) #Firms' Usage of Domestics at Market Prices#;
    296   Read
    297       VDFM_GT from file GTAPDATA header "VDFM";
    298    
    299   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    300       VDPM_GT(i,h,r) #Private Consumption of Domestic Commodities Market Prices#;
    301   Read
    302       VDPM_GT from file GTAPDATA header "VDPM";
    303    
    304   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    305       VDGM_GT(i,r) #Government Consumption of Imported Commodities Market Prices#;
    306   Read
    307       VDGM_GT from file GTAPDATA header "VDGM";
    308    
    309   Coefficient (all,i,MARG_COMM)(all,r,REG)
    310       VST_GT(i,r) #Marginal Domestic Commodities Market Prices#;
    311   Read
    312       VST_GT from file GTAPDATA header "VST";
    313   Coefficient (all,i,TRAD_COMM)(all,j,REG)(all,r,REG)
    314       VXWD_GT(i,j,r);
    315   Read
    316       VXWD_GT from file GTAPDATA header "VXWD";
    317   Coefficient (all,i,TRAD_COMM)(all,j,REG)(all,r,REG)
    318       VXMD_GT(i,j,r);
    319   Read
    320       VXMD_GT from file GTAPDATA header "VXMD";
    321    
    322   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    323       VDFA_GT(i,j,r) #Firms' Domestic Purchases at Agent Prices#;
    324   Read
    325       VDFA_GT from file GTAPDATA header "VDFA";
    326    
    327   Coefficient (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    328       VDPA_GT(i,h,r) #Private Consumption of Domestic Commodities Agent Prices#;
    329   Read
    330       VDPA_GT from file GTAPDATA header "VDPA";
    331    
    332   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    333       VDGA_GT(i,r) #Private Consumption of Domestic Commodities Agent Prices#;
    334   Read
    335       VDGA_GT from file GTAPDATA header "VDGA";
    336    
    337   !Factors!
    338   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    339       VFM_GT(i,j,r) #Factor Usage at Market Price#;
    340   Read
    341       VFM_GT from file GTAPDATA header "VFM";
    342   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    343       EVFA_GT(i,j,r)#Endowments: Firms Purchase at Agent Price#;
    344   Read
    345       EVFA_GT from file GTAPDATA header "EVFA";
    346   Coefficient (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)
    347       EVOA_GT(i,h,r)#Endowments: Outputs at Agent Price#;
    348   Read
    349       EVOA_GT from file GTAPDATA header "EVOA";
    350   Coefficient (all,i,FACTDEP)(all,h,HHLD)(all,r,REG)
    351       VDEP_GT(i,h,r)#Capital Depreciation#;
    352   Read
    353       VDEP_GT from file GTAPDATA header "VDEP";
    354    
    355   !Trade: Import!
    356   Coefficient (all,i,TRAD_COMM)(all,j,REG)(all,r,REG)
    357       VIMS_GT(i,j,r) #Import at Market Price#;
    358   Read
    359       VIMS_GT from file GTAPDATA header "VIMS";
    360    
    361   Coefficient (all,i,TRAD_COMM)(all,j,REG)(all,r,REG)
    362       VIWS_GT(i,j,r) #Import at World Price#;
    363   Read
    364       VIWS_GT from file GTAPDATA header "VIWS";
    365   !Transportation!
    366   Coefficient (all,i,MARG_COMM) (all,j,TRAD_COMM) (all,s,REG) (all,r,REG)
    367       VTWR_GT(i,j,s,r);
    368   Read
    369       VTWR_GT from file GTAPDATA header "VTWR";
    370   Coefficient (all,i,CGDS_COMM)(all,h,HHLD)(all,r,REG)
    371       SAVEH_GT(i,h,r);
    372   Read
    373       SAVEH_GT from file GTAPDATA header "SHLD";
    374   Coefficient (all,i,CGDS_COMM)(all,h,GOVT)(all,r,REG)
    375       SAVEG_GT(i,h,r);
    376   Read
    377       SAVEG_GT from file GTAPDATA header "SGOV";
    378    
    379   !Inter-regional transfers!
    380   Coefficient (all,h,HHLD)(all,r,REG)
    381       REMI_GT(h,r);
    382   Read
    383       REMI_GT from file GTAPDATA header "REMI";
    384   Coefficient (all,h,HHLD)(all,r,REG)
    385       REMO_GT(h,r);
    386   Read
    387       REMO_GT from file GTAPDATA header "REMO";
    388   Coefficient (all,h,HHLD)(all,r,REG)
    389       FYI_GT(h,r);
    390   Read
    391       FYI_GT from file GTAPDATA header "FYI";
    392   Coefficient (all,h,HHLD)(all,r,REG)
    393       FYO_GT(h,r);
    394   Read
    395       FYO_GT from file GTAPDATA header "FYO";
    396   Coefficient (all,r,REG)
    397       AIDI_GT(r);
    398   Read
    399       AIDI_GT from file GTAPDATA header "AIDI";
    400   Coefficient (all,r,REG)
    401       AIDO_GT(r);
    402   Read
    403       AIDO_GT from file GTAPDATA header "AIDO";
    404   Coefficient (all,h,HHLD)(all,r,REG)
    405       TRANG_GT(h,r);
    406   Read
    407       TRANG_GT from file GTAPDATA header "TRNG";
    408   Coefficient (all,h,HHLD)(all,s,HHLD)(all,r,REG)
    409       TRANH_GT(h,s,r);
    410   Read
    411       TRANH_GT from file GTAPDATA header "TRNH";
    412    
    413   !=========================================================================!
    414   !                       Preparing Data for SAM                            !
    415   !=========================================================================!
    416    
    417                   !=============================!
    418                   !Block 1. Imported Commodities!
    419                   !=============================!
    420   ! Usage of imported comodities by firms (1:3 in SAM)!
    421   Coefficient (all,i,MCOM)(all,j,ACT)(all,r,REG)
    422       VIAM(i,j,r);
    423   Formula (all, i,MCOM)(all, j, ACT) (all,r,REG)
    424       VIAM(i,j,r) = VIFM_GT(COMMCOM(i),ACTCOM(j),r);
    425   !Private Consumption of Imported Commodities(1:14 in SAM)!
    426   Coefficient (all,i,MCOM)(all,j,PRIV)(all,r,REG)
    427       VIPM(i,j,r);
    428   Formula (all,i,MCOM)(all,j,PRIV)(all,r,REG)
    429       VIPM(i,j,r)= VIPM_GT(COMMCOM(i),j,r);
    430   !Government Consumption of Imported Commodities(1:17 in SAM)!
    431   Coefficient (all,i,MCOM)(all,j,GOVT)(all,r,REG)
    432       VIGM(i,j,r);
    433   Formula (all,i,MCOM)(all,j,GOVT)(all,r,REG)
    434       VIGM(i,j,r)= VIGM_GT(COMMCOM(i),r);
    435   !Usage of imported capital good (1:18 in SAM)!
    436   Coefficient (all,i,MCOM)(all,j,CGDS_COMM)(all,r,REG)
    437       VIIM(i,j,r);
    438   Formula (all,i,MCOM)(all,j,CGDS_COMM)(all,r,REG)
    439       VIIM(i,j,r)= VIFM_GT(COMMCOM(i),j,r);
    440    
    441                   !=============================!
    442                   !Block 2. Domestic Commodities!
    443                   !=============================!
    444   !Usage of Domestic Comodities by firms (2:3 in SAM)!
    445   Coefficient (all,i,DCOM)(all,j,ACT)(all,r,REG)
    446       VDAM(i,j,r);
    447   Formula (all, i,DCOM)(all, j, ACT) (all,r,REG)
    448       VDAM(i,j,r)
    449            = VDFM_GT(COMDCOM(i),ACTCOM(j),r);
    450    
    451   !Private Consumption of Domestic Commodities(2:14 in SAM)!
    452   Coefficient (all,i,DCOM)(all,j,PRIV)(all,r,REG)
    453       VDPM(i,j,r);
    454   Formula (all,i,DCOM)(all,j,PRIV)(all,r,REG)
    455       VDPM(i,j,r) = VDPM_GT(COMDCOM(i),j,r);
    456    
    457   !Government Consumption of Domestic Commodities(2:17 in SAM)!
    458   Coefficient (all,i,DCOM)(all,j,GOVT)(all,r,REG)
    459       VDGM(i,j,r);
    460   Formula (all,i,DCOM)(all,j,GOVT)(all,r,REG)
    461       VDGM(i,j,r)= VDGM_GT(COMDCOM(i),r);
    462   !Usage of Domestic Capital Good (2:18 in SAM)!
    463   Coefficient (all,i,DCOM)(all,j,CGDS_COMM)(all,r,REG)
    464       VDIM(i,j,r);
    465   Formula (all,i,DCOM)(all,j,CGDS_COMM)(all,r,REG)
    466       VDIM(i,j,r)= VDFM_GT(COMDCOM(i),j,r);
    467   !Export of Margings (2:11 in SAM)!
    468   Coefficient (all,i,MARG_COMM)(all,j,MARG_COMM)(all,r,REG)
    469       VST_GT1(i,j,r);
    470   Formula (all,i,MARG_COMM)(all,r,REG)
    471       VST_GT1(i,i,r)= VST_GT(i,r);
    472   Coefficient (all,i,DCOM)(all,j,TRXM)(all,r,REG)
    473       VST(i,j,r);
    474   Formula (all,i,DCOM)(all,j,TRXM)(all,r,REG)
    475       VST(i,j,r)=0;
    476   Formula (all,i,MARG_DCOM) (all,j,TRXM) (all,r,REG)
    477       VST(i,j,r)= VST_GT1(MARGCOM(i),MARGTRXM(j),r);
    478   !Rest of World Consumption of Domestic Commodities!
    479   Coefficient (all,i,DCOM)(all,j,WW)(all,r,REG)
    480       VXWD(i,j,r);
    481   Formula (all,i,DCOM)(all,j,WW)(all,r,REG)
    482       VXWD(i,j,r) = VXWD_GT(COMDCOM(i),r,REGWW(j));
    483   !Aggregate Rest of World Consumption of Domestic Commodities(2:12 in SAM)!
    484   Coefficient (all,i,DCOM)(all,j,AWW)(all,r,REG)
    485       AVXWD(i,j,r);
    486   Formula (all,i,DCOM)(all,j,AWW)(all,r,REG)
    487       AVXWD(i,j,r)= sum{k,WW, VXWD(i,k,r)};
    488    
    489    
    490                   !=============================!
    491                   !      Block 3. Activities    !
    492                   !=============================!
    493   !Value of Output Market Price (3:2 in SAM)!
    494   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    495       VOM_GT(i,r);
    496   Formula (all,i,TRAD_COMM)(all,r,REG)
    497       VOM_GT(i,r)=sum{j,PROD_COMM,VDFM_GT(i,j,r)}+sum(h, HHLD, VDPM_GT(i,h,r))
    498                  +VDGM_GT(i,r)+
    499                   sum{s,REG,VXMD_GT(i,r,s)};
    500   Formula (all,i,MARG_COMM)(all,r,REG)
    501       VOM_GT(i,r)=sum{j,PROD_COMM,VDFM_GT(i,j,r)}+sum(h, HHLD, VDPM_GT(i,h,r))
    502                  +VDGM_GT(i,r)+
    503                   sum{s,REG,VXMD_GT(i,r,s)}+VST_GT(i,r);
    504   Coefficient (all,i,TRAD_COMM)(all,j,TRAD_COMM)(all,r,REG)
    505       VOM_GT1(i,j,r);
    506   Formula (all,i,TRAD_COMM)(all,r,REG)
    507       VOM_GT1(i,i,r)= VOM_GT(i,r);
    508   Coefficient (all,i,ACT)(all,j,DCOM)(all,r,REG)
    509       VOM(i,j,r)#Value of Output (3:2 in SAM)#;
    510   Formula (all,i,ACT)(all,j,DCOM)(all,r,REG)
    511       VOM(i,j,r)
    512           = VOM_GT1(ACTCOM(i),COMDCOM(j),r);
    513    
    514                   !=============================!
    515                   !   Block 4. Factors          !
    516                   !=============================!
    517   !Factor Usage (4:3 in SAM)!
    518   Coefficient (all,i,ENDW_COMM)(all,j,ACT)(all,r,REG)
    519       VFM(i,j,r);
    520   Formula (all,i,ENDW_COMM)(all,j,ACT)(all,r,REG)
    521       VFM(i,j,r)= VFM_GT(i,ACTCOM(j),r);
    522    
    523                   !=============================!
    524                   !   Block 5. Import Duties    !
    525                   !=============================!
    526    
    527   !Import Duties!
    528   Coefficient (all,j,TMM)(all,i,MCOM)(all,r,REG)
    529       IMD(j,i,r);
    530   Formula (all,j,TMM)(all,i,MCOM)(all,r,REG)
    531       IMD(j,i,r)
    532           = VIMS_GT(COMMCOM(i),REGTMM(j),r)
    533           - VIWS_GT(COMMCOM(i),REGTMM(j),r);
    534    
    535   !Aggregate Import Duties (5:1 in SAM)!
    536   Coefficient (all,j,ATMM)(all,i,MCOM)(all,r,REG)
    537       AIMD(j,i,r);
    538   Formula (all,j,ATMM)(all,i,MCOM)(all,r,REG)
    539       AIMD(j,i,r)=sum{k,TMM,IMD(k,i,r)};
    540    
    541                   !=============================!
    542                   !   Block 6. Export Taxes     !
    543                   !=============================!
    544    
    545   !Export Taxes!
    546   Coefficient (all,j,TEE)(all,i,DCOM)(all,r,REG)
    547       EXTAX(j,i,r);
    548   Formula (all,j,TEE)(all,i,DCOM)(all,r,REG)
    549       EXTAX(j,i,r) =VXWD_GT(COMDCOM(i),r,REGTEE(j))
    550               -VXMD_GT(COMDCOM(i),r,REGTEE(j));
    551    
    552   !Aggregate Export Taxes (6:1 in SAM)!
    553   Coefficient (all,j,ATEE)(all,i,DCOM)(all,r,REG)
    554       AEXTAX(j,i,r);
    555   Formula (all,j,ATEE)(all,i,DCOM)(all,r,REG)
    556       AEXTAX(j,i,r)=sum{k,TEE,EXTAX(k,i,r)};
    557    
    558                   !================================!
    559                   !   Block 7. Import Sales Taxes  !
    560                   !================================!
    561   !Import Sales Taxes on Intermediates Imports (7:3 in SAM)!
    562   Coefficient (all,i,TSSM)(all,j,ACT)(all,r,REG)
    563       TSSMA(i,j,r);
    564   Formula (all,i,TSSM)(all,j,ACT)(all,r,REG)
    565       TSSMA(i,j,r)= VIFA_GT(COMTSSM(i),ACTCOM(j),r)
    566              -VIFM_GT(COMTSSM(i),ACTCOM(j),r);
    567   !Import Sales Taxes on Foreign Investment (7:18 in SAM)!
    568   Coefficient (all,i,TSSM)(all,j,CGDS_COMM)(all,r,REG)
    569       TSSMK(i,j,r);
    570   Formula (all,i,TSSM)(all,j,CGDS_COMM)(all,r,REG)
    571       TSSMK(i,j,r)= VIFA_GT(COMTSSM(i),j,r)-VIFM_GT(COMTSSM(i),j,r);
    572   !Import Sales Taxes on Private Consumption (7:14 in SAM)!
    573   Coefficient (all,i,TSSM)(all,j,PRIV)(all,r,REG)
    574       TSSMH(i,j,r);
    575   Formula (all,i,TSSM)(all,j,PRIV)(all,r,REG)
    576       TSSMH(i,j,r)= VIPA_GT(COMTSSM(i),j,r)-VIPM_GT(COMTSSM(i),j,r);
    577   !Import Sales Taxes on Governmnet Consumption (7:17 in SAM)!
    578   Coefficient (all,i,TSSM)(all,j,GOVT)(all,r,REG)
    579       TSSMG(i,j,r);
    580   Formula (all,i,TSSM)(all,j,GOVT)(all,r,REG)
    581       TSSMG(i,j,r)= VIGA_GT(COMTSSM(i),r)-VIGM_GT(COMTSSM(i),r);
    582    
    583                   !================================!
    584                   ! Block 8. Domestic Sales Taxes  !
    585                   !================================!
    586   !Domestic Sales Taxes on Intermediates (8:3 in SAM)!
    587   Coefficient (all,i,TSSD)(all,j,ACT)(all,r,REG)
    588       TSSDA(i,j,r);
    589   Formula (all,i,TSSD)(all,j,ACT)(all,r,REG)
    590       TSSDA(i,j,r)= VDFA_GT(COMTSSD(i),ACTCOM(j),r)
    591                     -VDFM_GT(COMTSSD(i),ACTCOM(j),r);
    592   !Domestic Sales Taxes on Investment (8:18 in SAM)!
    593   Coefficient (all,i,TSSD)(all,j,CGDS_COMM)(all,r,REG)
    594       TSSDK(i,j,r);
    595   Formula (all,i,TSSD)(all,j,CGDS_COMM)(all,r,REG)
    596       TSSDK(i,j,r)= VDFA_GT(COMTSSD(i),j,r)
    597                   - VDFM_GT(COMTSSD(i),j,r);
    598   !Domestic Sales Taxes on Private Consumption (8:14 in SAM)!
    599   Coefficient (all,i,TSSD)(all,j,PRIV)(all,r,REG)
    600       TSSDH(i,j,r);
    601   Formula (all,i,TSSD)(all,j,PRIV)(all,r,REG)
    602       TSSDH(i,j,r)= VDPA_GT(COMTSSD(i),j,r)-VDPM_GT(COMTSSD(i),j,r);
    603   !Domestic Sale Taxes on Governmnet Consumption (8:17 in SAM)!
    604   Coefficient (all,i,TSSD)(all,j,GOVT)(all,r,REG)
    605       TSSDG(i,j,r)#Import Sale Taxes on Governmnet Consumption (7:16 in SAM)#;
    606   Formula (all,i,TSSD)(all,j,GOVT)(all,r,REG)
    607       TSSDG(i,j,r)= VDGA_GT(COMTSSD(i),r)-VDGM_GT(COMTSSD(i),r);
    608    
    609                   !================================!
    610                   !   Block 9. Factor Taxes        !
    611                   !================================!
    612   !Factor Taxes (9:3 in SAM)!
    613   Coefficient (all,i,TFF)(all,j,ACT)(all,r,REG)
    614       TFFA(i,j,r)#Factor Taxes#;
    615   Formula (all,i,TFF)(all,j,ACT)(all,r,REG)
    616       TFFA(i,j,r)= EVFA_GT(FACTTFF(i),ACTCOM(j),r)
    617                  -VFM_GT(FACTTFF(i),ACTCOM(j),r);
    618    
    619                   !================================!
    620                   !   Block 10. Import Margins     !
    621                   !================================!
    622   !Import Margins!
    623   Coefficient (all,i,MARG_COMM) (all,j,MCOM) (all,s,REG) (all,r,REG)
    624       VTWR_GT1(i,j,s,r);
    625   Formula (all,i,MARG_COMM) (all,j,MCOM) (all,s,REG) (all,r,REG)
    626       VTWR_GT1(i,j,s,r)= VTWR_GT(i,COMMCOM(j),s,r);
    627   Coefficient (all,j,TRMM) (all,i,MCOM) (all,r,REG)
    628       VTWR(j,i,r);
    629   Formula (all,j,TRMM) (all,i,MCOM) (all,r,REG)
    630       VTWR(j,i,r)= VTWR_GT1(MARGTRMM(j),i,REGTRMM(j),r);
    631    
    632   !Aggregate Import Margins (10:1 in SAM)!
    633   Coefficient (all,j,AMARG) (all,i,MCOM) (all,r,REG)
    634       AVTWR(j,i,r);
    635   Formula (all,j,AMARG) (all,i,MCOM) (all,r,REG)
    636       AVTWR(j,i,r) = sum(s, REG, VTWR_GT1(MARGAMARG(j),i,s,r)) ;
    637    
    638    
    639                   !================================!
    640                   !   Block 11. Export Margins     !
    641                   !================================!
    642   !Export Margins!
    643   Coefficient (all,i,TRXM) (all,s,REG) (all,r,REG)
    644       VTWR_X(i,s,r);
    645   Formula (all,i,TRXM) (all,s,REG) (all,r,REG)
    646       VTWR_X(i,s,r)=sum{j,TRAD_COMM,VTWR_GT(MARGTRXM(i),j,s,r)};
    647   Coefficient (all,i,TRXM)(all,j,TRMM)(all,r,reg)
    648       VTWR_EX(i,j,r);
    649   Formula (all,i,TRXM)(all,j,TRMM)(all,r,reg)
    650       VTWR_EX(i,j,r)=0;
    651   Formula (all,i,TRXM)(all,j,TRMM)(all,r,reg: MARGTRXM(i)=MARGTRMM(j))
    652       VTWR_EX(i,j,r) = VTWR_X(i,REGTRMM(j),r);
    653    
    654   !Aggregate Export Margins (11:10 in SAM)!
    655   Coefficient (all,i,TRXM)(all,j,AMARG)(all,r,reg)
    656       AVTWR_EX(i,j,r);
    657   Formula (all,i,TRXM)(all,j,AMARG)(all,r,reg)
    658       AVTWR_EX(i,j,r)=sum {k,TRMM: MARGTRMM(k)=MARGAMARG(j), VTWR_EX(i,k,r)};
    659    
    660                   !================================!
    661                   !   Block 12. Rest of World      !
    662                   !================================!
    663   !Rest of World (12:1 in SAM)!
    664   Coefficient (all,j,WW) (all,i,MCOM) (all,r,REG)
    665       WWM(j,i,r);
    666   Formula (all,j,WW) (all,i,MCOM) (all,r,REG)
    667       WWM(j,i,r)= VIWS_GT(COMMCOM(i),REGWW(j),r)
    668          -sum{l,MARG_COMM ,VTWR_GT(l,COMMCOM(i),REGWW(j),r)};
    669    
    670   !Aggregate Rest of World (12:1 in SAM)!
    671   Coefficient (all,j,AWW)(all,i,MCOM)(all,r,REG)
    672       AWWM(j,i,r);
    673   Formula (all,j,AWW)(all,i,MCOM)(all,r,REG)
    674       AWWM(j,i,r)=sum{k,WW,WWM(k,i,r)};
    675    
    676    
    677                   !================================!
    678                   !   Block 18. Capital            !
    679                   !================================!
    680   !Capital: Value of Depreciation (18:4 in SAM)!
    681   Coefficient (all,i,CGDS_COMM)(all,j,ENDW_COMM)(all,r,REG)
    682       VDEP(i,j,r);
    683   Formula (all,i,CGDS_COMM)(all,j,ENDW_COMM)(all,r,REG)
    684       VDEP(i,j,r)=0;
    685   Formula (all,i,CGDS_COMM)(all,j,FACTDEP)(all,r,REG)
    686       VDEP(i,j,r)=sum(h, HHLD, VDEP_GT(j,h,r));
    687   !Capital: Saving (18:13 in SAM)!
    688   Coefficient (all,i,CGDS_COMM)(all,j,PRIV)(all,r,REG)
    689       SAVEH(i,j,r);
    690   Formula (all,i,CGDS_COMM)(all,j,PRIV)(all,r,REG)
    691       SAVEH(i,j,r) = SAVEH_GT(i,j,r);
    692    
    693   Coefficient (all,i,CGDS_COMM)(all,j,GOVT)(all,r,REG)
    694       SAVEG(i,j,r);
    695   Formula (all,i,CGDS_COMM)(all,j,GOVT)(all,r,REG)
    696       SAVEG(i,j,r)=SAVEG_GT(i,j,r);
    697   !Capital:Transportation (18:11 in SAM)!
    698   Coefficient (all,i,CGDS_COMM)(all,j,TRXM)(all,r,REG)
    699       CAPTR(i,j,r);
    700   Formula (all,i,CGDS_COMM)(all,j,TRXM)(all,r,REG)
    701       CAPTR(i,j,r)=sum{c,TRAD_COMM,sum{s,REG,
    702                    VTWR_GT(MARGTRXM(j),c,s,r)}}-
    703                    sum{d,DCOM,VST(d,j,r)};
    704   !Capital:Rest of World!
    705   Coefficient (all,i,CGDS_COMM)(all,j,WW)(all,r,REG)
    706       CAPWW(i,j,r);
    707   Formula (all,i,CGDS_COMM)(all,j,WW)(all,r,REG)
    708       CAPWW(i,j,r)=sum{k,TRAD_COMM,VIWS_GT(k,REGWW(j),r)}
    709               -sum{m,MARG_COMM,sum{c,TRAD_COMM,
    710              VTWR_GT(m,c,REGWW(j),r)}}
    711               -sum{d,DCOM,VXWD(d,j,r)} ;
    712    
    713   Coefficient  (all,j,AWW) (all,i,PRIV) (all,r,REG)
    714       FINCI(i,j,r)#Regional Household: Factors#;
    715   Formula (all,j,AWW) (all,i,PRIV) (all,r,REG)
    716       FINCI(i,j,r)= FYI_GT(i,r) + REMI_GT(i,r);
    717    
    718   Coefficient  (all,i,AWW) (all,j,PRIV) (all,r,REG)
    719       FINCO(i,j,r)#Regional Household: Factors#;
    720   Formula (all,i,AWW) (all,j,PRIV) (all,r,REG)
    721       FINCO(i,j,r)= FYO_GT(j,r) + REMO_GT(j,r);
    722    
    723   Coefficient  (all,j,AWW) (all,i,GOVT) (all,r,REG)
    724       AIDI(i,j,r)#Regional Household: Factors#;
    725   Formula (all,j,AWW) (all,i,GOVT) (all,r,REG)
    726       AIDI(i,j,r)= AIDI_GT(r);
    727    
    728   Coefficient  (all,i,AWW) (all,j,GOVT) (all,r,REG)
    729       AIDO(i,j,r)#Regional Household: Factors#;
    730   Formula (all,i,AWW) (all,j,GOVT) (all,r,REG)
    731       AIDO(i,j,r)= AIDO_GT(r);
    732    
    733   Coefficient (all,i,CGDS_COMM)(all,j,AWW)(all,r,REG)
    734       ACAPWW1(i,j,r);
    735   Formula (all,i,CGDS_COMM)(all,j,AWW)(all,r,REG)
    736       ACAPWW1(i,j,r)= sum(h, HHLD, FINCO(j,h,r)) - sum(h, HHLD, FINCI(h,j,r))
    737              + sum(g, GOVT, AIDO(j,g,r)) - sum(g, GOVT, AIDI(g,j,r)) ;
    738    
    739   !Capital:Aggregate Rest of World (18:12 in SAM)!
    740   Coefficient (all,i,CGDS_COMM)(all,j,AWW)(all,r,REG)
    741       ACAPWW(i,j,r);
    742   Formula (all,i,CGDS_COMM)(all,j,AWW)(all,r,REG)
    743       ACAPWW(i,j,r)=sum{k,WW,CAPWW(i,k,r)} + ACAPWW1(i,j,r);
    744    
    745                   !================================!
    746                   !   Block 15. Production Taxes   !
    747                   !================================!
    748   !Production Tax on Activities (15:3 in SAM)!
    749   Coefficient (all,i,PRODTAX) (all,j,ACT) (all,r,REG)
    750       PTAXACT(i,j,r);
    751   Formula (all,i,PRODTAX) (all,j,ACT) (all,r,REG)
    752       PTAXACT(i,j,r)=sum{d,DCOM,VOM(j,d,r)}-
    753                   [sum{m,MCOM,VIAM(m,j,r)}+sum{c,DCOM,VDAM(c,j,r)}
    754                   +sum{k,ENDW_COMM,VFM(k,j,r)}
    755                   +sum{t,TSSM,TSSMA(t,j,r)}+sum{s,TSSD,TSSDA(s,j,r)}
    756                   +sum{f,TFF,TFFA(f,j,r)}];
    757   !Production Tax on Investment (15:18 in SAM)!
    758   Coefficient (all,i,PRODTAX) (all,j,CGDS_COMM) (all,r,REG)
    759       PTAXINV(i,j,r);
    760   Formula (all,i,PRODTAX) (all,j,CGDS_COMM) (all,r,REG)
    761       PTAXINV(i,j,r)=sum{f,ENDW_COMM,VDEP(j,f,r)}+sum{h,PRIV,SAVEH(j,h,r)}
    762                      +sum{h,GOVT,SAVEG(j,h,r)}
    763                      +sum{t,TRXM,CAPTR(j,t,r)}+sum{w,WW,CAPWW(j,w,r)}
    764                      +sum(w,AWW,ACAPWW1(j,w,r))-
    765                      sum{c,MCOM,VIIM(c,j,r)}-sum{d,DCOM,VDIM(d,j,r)}-
    766                      sum{m,TSSM,TSSMK(m,j,r)}-sum{s,TSSD,TSSDK(s,j,r)};
    767    
    768                   !================================!
    769                   !   Block 13. Regional Household !
    770                   !================================!
    771    
    772   !Private Household: Factors (13:4 in SAM)!
    773   Coefficient  (all,i,PRIV) (all,j,ENDW_COMM) (all,r,REG)
    774       HF(i,j,r)#Regional Household: Factors#;
    775   Formula (all,i,PRIV) (all,j,ENDW_COMM) (all,r,REG)
    776       HF(i,j,r)=EVOA_GT(j,i,r) ;
    777   Formula (all,i,PRIV) (all,j,FACTDEP) (all,r,REG)
    778       HF(i,j,r)=EVOA_GT(j,i,r)-VDEP_GT(j,i,r);
    779    
    780   Coefficient  (all,i,PRIV) (all,j,PRIV) (all,r,REG)
    781       HTRANS(i,j,r)#Regional Household: Factors#;
    782   Formula  (all,i,PRIV) (all,j,PRIV) (all,r,REG)
    783       HTRANS(i,j,r)=TRANH_GT(j,i,r);
    784    
    785   Coefficient  (all,j,GOVT) (all,i,PRIV) (all,r,REG)
    786       GTRANS(i,j,r)#Regional Household: Factors#;
    787   Formula  (all,j,GOVT) (all,i,PRIV) (all,r,REG)
    788       GTRANS(i,j,r)=TRANG_GT(i,r);
    789    
    790    
    791                   !================================!
    792                   !   Block 16. Direct Taxes       !
    793                   !================================!
    794   !Direct Tax on Factors (16:4 in SAM)!
    795    
    796   Coefficient (all,i,DIRTAX) (all,j,ENDW_COMM)(all,r,REG)
    797       DTAX(i,j,r);
    798   Formula (all,i,DIRTAX) (all,j,ENDW_COMM)(all,r,REG)
    799       DTAX(i,j,r)=sum{a,ACT,VFM(j,a,r)}-sum{h,PRIV,HF(h,j,r)}
    800       -sum{k,CGDS_COMM,VDEP(k,j,r)};
    801    
    802               !======================================!
    803               !Block 13. Regional Household: Continue!
    804               !======================================!
    805    
    806   !Regional Household: Import Duties (13:5 in SAM!
    807   Coefficient  (all,i,GOVT) (all,j,TMM) (all,r,REG)
    808       RHTMM(i,j,r)#Regional Household: Import Taxes#;
    809   Formula (all,i,GOVT) (all,j,TMM) (all,r,REG)
    810       RHTMM(i,j,r)=sum{k,MCOM,IMD(j,k,r)};
    811   !Regional Household: Export Taxes (13:6 in SAM)!
    812   Coefficient  (all,i,GOVT) (all,j,TEE) (all,r,REG)
    813       RHTEE(i,j,r)#Regional Household: Import Taxes#;
    814   Formula (all,i,GOVT) (all,j,TEE) (all,r,REG)
    815       RHTEE(i,j,r)=sum{k,DCOM,EXTAX(j,k,r)};
    816   !Regional Household: Import Sales Taxes (13:7 in SAM)!
    817   !Regional Household: Import Duties (13:5 in SAM)!
    818   Coefficient  (all,i,GOVT) (all,j,ATMM) (all,r,REG)
    819       ARHTMM(i,j,r)#Regional Household: Aggregate Import Taxes#;
    820   Formula (all,i,GOVT) (all,j,ATMM) (all,r,REG)
    821       ARHTMM(i,j,r)=sum{k,MCOM,AIMD(j,k,r)};
    822   !Regional Household: Export Taxes (13:6 in SAM)!
    823   Coefficient  (all,i,GOVT) (all,j,ATEE) (all,r,REG)
    824       ARHTEE(i,j,r)#Regional Household: Aggregate Export Taxes#;
    825   Formula (all,i,GOVT) (all,j,ATEE) (all,r,REG)
    826       ARHTEE(i,j,r)=sum{k,DCOM,AEXTAX(j,k,r)};
    827   !Regional Household: Import Sales Taxes (13:7 in SAM)!
    828   Coefficient  (all,i,GOVT) (all,j,TSSM) (all,r,REG)
    829       RHTSSM(i,j,r)#Regional Household: Import Sales Taxes#;
    830   Formula (all,i,GOVT) (all,j,TSSM) (all,r,REG)
    831       RHTSSM(i,j,r)=sum{a,ACT,TSSMA(j,a,r)}+sum{g,GOVT,TSSMG(j,g,r)}+
    832                   sum{s,PRIV,TSSMH(j,s,r)}+sum{k,CGDS_COMM,TSSMK(j,k,r)};
    833   !Regional Household: Domestic Sales Taxes (13:8 in SAM)!
    834   Coefficient  (all,i,GOVT) (all,j,TSSD) (all,r,REG)
    835       RHTSSD(i,j,r)#Regional Household: Domestic Sales Taxes#;
    836   Formula (all,i,GOVT) (all,j,TSSD) (all,r,REG)
    837       RHTSSD(i,j,r)=sum{a,ACT,TSSDA(j,a,r)}+sum{g,GOVT,TSSDG(j,g,r)}+
    838                   sum{s,PRIV,TSSDH(j,s,r)}+sum{k,CGDS_COMM,TSSDK(j,k,r)};
    839   !Regional Household: Factor Taxes (13:9 in SAM)!
    840   Coefficient  (all,i,GOVT) (all,j,TFF) (all,r,REG)
    841       RHTFF(i,j,r)#Regional Household: Factor Taxes#;
    842   Formula (all,i,GOVT) (all,j,TFF) (all,r,REG)
    843       RHTFF(i,j,r)=sum{a,ACT,TFFA(j,a,r)};
    844   !Regional Household: Production Taxes (13:15 in SAM)!
    845   Coefficient  (all,i,GOVT) (all,j,PRODTAX) (all,r,REG)
    846       RHTPT(i,j,r)#Regional Household: Production Taxes#;
    847   Formula (all,i,GOVT) (all,j,PRODTAX) (all,r,REG)
    848       RHTPT(i,j,r)=sum{a,ACT,PTAXACT(j,a,r)}+sum{k,CGDS_COMM,PTAXINV(j,k,r)};
    849   !Regional Household: Direct Taxes (13:16 in SAM)!
    850   Coefficient  (all,i,GOVT) (all,j,DIRTAX) (all,r,REG)
    851       RHTDT(i,j,r)#Regional Household: Direct Taxes#;
    852   Formula (all,i,GOVT) (all,j,DIRTAX) (all,r,REG)
    853       RHTDT(i,j,r)=sum{f,ENDW_COMM,DTAX(j,f,r)};
