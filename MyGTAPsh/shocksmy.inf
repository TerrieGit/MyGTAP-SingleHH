      1   !_______________________________SHOCKS.TAB FILE ______________________________!
      2   !                                                                             !
      3   !                        Global Trade Analysis Project                        !
      4   !                         The GTAP Modeling Framework                         !
      5   !                              version 1997                                   !
      6   !_____________________________________________________________________________!
      7   !-----------------------------------------------------------------------------!
      8   ! HISTORY of SHOCKS.TAB                                                       !
      9   !-----------------------------------------------------------------------------!
     10   ! Version 1    July 1994   (Used in GTAP Short Course, July-August 1994)
     11     Version 2    Nov. 1995   (Augments endowments to accommodate v.4 data.
     12   			    Display file is also eliminated, since this
     13                               information can be accessed via GTAPVIEW)
     14                  Feb, 2006    removed "max size" keywords,
     15                               turned comments into # ... # text  !
     16    
     17   !-----------------------------------------------------------------------------!
     18   ! This file reads in any of the GTAP data sets and associated set
     19     specifications and computes the shocks needed to remove existing policies.
     20     These shocks are written to text files which may then be edited in order to
     21     achieve partial liberalization. Or, make your own version of this
     22     program to compute your special shocks !
     23   !-----------------------------------------------------------------------------!
     24    
     25   File GTAPSETS # File with set specification #;
     26    
     27   Set
     28    REG # Regions # read elements from file GTAPSETS header "H1";
     29    HHLD # Households # read elements from file GTAPSETS header "HOU";
     30    TRAD_COMM # Traded commodities # read elements from file GTAPSETS header "H2";
     31    ENDW_COMM # Endowment commodities #
     32      read elements from file GTAPSETS header "H6";
     33    CGDS_COMM # Capital goods commodities #
     34      read elements from file GTAPSETS header "H9";
     35    ENDWC_COMM # Capital Endowment Commodity # (capital);
     36    PROD_COMM # Produced commodities # = TRAD_COMM union CGDS_COMM;
     37    DEMD_COMM # Demanded commodities # = ENDW_COMM union TRAD_COMM;
     38    NSAV_COMM # Non-savings commodities # = DEMD_COMM union CGDS_COMM;
     39    MARG_COMM # Margin commodities #
     40      read elements from file GTAPSETS header "MARG";
     41   Subset
     42    MARG_COMM is subset of TRAD_COMM;
     43    PROD_COMM is subset of NSAV_COMM;
     44    ENDWC_COMM is subset of NSAV_COMM;
     45   Set
     46    NMRG_COMM # Non-margin commodities # = TRAD_COMM - MARG_COMM;
     47    
     48   !-----------------------------------------------------------------------------!
     49   ! FILES                                                                       !
     50   !-----------------------------------------------------------------------------!
     51    
     52   File GTAPDATA # The file containing all base data. #;
     53    
     54   !-----------------------------------------------------------------------------!
     55   !              base revenues and expenditures at agent's prices               !
     56   !-----------------------------------------------------------------------------!
     57    
     58   Coefficient
     59    (all,i,ENDW_COMM)(all,h,HHLD)(all,r,REG)                    EVOA(i,h,r)
     60        # Value of commodity i output in region r. #;
     61    
     62    (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)   EVFA(i,j,r)
     63        # Producer expenditure on i by ind j in r, valued at agent's prices #;
     64    
     65    (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)   VIFA(i,j,r)
     66        # Purchases of imported i r for use in j in region r #;
     67    
     68    (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)   VDFA(i,j,r)
     69        # Purchases of domestic i r for use in j in region r #;
     70    
     71    (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)                    VIPA(i,h,r)
     72        # Private household expenditure on imported i #;
     73    
     74    (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)                    VDPA(i,h,r)
     75        # Private household expenditure on domestic i in r #;
     76    
     77    (all,i,TRAD_COMM)(all,r,REG)                    VIGA(i,r)
     78        # Government household expenditure on imported i #;
     79    
     80    (all,i,TRAD_COMM)(all,r,REG)                    VDGA(i,r)
     81        # Government household expenditure on domestic i in r #;
     82    
     83   !-----------------------------------------------------------------------------!
     84   !               base revenues and expenditures at market prices               !
     85   !-----------------------------------------------------------------------------!
     86    
     87   Coefficient
     88    (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)            VXMD(i,r,s)
     89        # Exports of i from r to s valued at market prices (tradeables only)  #;
     90    
     91    (all,i,MARG_COMM)(all,r,REG)                       VST(i,r)
     92        # Margin good i from r used for international transport (market prices) #;
     93    
     94    (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)      VFM(i,j,r)
     95        # Producer expenditure on i by industry j in r, valued at market prices #;
     96    
     97    (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      VIFM(i,j,r)
     98        #  Purchases of imports i for use in j in region r #;
     99    
    100    (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)      VDFM(i,j,r)
    101        # Purchases of domestic i r for use in j in region r #;
    102    
    103    (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)                       VIPM(i,h,r)
    104        # Private household expenditure on i in r #;
    105    
    106    (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)                       VDPM(i,h,r)
    107        # Private household expenditure on domestic i in r #;
    108    
    109    (all,i,TRAD_COMM)(all,r,REG)                       VIGM(i,r)
    110        # Gov't household expenditure on i in r #;
    111    
    112    (all,i,TRAD_COMM)(all,r,REG)                       VDGM(i,r)
    113        # Government household expenditure on domestic i in r #;
    114    
    115    (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)             VIMS(i,r,s)
    116        # Imports of commodity i from r to s, valued at domestic market prices #;
    117    
    118   !-----------------------------------------------------------------------------!
    119   !              base revenues and expenditures at world prices                 !
    120   !-----------------------------------------------------------------------------!
    121    
    122   Coefficient
    123    (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)             VXWD(i,r,s)
    124        # Exports of i from r to s valued fob (tradeables only) #;
    125    
    126    (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)             VIWS(i,r,s)
    127        # Imports of commodity i from r to s, valued cif (tradeables only)  #;
    128    
    129   !-----------------------------------------------------------------------------!
    130   !                   Reading basedata.                                         !
    131   !-----------------------------------------------------------------------------!
    132    
    133   Read
    134    EVOA from file GTAPDATA header "EVOA";
    135    EVFA from file GTAPDATA header "EVFA";
    136    VIFA from file GTAPDATA header "VIFA";
    137    VDFA from file GTAPDATA header "VDFA";
    138    VIPA from file GTAPDATA header "VIPA";
    139    VDPA from file GTAPDATA header "VDPA";
    140    VIGA from file GTAPDATA header "VIGA";
    141    VDGA from file GTAPDATA header "VDGA";
    142    VXMD from file GTAPDATA header "VXMD";
    143    VST  from file GTAPDATA header "VST";
    144    VFM  from file GTAPDATA header "VFM";
    145    VIFM from file GTAPDATA header "VIFM";
    146    VDFM from file GTAPDATA header "VDFM";
    147    VIPM from file GTAPDATA header "VIPM";
    148    VDPM from file GTAPDATA header "VDPM";
    149    VIGM from file GTAPDATA header "VIGM";
    150    VDGM from file GTAPDATA header "VDGM";
    151    VIMS from file GTAPDATA header "VIMS";
    152    VXWD from file GTAPDATA header "VXWD";
    153    VIWS from file GTAPDATA header "VIWS";
    154    
    155   !-----------------------------------------------------------------------------!
    156   !                   DERIVATIVES OF THE BASE DATA                              !
    157   !-----------------------------------------------------------------------------!
    158    
    159   Zerodivide (zero_by_zero) default 0;
    160   Zerodivide (NONZERO_BY_ZERO) default 0;
    161    
    162   Coefficient (all,i,DEMD_COMM)(all,j,PROD_COMM)(all,r,REG)        VFA(i,j,r)
    163    # Producer expenditure on i by ind j in r, valued at agent's prices #;
    164    
    165   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    166           VFA(i,j,r) = EVFA(i,j,r);
    167    
    168   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    169           VFA(i,j,s) = VDFA(i,j,s) + VIFA(i,j,s);
    170    
    171   Coefficient (all,i,NSAV_COMM)(all,r,REG)                         VOA(i,r)
    172    # Value of commodity i output in region r #;
    173    
    174   Formula (all,i,ENDW_COMM)(all,r,REG) VOA(i,r) = sum(h, HHLD, EVOA(i,h,r));
    175    
    176   Formula (all,i,PROD_COMM)(all,r,REG)
    177           VOA(i,r) = sum{j,DEMD_COMM, VFA(j,i,r)};
    178    
    179   Coefficient (all,i,TRAD_COMM)(all,r,REG)                         VDM(i,r)
    180    # Domestic sales of com i in r valued at market prices (tradeables only) #;
    181    
    182   Formula (all,i,TRAD_COMM)(all,r,REG)
    183           VDM(i,r) = sum(h, HHLD, VDPM(i,h,r)) + VDGM(i,r)
    184                    + sum{j,PROD_COMM, VDFM(i,j,r)};
    185    
    186   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    187       VOM(i,r) # Value of commodity i output in region r at market prices #;
    188   Formula (all,i,ENDW_COMM)(all,r,REG)
    189       VOM(i,r) = sum{j,PROD_COMM, VFM(i,j,r)};
    190   Formula (all,i,MARG_COMM)(all,r,REG)
    191       VOM(i,r) = VDM(i,r) + sum{s,REG, VXMD(i,r,s)} + VST(i,r);
    192   Formula (all,i,NMRG_COMM)(all,r,REG)
    193       VOM(i,r) = VDM(i,r) + sum{s,REG, VXMD(i,r,s)};
    194   Formula (all,h,CGDS_COMM)(all,r,REG)
    195       VOM(h,r) = VOA(h,r);
    196    
    197   Zerodivide default 1;
    198    
    199   ! GTAP's tax variables are defined as [% changes in] POWERS
    200     (the power is the ratio of the taxed to untaxed flows).
    201     Here we calculate:
    202       the original value of the power:  "_L" coefficients
    203       the % change in the power needed to eliminate the tax :  "_HAT" coefficients
    204          ie, to make the power=1          !
    205    
    206   Coefficient  (all,i,NSAV_COMM)(all,r,REG)  TO_L(i,r)
    207    # benchmark power: output (or income) tax in region r #;
    208   Formula (all,i,NSAV_COMM)(all,r,REG)
    209        TO_L(i,r) = VOA(i,r)/VOM(i,r);
    210   Coefficient  (all,i,NSAV_COMM)(all,r,REG)  TO_HAT(i,r)
    211    # shock to remove all output (or income) tax in region r #;
    212   Formula  (all,i,NSAV_COMM)(all,r,REG)
    213        TO_HAT(i,r) = 100*[1-TO_L(i,r)] / TO_L(i,r);
    214   ! above formula is formula for % change:  100*[New-Old]/Old
    215     In this case we want New=1. Suppose you wanted 20% tax, you might write:
    216        TO_HAT(i,r) = {[1.2-TO_L(i,r)] / TO_L(i,r)} * 100;    !
    217    
    218   Coefficient  (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)  TF_L(i,j,r)
    219    # benchmark power: tax on primary factor i used by j in region r #;
    220   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    221        TF_L(i,j,r) = VFA(i,j,r)/VFM(i,j,r);
    222   Coefficient  (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)  TF_HAT(i,j,r)
    223    # shock to remove all tax on primary factor i used by j in region r #;
    224   Formula  (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    225        TF_HAT(i,j,r) = 100*[1-TF_L(i,j,r)] / TF_L(i,j,r);
    226    
    227   Coefficient  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)  TPD_L(i,h,r)
    228    # benchmark power: tax on private cons. of dom. #;
    229   Formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    230        TPD_L(i,h,r) = VDPA(i,h,r)/VDPM(i,h,r);
    231   Coefficient  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)  TPD_HAT(i,h,r)
    232    # shock to remove all tax on private cons. of dom. #;
    233   Formula  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    234        TPD_HAT(i,h,r) = 100*[1-TPD_L(i,h,r)] / TPD_L(i,h,r);
    235    
    236   Coefficient  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG) TPI_L(i,h,r)
    237    # benchmark power: tax on private cons. of imp. [tpm] #;
    238   Formula (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    239        TPI_L(i,h,r) = VIPA(i,h,r)/VIPM(i,h,r);
    240   Coefficient  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG) TPI_HAT(i,h,r)
    241    # shock to remove all tax on private cons. of imp. [tpm] #;
    242   Formula  (all,i,TRAD_COMM)(all,h,HHLD)(all,r,REG)
    243        TPI_HAT(i,h,r) = 100*[1-TPI_L(i,h,r)] / TPI_L(i,h,r);
    244    
    245   Coefficient  (all,i,TRAD_COMM)(all,r,REG)  TGD_L(i,r)
    246    # benchmark power: tax on gov cons. of dom. #;
    247   Formula (all,i,TRAD_COMM)(all,r,REG)
    248        TGD_L(i,r) = VDGA(i,r)/VDGM(i,r);
    249   Coefficient  (all,i,TRAD_COMM)(all,r,REG)  TGD_HAT(i,r)
    250    # shock to remove all tax on gov cons. of dom. #;
    251   Formula  (all,i,TRAD_COMM)(all,r,REG)
    252        TGD_HAT(i,r) = 100*[1-TGD_L(i,r)] / TGD_L(i,r);
    253    
    254   Coefficient  (all,i,TRAD_COMM)(all,r,REG) TGI_L(i,r)
    255    # benchmark power: tax on gov cons. of dom. [tgm] #;
    256   Formula (all,i,TRAD_COMM)(all,r,REG)
    257        TGI_L(i,r) = VIGA(i,r)/VIGM(i,r);
    258   Coefficient  (all,i,TRAD_COMM)(all,r,REG) TGI_HAT(i,r)
    259    # shock to remove all tax on gov cons. of dom. [tgm] #;
    260   Formula  (all,i,TRAD_COMM)(all,r,REG)
    261        TGI_HAT(i,r) = 100*[1-TGI_L(i,r)] / TGI_L(i,r);
    262    
    263   Coefficient  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)  TFD_L(i,j,r)
    264    # benchmark power: tax on domestic i purchased by firm j in r #;
    265   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    266        TFD_L(i,j,r) = VDFA(i,j,r)/VDFM(i,j,r);
    267   Coefficient  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)  TFD_HAT(i,j,r)
    268    # shock to remove all tax on domestic i purchased by firm j in r #;
    269   Formula  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    270        TFD_HAT(i,j,r) = 100*[1-TFD_L(i,j,r)] / TFD_L(i,j,r);
    271    
    272   Coefficient  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)  TFI_L(i,j,r)
    273    # benchmark power: tax on imported i purchased by firm j in r [tfm] #;
    274   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    275        TFI_L(i,j,r) = VIFA(i,j,r)/VIFM(i,j,r);
    276   Coefficient  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)  TFI_HAT(i,j,r)
    277    # shock to remove all tax on imported i purchased by firm j in r [tfm] #;
    278   Formula  (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    279        TFI_HAT(i,j,r) = 100*[1-TFI_L(i,j,r)] / TFI_L(i,j,r);
    280    
    281   Coefficient  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)  TXS_L(i,r,s)
    282    # benchmark rate: subsidy on exports of i from r to s #;
    283   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    284        TXS_L(i,r,s) = VXMD(i,r,s)/VXWD(i,r,s);
    285   Coefficient  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)  TXS_HAT(i,r,s)
    286    # shock to remove subsidy on exports of i from r to s  #;
    287   Formula  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    288        TXS_HAT(i,r,s) = 100*[1-TXS_L(i,r,s)] / TXS_L(i,r,s);
    289    
    290   Coefficient  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)  TMS_L(i,r,s)
    291    # benchmark power: tax on imports of i from r into s #;
    292   Formula (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    293        TMS_L(i,r,s) = VIMS(i,r,s)/VIWS(i,r,s);
    294   Coefficient  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)  TMS_HAT(i,r,s)
    295    # shock to remove tax on imports of i from r into s #;
    296   Formula  (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    297        TMS_HAT(i,r,s) = 100*[1-TMS_L(i,r,s)] / TMS_L(i,r,s);
    298    
    299   File (new,text) TOHAT  # The file with shocks to obtain TO = 1  #;
    300   File (new,text) TFHAT  # The file with shocks to obtain TF = 1  #;
    301   File (new,text) TPIHAT # The file with shocks to obtain TPI = 1 #;
    302   File (new,text) TPDHAT # The file with shocks to obtain TPD = 1 #;
    303   File (new,text) TGIHAT # The file with shocks to obtain TGI = 1 #;
    304   File (new,text) TGDHAT # The file with shocks to obtain TGD = 1 #;
    305   File (new,text) TFIHAT # The file with shocks to obtain TFI = 1 #;
    306   File (new,text) TFDHAT # The file with shocks to obtain TFD = 1 #;
    307   File (new,text) TXSHAT # The file with shocks to obtain TXS = 1 #;
    308   File (new,text) TMSHAT # The file with shocks to obtain TMS = 1 #;
    309   ! nb, RunGTAP requires the logical file names above !
    310    
    311   Write TO_HAT to file TOHAT;
    312   Write TF_HAT to file TFHAT;
    313   Write TPD_HAT to file TPDHAT;
    314   Write TPI_HAT to file TPIHAT;
    315   Write TGD_HAT to file TGDHAT;
    316   Write TGI_HAT to file TGIHAT;
    317   Write TFD_HAT to file TFDHAT;
    318   Write TFI_HAT to file TFIHAT;
    319   Write TXS_HAT to file TXSHAT;
    320   Write TMS_HAT to file TMSHAT;
    321    
    322   ! Example to write shocks to a HAR file
    323   File (new) HARSHK # file with various shocks #;
    324   Write TO_HAT  to file HARSHK header "TO" longname "shocks to make TO = 1";
    325   Write TMS_HAT to file HARSHK header "TMS" longname "shocks to make TMS = 1";
    326   ... and so on
    327   !
    328    
    329   !_____________________________________________________________________________!
    330   !                                                                             !
    331   !_______________________End of TABLO File SHOCKS.TAB__________________________!




